<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="CategoryChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          x:Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="XAxisStroke"
                  x:Name="XAxisStroke"
                  Label="X Axis Stroke"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="gray">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="XAxisMajorStroke"
                  x:Name="XAxisMajorStroke"
                  Label="X Axis Major Stroke"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames2}"
                  DropDownValues="{Binding dropDownValues2}"
                  PrimitiveValue="darkslategray">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="YAxisStroke"
                  x:Name="YAxisStroke"
                  Label="Y Axis Stroke"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames3}"
                  DropDownValues="{Binding dropDownValues3}"
                  PrimitiveValue="gray">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="YAxisMajorStroke"
                  x:Name="YAxisMajorStroke"
                  Label="Y Axis Major Stroke"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames4}"
                  DropDownValues="{Binding dropDownValues4}"
                  PrimitiveValue="darkslategray">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="YAxisMinorStroke"
                  x:Name="YAxisMinorStroke"
                  Label="Y Axis Minor Stroke"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames5}"
                  DropDownValues="{Binding dropDownValues5}"
                  PrimitiveValue="gray">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
        <Grid>
          <igCharts:Legend
          x:Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamCategoryChart
          x:Name="chart"
          ComputedPlotAreaMarginMode="Series"
          ItemsSource="{Binding CountryRenewableElectricity}"
          IncludedProperties="{Binding includedProperties1}"
          ChartType="Line"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false"
          XAxisStroke="#919191"
          XAxisStrokeThickness="2"
          XAxisInterval="1"
          XAxisMajorStroke="#474747"
          XAxisMajorStrokeThickness="0.5"
          YAxisStroke="gray"
          YAxisStrokeThickness="2"
          YAxisInterval="20"
          YAxisMajorStroke="darkslategray"
          YAxisMajorStrokeThickness="1"
          YAxisMinorInterval="5"
          YAxisMinorStroke="gray"
          YAxisMinorStrokeThickness="0.5"
          Thickness="2">
          </igCharts:XamCategoryChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
