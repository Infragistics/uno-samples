<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="CategoryChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          x:Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="TransitionInMode"
                  x:Name="TransitionInMode"
                  Label="Transition Type"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="Auto"
                  Changed="EditorChangeReplayTransitionInDomain">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="TransitionInDuration"
                  x:Name="TransitionInDuration"
                  Label="Transition Duration"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Slider"
                  PrimitiveValue="1000"
                  Min="50"
                  Max="2000"
                  Step="50"
                  Changed="EditorChangeReplayTransitionInDomain">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ReplayTransitionIn"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Reload Chart"
                  ButtonClicked="EditorButtonReplayTransitionInDomain"
                  x:Name="propertyEditorPropertyDescription1">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamCategoryChart
          x:Name="chart"
          ItemsSource="{Binding EnergyRenewableGeneration}"
          IncludedProperties="{Binding includedProperties1}"
          ChartType="Line"
          IsTransitionInEnabled="true"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false"
          YAxisTitle="TWh"
          YAxisTitleLeftMargin="10"
          YAxisTitleRightMargin="5"
          YAxisLabelLeftMargin="0"
          ComputedPlotAreaMarginMode="Series">
          </igCharts:XamCategoryChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
