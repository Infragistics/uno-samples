<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                            xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:XamDataLegend
          Name="legend"
          Target="{Binding ElementName=chart}"
          ValueFormatString="{}{0} Billion"
          ValueFormatSpecifiers="{Binding numberFormatSpecifier1}">
          </igCharts:XamDataLegend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamCategoryChart
          Name="chart"
          ItemsSource="{Binding HighestGrossingMovies}"
          ChartType="Column"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false"
          FinalValueAnnotationsPrecision="2"
          DataToolTipValueFormatString="{}{0} Billion"
          DataToolTipValueFormatSpecifiers="{Binding numberFormatSpecifier3}"
          YAxisLabelFormat="{}{0}B"
          YAxisLabelFormatSpecifiers="{Binding numberFormatSpecifier5}">
          </igCharts:XamCategoryChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
