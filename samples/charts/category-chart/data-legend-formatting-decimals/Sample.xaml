<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:XamDataLegend
          Name="legend"
          Target="{Binding ElementName=chart}"
          ValueFormatMode="Decimal"
          ValueFormatMinFractions="1"
          UnitsText="B">
          </igCharts:XamDataLegend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamCategoryChart
          Name="chart"
          ChartType="Column"
          ItemsSource="{Binding HighestGrossingMovies}"
          XAxisInterval="1"
          YAxisTitle="Billions of U.S. Dollars"
          YAxisTitleLeftMargin="10"
          YAxisTitleRightMargin="5"
          YAxisLabelLeftMargin="0"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false"
          ToolTipType="None"
          CrosshairsDisplayMode="None"
          IsCategoryHighlightingEnabled="true">
          </igCharts:XamCategoryChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
