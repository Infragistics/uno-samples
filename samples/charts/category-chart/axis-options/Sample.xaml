<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamCategoryChart
          Name="chart"
          ItemsSource="{Binding OlympicMedalsTopCountries}"
          ChartType="Line"
          Thickness="3"
          ComputedPlotAreaMarginMode="Series"
          XAxisLabelFontFamily="Verdana"
          XAxisLabelFontSize="9"
          XAxisLabelTopMargin="5"
          XAxisLabelTextColor="gray"
          YAxisLabelLocation="OutsideRight"
          YAxisLabelFontFamily="Verdana"
          YAxisLabelFontSize="9"
          YAxisLabelRightMargin="0"
          YAxisLabelTextColor="gray"
          XAxisTitle="Olympic Games"
          XAxisTitleTextColor="gray"
          XAxisTitleFontFamily="Verdana"
          XAxisTitleFontSize="10"
          XAxisTitleAngle="0"
          YAxisTitle="Total Medals"
          YAxisTitleFontFamily="Verdana"
          YAxisTitleFontSize="10"
          YAxisTitleTextColor="gray"
          YAxisTitleAngle="90"
          YAxisTitleLeftMargin="5"
          XAxisTickLength="10"
          XAxisTickStrokeThickness="0.5"
          XAxisTickStroke="black"
          YAxisTickLength="10"
          YAxisTickStrokeThickness="0.5"
          YAxisTickStroke="black"
          YAxisMinimumValue="50"
          YAxisMaximumValue="150"
          XAxisInterval="1"
          XAxisMajorStroke="gray"
          XAxisMajorStrokeThickness="0.5"
          YAxisInterval="25"
          YAxisMajorStroke="black"
          YAxisMajorStrokeThickness="1"
          YAxisMinorInterval="5"
          YAxisMinorStroke="gray"
          YAxisMinorStrokeThickness="0.5"
          XAxisGap="0.125"
          XAxisOverlap="0">
          </igCharts:XamCategoryChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
