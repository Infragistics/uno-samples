<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:Legend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryYAxis
                  Name="yAxis"
                  ItemsSource="{Binding EnergyRenewableConsumption}"
                  Label="Location"
                  IsInverted="true"
                  Gap="0.75">
                  </igCharts:CategoryYAxis>
                  <igCharts:NumericXAxis
                  Name="xAxis"
                  MinimumValue="0"
                  Title="TWh">
                  </igCharts:NumericXAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:StackedBarSeries
                  Name="stackedBarSeries"
                  ItemsSource="{Binding EnergyRenewableConsumption}"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ShowDefaultTooltip="true"
                  AreaFillOpacity="1">
                      <igCharts:StackedBarSeries.Series>
                          <igCharts:StackedFragmentSeries
                          Name="s1"
                          ValueMemberPath="Hydro"
                          Title="Hydro">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          Name="s2"
                          ValueMemberPath="Wind"
                          Title="Wind">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          Name="s3"
                          ValueMemberPath="Solar"
                          Title="Solar">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          Name="s4"
                          ValueMemberPath="Other"
                          Title="Other">
                          </igCharts:StackedFragmentSeries>
                      </igCharts:StackedBarSeries.Series>
                  </igCharts:StackedBarSeries>
                  <igCharts:DataToolTipLayer
                  Name="dataToolTipLayer">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
