<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="Chart"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryAngleAxis
                  x:Name="angleAxis"
                  ItemsSource="{Binding SankeyBudgetStages}"
                  Label="Stage">
                  </igCharts:CategoryAngleAxis>
                  <igCharts:NumericRadiusAxis
                  x:Name="radiusAxis">
                  </igCharts:NumericRadiusAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:RadialSankeySeries
                  x:Name="radialSankey"
                  AngleAxis="{Binding ElementName=angleAxis}"
                  RadiusAxis="{Binding ElementName=radiusAxis}"
                  ItemsSource="{Binding SankeyBudgetNodes}"
                  NodeIdMemberPath="Id"
                  NodeLabelMemberPath="Label"
                  NodeLayerMemberPath="Layer"
                  LinkSource="{Binding SankeyBudgetLinks}"
                  LinkSourceMemberPath="Source"
                  LinkTargetMemberPath="Target"
                  LinkValueMemberPath="Value"
                  IsTransitionInEnabled="true">
                  </igCharts:RadialSankeySeries>
                  <igCharts:DataToolTipLayer
                  x:Name="Tooltips">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
