<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                            xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                <Grid>
          <igLayouts:XamPropertyEditorPanel
          Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="DataChart"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="HighlightedValuesDisplayMode"
                  Name="HighlightedValuesDisplayModeEditor"
                  Label="Highlight Display Mode: "
                  PrimitiveValue="Hidden">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          ShouldAutoExpandMarginForInitialLabels="true"
          ComputedPlotAreaMarginMode="Series"
          HighlightedValuesDisplayMode="Hidden"
          Name="chart">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  Name="xAxis"
                  ItemsSource="{Binding OlympicMedalsTopCountriesWithTotals}"
                  Label="Year">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  MinimumValue="0"
                  MaximumValue="400">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ColumnSeries
                  Name="ColumnSeries1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding OlympicMedalsTopCountriesWithTotals}"
                  ValueMemberPath="Total"
                  HighlightedValueMemberPath="America">
                  </igCharts:ColumnSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
