<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:Legend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false"
          MarkerBrushes="white"
          MarkerOutlines="#8ce7d9 #ee5879"
          Brushes="#8ce7d9 #ee5879"
          Outlines="#8ce7d9 #ee5879">
              <igCharts:XamDataChart.Axes>
                  <igCharts:NumericAngleAxis
                  Name="angleAxis"
                  StartAngleOffset="-90"
                  Interval="30"
                  MinimumValue="0"
                  MaximumValue="360"
                  LabelTextSTyle="Bold">
                  </igCharts:NumericAngleAxis>
                  <igCharts:NumericRadiusAxis
                  Name="radiusAxis"
                  RadiusExtentScale="0.9"
                  InnerRadiusExtentScale="0.1"
                  Interval="25"
                  MinimumValue="0"
                  MaximumValue="100">
                  </igCharts:NumericRadiusAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:PolarAreaSeries
                  Name="PolarAreaSeries1"
                  ItemsSource="{Binding BoatSailingData}"
                  AngleAxis="{Binding ElementName=angleAxis}"
                  RadiusAxis="{Binding ElementName=radiusAxis}"
                  AngleMemberPath="Direction"
                  RadiusMemberPath="WindSpeed"
                  ShowDefaultTooltip="true"
                  AreaFillOpacity="0.3"
                  Thickness="1"
                  Title="Wind Speed"
                  MarkerType="Circle">
                  </igCharts:PolarAreaSeries>
                  <igCharts:PolarAreaSeries
                  Name="PolarAreaSeries2"
                  ItemsSource="{Binding BoatSailingData}"
                  AngleAxis="{Binding ElementName=angleAxis}"
                  RadiusAxis="{Binding ElementName=radiusAxis}"
                  AngleMemberPath="Direction"
                  RadiusMemberPath="BoatSpeed"
                  ShowDefaultTooltip="true"
                  AreaFillOpacity="0.3"
                  Thickness="1"
                  Title="Boat Speed"
                  MarkerType="Circle">
                  </igCharts:PolarAreaSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
