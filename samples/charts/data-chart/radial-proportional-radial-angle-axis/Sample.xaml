<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igCharts:Legend
          x:Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:ProportionalCategoryAngleAxis
                  x:Name="angleAxis"
                  ItemsSource="{Binding EnergyRenewableConsumption}"
                  Label="Location"
                  ValueMemberPath="Hydro"
                  Gap="0">
                  </igCharts:ProportionalCategoryAngleAxis>
                  <igCharts:NumericRadiusAxis
                  x:Name="radiusAxis"
                  MinimumValue="0"
                  MaximumValue="100">
                  </igCharts:NumericRadiusAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:RadialPieSeries
                  x:Name="RadialPieSeries1"
                  ItemsSource="{Binding EnergyRenewableConsumption}"
                  AngleAxis="{Binding ElementName=angleAxis}"
                  ValueAxis="{Binding ElementName=radiusAxis}"
                  ValueMemberPath="Hydro"
                  ShowDefaultTooltip="false"
                  UseItemWiseColors="true"
                  Title="Hydro Consumption">
                  </igCharts:RadialPieSeries>
                  <igCharts:DataToolTipLayer
                  x:Name="dataToolTipLayer">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
