<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxisShared"
                  ItemsSource="{Binding StockTesla}"
                  Label="Date">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxisRight"
                  LabelLocation="OutsideRight"
                  Title="Stock Price ($)">
                  </igCharts:NumericYAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxisLeft"
                  LabelLocation="OutsideLeft"
                  Title="Trade Volume"
                  MajorStrokeThickness="0"
                  AbbreviateLargeNumbers="true">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ColumnSeries
                  x:Name="volumeSeries"
                  XAxis="{Binding ElementName=xAxisShared}"
                  YAxis="{Binding ElementName=yAxisLeft}"
                  ItemsSource="{Binding StockTesla}"
                  ValueMemberPath="Volume">
                  </igCharts:ColumnSeries>
                  <igCharts:FinancialPriceSeries
                  x:Name="stockSeries"
                  XAxis="{Binding ElementName=xAxisShared}"
                  YAxis="{Binding ElementName=yAxisRight}"
                  ItemsSource="{Binding StockTesla}"
                  DisplayType="Candlestick"
                  HighMemberPath="High"
                  LowMemberPath="Low"
                  CloseMemberPath="Close"
                  OpenMemberPath="Open">
                  </igCharts:FinancialPriceSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
