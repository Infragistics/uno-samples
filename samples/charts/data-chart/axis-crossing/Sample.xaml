<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="DataChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          x:Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="Axes[0 as NumericXAxis].CrossingValue"
                  x:Name="XAxisCrossingValue"
                  Label="Where the X axis crosses"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Slider"
                  PrimitiveValue="0"
                  Min="-1.25"
                  Max="1.25"
                  Step="0.125">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="Axes[1 as NumericYAxis].CrossingValue"
                  x:Name="YAxisCrossingValue"
                  Label="Where the Y axis crosses"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Slider"
                  PrimitiveValue="0"
                  Min="-360"
                  Max="360"
                  Step="10">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true"
          PlotAreaMarginBottom="60"
          PlotAreaMarginTop="60"
          PlotAreaMarginLeft="30"
          PlotAreaMarginRight="30">
              <igCharts:XamDataChart.Axes>
                  <igCharts:NumericXAxis
                  x:Name="xAxis"
                  Interval="40"
                  MinimumValue="-360"
                  MaximumValue="360"
                  LabelLocation="InsideBottom"
                  LabelTopMargin="10"
                  CrossingAxis="{Binding ElementName=yAxis}"
                  CrossingValue="0"
                  StrokeThickness="1"
                  Stroke="black">
                  </igCharts:NumericXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis"
                  MinimumValue="-1.25"
                  MaximumValue="1.25"
                  Interval="0.25"
                  LabelLocation="InsideLeft"
                  LabelRightMargin="10"
                  CrossingAxis="{Binding ElementName=xAxis}"
                  CrossingValue="0"
                  StrokeThickness="1"
                  Stroke="black">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ScatterSplineSeries
                  x:Name="sinSeries"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding ScatterWaveData}"
                  MarkerType="Circle"
                  XMemberPath="X"
                  YMemberPath="SinValue">
                  </igCharts:ScatterSplineSeries>
                  <igCharts:ScatterSplineSeries
                  x:Name="cosSeries"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding ScatterWaveData}"
                  MarkerType="Circle"
                  XMemberPath="X"
                  YMemberPath="CosValue">
                  </igCharts:ScatterSplineSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
