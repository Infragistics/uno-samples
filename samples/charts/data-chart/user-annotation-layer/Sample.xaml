<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="DataChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          x:Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="AnnotationLabel"
                  x:Name="AnnotationLabel"
                  Label="Label"
                  ValueType="StringValue"
                  PrimitiveValue="Enter Label">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="AnnotationDetails"
                  x:Name="AnnotationDetails"
                  Label="Details"
                  ValueType="StringValue"
                  PrimitiveValue="Enter Details">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="AnnotationBadgeColor"
                  x:Name="AnnotationBadgeColor"
                  Label="Badge Color"
                  ValueType="StringValue"
                  PrimitiveValue="black">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="AnnotationMainColor"
                  x:Name="AnnotationMainColor"
                  Label="Main Color"
                  ValueType="StringValue"
                  PrimitiveValue="black">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="FinishAnnotation"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Done"
                  ButtonClicked="EditorButtonFinishUserAnnotation"
                  x:Name="propertyEditorPropertyDescription1">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="CancelAnnotation"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Cancel"
                  ButtonClicked="EditorButtonCancelUserAnnotation"
                  x:Name="propertyEditorPropertyDescription2">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
        <Grid>
          <igLayouts:XamToolbar
          x:Name="toolbar"
          Target="{Binding ElementName=chart}"
          Orientation="Horizontal">
          </igLayouts:XamToolbar>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true"
          ComputedPlotAreaMarginMode="Series"
          IsUserAnnotationsEnabled="true"
          UserAnnotationInformationRequested="DataChartUserAnnotationRequested"
          UserAnnotationToolTipContentUpdating="DataChartUserAnnotationTooltip">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  Label="Year">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis"
                  Title="TWh">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:LineSeries
                  x:Name="lineSeries1"
                  Title="America"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="America">
                  </igCharts:LineSeries>
                  <igCharts:LineSeries
                  x:Name="lineSeries2"
                  Title="Europe"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="Europe">
                  </igCharts:LineSeries>
                  <igCharts:LineSeries
                  x:Name="lineSeries3"
                  Title="China"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="China">
                  </igCharts:LineSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
