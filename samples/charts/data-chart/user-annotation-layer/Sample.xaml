<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igInputs="using:Infragistics.Controls.Inputs"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <igLayouts:XamToolbar
      x:Name="toolbar"
      Target="{Binding ElementName=chart}"
      Orientation="Horizontal">
      </igLayouts:XamToolbar>
      <Grid Grid.Row="1" x:Name="ContentRoot">
        <igCharts:XamDataChart
        x:Name="chart"
        IsHorizontalZoomEnabled="true"
        IsVerticalZoomEnabled="true"
        ComputedPlotAreaMarginMode="Series"
        IsUserAnnotationsEnabled="true"
        UserAnnotationInformationRequested="DataChartUserAnnotationRequested"
        UserAnnotationToolTipContentUpdating="DataChartUserAnnotationTooltip">
            <igCharts:XamDataChart.Axes>
                <igCharts:CategoryXAxis
                x:Name="xAxis"
                ItemsSource="{Binding CountryRenewableElectricity}"
                Label="Year">
                </igCharts:CategoryXAxis>
                <igCharts:NumericYAxis
                x:Name="yAxis"
                Title="TWh">
                </igCharts:NumericYAxis>
            </igCharts:XamDataChart.Axes>
            <igCharts:XamDataChart.Series>
                <igCharts:LineSeries
                x:Name="lineSeries1"
                Title="America"
                XAxis="{Binding ElementName=xAxis}"
                YAxis="{Binding ElementName=yAxis}"
                ItemsSource="{Binding CountryRenewableElectricity}"
                ValueMemberPath="America">
                </igCharts:LineSeries>
                <igCharts:LineSeries
                x:Name="lineSeries2"
                Title="Europe"
                XAxis="{Binding ElementName=xAxis}"
                YAxis="{Binding ElementName=yAxis}"
                ItemsSource="{Binding CountryRenewableElectricity}"
                   
                ValueMemberPath="Europe">
                </igCharts:LineSeries>
                <igCharts:LineSeries
                x:Name="lineSeries3"
                Title="China"
                XAxis="{Binding ElementName=xAxis}"
                YAxis="{Binding ElementName=yAxis}"
                ItemsSource="{Binding CountryRenewableElectricity}"
                ValueMemberPath="China">
                </igCharts:LineSeries>
            </igCharts:XamDataChart.Series>
        </igCharts:XamDataChart>

        <!-- The annotation dialog. Hidden until the chart asks for an annotation's details, then shown
             centred over the chart until Done or Cancel answers the request. -->
        <Border
        x:Name="annotationPopup"
        Visibility="Collapsed"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Width="240"
        Padding="12"
        Background="White"
        BorderBrush="Black"
        BorderThickness="1"
        CornerRadius="4">
            <StackPanel Spacing="4">
                <TextBlock Text="Label:" Foreground="Black" />
                <TextBox x:Name="annotationInput" Text="Enter Label" />

                <TextBlock Text="Details:" Foreground="Black" Margin="0,4,0,0" />
                <TextBox
                x:Name="annotationDetails"
                Text="Enter Details"
                Height="64"
                AcceptsReturn="True"
                TextWrapping="Wrap" />

                <TextBlock Text="Badge Color:" Foreground="Black" Margin="0,4,0,0" />
                <igInputs:XamColorEditor x:Name="annotationBadgeColorEditor" Height="40" />

                <TextBlock Text="Main Color:" Foreground="Black" Margin="0,4,0,0" />
                <igInputs:XamColorEditor x:Name="annotationMainColorEditor" Height="40" />

                <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="16"
                Margin="0,12,0,0">
                    <Button x:Name="doneButton" Content="Done" Click="OnDoneButtonClick" />
                    <Button x:Name="cancelButton" Content="Cancel" Click="OnCancelButtonClick" />
                </StackPanel>
            </StackPanel>
        </Border>
      </Grid>
    </Grid>
</UserControl>
