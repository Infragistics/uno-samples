<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true"
          PlotAreaMarginRight="180"
          HighlightingMode="FadeOthersSpecific"
          HighlightingBehavior="DirectlyOver">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis"
                  ItemsSource="{Binding SankeyHouseholdStages}"
                  Label="Stage"
                  AreLabelsVisible="false"
                  TickLength="0"
                  Stroke="#00000000"
                  MajorStroke="#00000000">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis"
                  AreLabelsVisible="false"
                  TickLength="0"
                  Stroke="#00000000"
                  MajorStroke="#00000000">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:SankeySeries
                  x:Name="sankey"
                  Title="Monthly Budget"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding SankeyHouseholdNodes}"
                  NodeIdMemberPath="Id"
                  NodeLabelMemberPath="Label"
                  NodeLayerMemberPath="Layer"
                  LinkSource="{Binding SankeyHouseholdLinks}"
                  LinkSourceMemberPath="Source"
                  LinkTargetMemberPath="Target"
                  LinkValueMemberPath="Value"
                  UseItemWiseColors="true"
                  Thickness="0"
                  AreaFillOpacity="0.7"
                  IsTransitionInEnabled="true">
                  </igCharts:SankeySeries>
                  <igCharts:CalloutLayer
                  x:Name="nodeLabels"
                  TargetSeries="{Binding ElementName=sankey}"
                  IsAutoCalloutBehaviorEnabled="true"
                  UseValueForAutoCalloutLabels="false"
                  UseItemColorForOutline="true"
                  CalloutStrokeThickness="2"
                  CalloutTextColor="black"
                  CalloutBackground="white">
                  </igCharts:CalloutLayer>
                  <igCharts:DataToolTipLayer
                  x:Name="tooltips">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
