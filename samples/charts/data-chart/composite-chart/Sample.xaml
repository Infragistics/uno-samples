<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igCharts:Legend
          x:Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis"
                  ItemsSource="{Binding CompanyIncomeStatement}"
                  Label="Date"
                  Overlap="0"
                  Gap="0.1"
                  UseClusteringMode="true">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis"
                  AbbreviateLargeNumbers="true"
                  Title="In Millions of U.S. Dollars"
                  MinimumValue="0"
                  MaximumValue="30000000"
                  TitleLeftMargin="5"
                  TitleRightMargin="0">
                  </igCharts:NumericYAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis2"
                  AbbreviateLargeNumbers="true"
                  Title="Percentage"
                  MajorStrokeThickness="0"
                  MinimumValue="0"
                  MaximumValue="160"
                  LabelLocation="OutsideRight"
                  LabelHorizontalAlignment="Left">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ColumnSeries
                  x:Name="series1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CompanyIncomeStatement}"
                  ValueMemberPath="Revenue"
                  Title="Revenue"
                  MarkerType="Hidden">
                  </igCharts:ColumnSeries>
                  <igCharts:ColumnSeries
                  x:Name="series2"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CompanyIncomeStatement}"
                  ValueMemberPath="Expenses"
                  Title="Expenses"
                  MarkerType="Hidden">
                  </igCharts:ColumnSeries>
                  <igCharts:SplineAreaSeries
                  x:Name="series3"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis2}"
                  ItemsSource="{Binding CompanyIncomeStatement}"
                  ValueMemberPath="IncomePerRevenue"
                  Title="Income / Revenue %"
                  MarkerType="Circle">
                  </igCharts:SplineAreaSeries>
                  <igCharts:CalloutLayer
                  x:Name="revenueCallouts"
                  ItemsSource="{Binding CompanyIncomeStatement}"
                  IsAutoCalloutBehaviorEnabled="false"
                  TargetSeries="{Binding ElementName=series1}"
                  XMemberPath="RevenueX"
                  YMemberPath="Revenue"
                  LabelMemberPath="FormattedRevenue"
                  UseValueForAutoCalloutLabels="false"
                  CalloutLeaderBrush="#00000000"
                  CalloutTextColor="black"
                  CalloutBackground="#00000000"
                  CalloutPositionPadding="-5">
                  </igCharts:CalloutLayer>
                  <igCharts:CalloutLayer
                  x:Name="expensesCallouts"
                  ItemsSource="{Binding CompanyIncomeStatement}"
                  IsAutoCalloutBehaviorEnabled="false"
                  TargetSeries="{Binding ElementName=series2}"
                  XMemberPath="ExpensesX"
                  YMemberPath="Expenses"
                  LabelMemberPath="FormattedExpenses"
                  UseValueForAutoCalloutLabels="false"
                  CalloutLeaderBrush="#00000000"
                  CalloutTextColor="black"
                  CalloutBackground="#00000000"
                  CalloutPositionPadding="-5">
                  </igCharts:CalloutLayer>
                  <igCharts:CalloutLayer
                  x:Name="profitCallouts"
                  IsAutoCalloutBehaviorEnabled="true"
                  TargetSeries="{Binding ElementName=series3}"
                  UseValueForAutoCalloutLabels="true"
                  CalloutLeaderBrush="#00000000"
                  CalloutTextColor="black"
                  CalloutBackground="lightgray"
                  AutoCalloutLabelPrecision="1">
                  </igCharts:CalloutLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
