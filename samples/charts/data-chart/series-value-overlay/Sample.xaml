<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis"
                  ItemsSource="{Binding LocalData}"
                  Label="Label">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis"
                  MinimumValue="0"
                  MaximumValue="10">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ColumnSeries
                  x:Name="series1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding LocalData}"
                  ValueMemberPath="Value">
                  </igCharts:ColumnSeries>
                  <igCharts:ValueOverlay
                  x:Name="overlay1"
                  Axis="{Binding ElementName=yAxis}"
                  Value="2"
                  Thickness="5">
                  </igCharts:ValueOverlay>
                  <igCharts:ValueOverlay
                  x:Name="overlay2"
                  Axis="{Binding ElementName=yAxis}"
                  Value="3.6"
                  Thickness="5">
                  </igCharts:ValueOverlay>
                  <igCharts:ValueOverlay
                  x:Name="overlay3"
                  Axis="{Binding ElementName=yAxis}"
                  Value="5.8"
                  Thickness="5">
                  </igCharts:ValueOverlay>
                  <igCharts:ValueOverlay
                  x:Name="overlay4"
                  Axis="{Binding ElementName=yAxis}"
                  Value="1"
                  Thickness="5">
                  </igCharts:ValueOverlay>
                  <igCharts:ValueOverlay
                  x:Name="overlay5"
                  Axis="{Binding ElementName=yAxis}"
                  Value="8"
                  Thickness="5">
                  </igCharts:ValueOverlay>
                  <igCharts:ValueOverlay
                  x:Name="overlay6"
                  Axis="{Binding ElementName=yAxis}"
                  Value="7"
                  Thickness="5">
                  </igCharts:ValueOverlay>
                  <igCharts:ValueOverlay
                  x:Name="overlay7"
                  Axis="{Binding ElementName=yAxis}"
                  Value="5"
                  Thickness="5">
                  </igCharts:ValueOverlay>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
