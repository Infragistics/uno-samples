<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          x:Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="DataChart"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="HighlightedValuesDisplayMode"
                  x:Name="HighlightedValuesDisplayModeEditor"
                  Label="Highlight Display Mode: "
                  PrimitiveValue="Hidden">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          ShouldAutoExpandMarginForInitialLabels="true"
          ComputedPlotAreaMarginMode="Series"
          x:Name="chart"
          HighlightedValuesDisplayMode="Hidden">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  Label="Year">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ColumnSeries
                  x:Name="ColumnSeries1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="Europe"
                  HighlightedItemsSource="{Binding CountryRenewableElectricityFiltered}">
                  </igCharts:ColumnSeries>
                  <igCharts:ColumnSeries
                  x:Name="ColumnSeries2"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="China"
                  HighlightedItemsSource="{Binding CountryRenewableElectricityFiltered}">
                  </igCharts:ColumnSeries>
                  <igCharts:ColumnSeries
                  x:Name="ColumnSeries3"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="America"
                  HighlightedItemsSource="{Binding CountryRenewableElectricityFiltered}">
                  </igCharts:ColumnSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
