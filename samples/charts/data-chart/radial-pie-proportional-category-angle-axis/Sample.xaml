<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:ProportionalCategoryAngleAxis
                  Name="angleAxis"
                  ItemsSource="{Binding RadialProportionalData}"
                  Label="Label"
                  ValueMemberPath="Value"
                  Gap="0"
                  OthersCategoryText="Others"
                  OthersCategoryThreshold="55"
                  OthersCategoryType="Number">
                  </igCharts:ProportionalCategoryAngleAxis>
                  <igCharts:NumericRadiusAxis
                  Name="radiusAxis"
                  MinimumValue="0"
                  MaximumValue="100">
                  </igCharts:NumericRadiusAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:RadialPieSeries
                  Name="RadialPieSeries1"
                  ItemsSource="{Binding RadialProportionalData}"
                  AngleAxis="{Binding ElementName=angleAxis}"
                  ValueAxis="{Binding ElementName=radiusAxis}"
                  ValueMemberPath="Value"
                  ShowDefaultTooltip="false"
                  UseItemWiseColors="true"
                  LegendRadialLabelMode="LabelAndValueAndPercentage"
                  MarkerType="None"
                  Title="Categories">
                  </igCharts:RadialPieSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
