<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false"
          HighlightingMode="FadeOthersSpecific"
          HighlightingBehavior="DirectlyOver">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis"
                  ItemsSource="{Binding SankeyIncomeStages}"
                  Label="Stage"
                  AreLabelsVisible="false"
                  TickLength="0"
                  Stroke="#00000000"
                  MajorStroke="#00000000">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis"
                  AreLabelsVisible="false"
                  TickLength="0"
                  Stroke="#00000000"
                  MajorStroke="#00000000">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:SankeySeries
                  x:Name="sankey"
                  Title="Budget Flow"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  LinkSource="{Binding SankeyIncomeFlow}"
                  LinkSourceMemberPath="Source"
                  LinkTargetMemberPath="Target"
                  LinkValueMemberPath="Value"
                  NodeGap="250"
                  Thickness="0"
                  AreaFillOpacity="0.7"
                  RadiusX="4"
                  RadiusY="4"
                  RibbonShape="UniformWidth"
                  HighlightScope="ConnectedFlow"
                  IsTransitionInEnabled="true"
                  UseItemWiseColors="true">
                      <igCharts:SankeySeries.StyleMappings>
                          <igCharts:FlowStyleMapping
                          NodeLabel="Savings"
                          Fill="#2e7d32"
                          Outline="#2e7d32">
                          </igCharts:FlowStyleMapping>
                          <igCharts:FlowStyleMapping
                          NodeLabel="Housing"
                          Fill="#1565c0"
                          Outline="#1565c0">
                          </igCharts:FlowStyleMapping>
                          <igCharts:FlowStyleMapping
                          NodeLabel="Discretionary"
                          Fill="#ef6c00"
                          Outline="#ef6c00">
                          </igCharts:FlowStyleMapping>
                          <igCharts:FlowStyleMapping
                          MinimumValue="9000"
                          MaximumValue="10000"
                          Fill="#6a1b9a"
                          Outline="#6a1b9a">
                          </igCharts:FlowStyleMapping>
                      </igCharts:SankeySeries.StyleMappings>
                  </igCharts:SankeySeries>
                  <igCharts:DataToolTipLayer
                  x:Name="tooltips">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
