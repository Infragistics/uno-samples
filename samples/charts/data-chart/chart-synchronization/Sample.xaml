<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <igCharts:XamDataChart
          x:Name="chart1"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true"
          SyncChannel="ChannelA"
          SynchronizeHorizontally="true"
          SynchronizeVertically="true"
          Subtitle="Google Stock Prices">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis1"
                  ItemsSource="{Binding StockGoogle}"
                  Label="Date">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis1">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:FinancialPriceSeries
                  x:Name="series1"
                  XAxis="{Binding ElementName=xAxis1}"
                  YAxis="{Binding ElementName=yAxis1}"
                  ItemsSource="{Binding StockGoogle}"
                  DisplayType="OHLC"
                  HighMemberPath="High"
                  LowMemberPath="Low"
                  CloseMemberPath="Close"
                  OpenMemberPath="Open"
                  VolumeMemberPath="Volume">
                  </igCharts:FinancialPriceSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
          <Grid Grid.Row="1">
            <igCharts:XamDataChart
            x:Name="chart2"
            IsHorizontalZoomEnabled="true"
            IsVerticalZoomEnabled="true"
            SyncChannel="ChannelA"
            SynchronizeHorizontally="true"
            SynchronizeVertically="true"
            Subtitle="Amazon Stock Prices"
            SubtitleTopMargin="10">
                <igCharts:XamDataChart.Axes>
                    <igCharts:CategoryXAxis
                    x:Name="xAxis2"
                    ItemsSource="{Binding StockAmazon}"
                    Label="Date">
                    </igCharts:CategoryXAxis>
                    <igCharts:NumericYAxis
                    x:Name="yAxis2">
                    </igCharts:NumericYAxis>
                </igCharts:XamDataChart.Axes>
                <igCharts:XamDataChart.Series>
                    <igCharts:FinancialPriceSeries
                    x:Name="series2"
                    XAxis="{Binding ElementName=xAxis2}"
                    YAxis="{Binding ElementName=yAxis2}"
                    ItemsSource="{Binding StockAmazon}"
                    DisplayType="OHLC"
                    HighMemberPath="High"
                    LowMemberPath="Low"
                    CloseMemberPath="Close"
                    OpenMemberPath="Open"
                    VolumeMemberPath="Volume">
                    </igCharts:FinancialPriceSeries>
                </igCharts:XamDataChart.Series>
            </igCharts:XamDataChart>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
