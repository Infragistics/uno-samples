<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart"
          PlotAreaMarginBottom="50"
          Title="This sample demonstrates the DataAnnotationSliceLayer with overlay text compared against the value layers in the DataChart.">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  Name="xAxis"
                  ItemsSource="{Binding StockTesla}"
                  Label="Date"
                  LabelLeftMargin="0"
                  LabelTopMargin="5"
                  LabelRightMargin="0"
                  LabelBottomMargin="15">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  LabelExtent="60"
                  LabelHorizontalAlignment="Center"
                  LabelLeftMargin="0"
                  LabelTopMargin="0"
                  LabelRightMargin="5"
                  LabelBottomMargin="0"
                  MinimumValue="0"
                  MaximumValue="550">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:LineSeries
                  Name="series1"
                  Title="Stock Price"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding StockTesla}"
                  ValueMemberPath="Open"
                  ShowDefaultTooltip="true"
                  MarkerType="None"
                  Brush="black">
                  </igCharts:LineSeries>
                  <igCharts:ValueOverlay
                  Name="valueOverlay"
                  Value="435"
                  Brush="green"
                  IsAxisAnnotationEnabled="true"
                  Thickness="2"
                  DashArray="2, 4"
                  Axis="{Binding ElementName=yAxis}"
                  OverlayText="OverlayText on ValueOverlay"
                  OverlayTextLocation="OutsideBottomCenter">
                  </igCharts:ValueOverlay>
                  <igCharts:ValueLayer
                  Name="valueLayer"
                  ValueMode="Average"
                  Brush="purple"
                  Thickness="2"
                  DashArray="2, 4"
                  TargetAxis="{Binding ElementName=yAxis}"
                  IsAxisAnnotationEnabled="true"
                  OverlayText="OverlayText on ValueLayer (Average)"
                  OverlayTextLocation="OutsideBottomCenter">
                  </igCharts:ValueLayer>
                  <igCharts:DataAnnotationSliceLayer
                  Name="AnnoLayer"
                  ItemsSource="{Binding AnnotationSliceMultiOverlayData}"
                  TargetAxis="{Binding ElementName=yAxis}"
                  Brush="green"
                  AnnotationTextColor="white"
                  AnnotationLabelMemberPath="Label"
                  AnnotationValueMemberPath="Value"
                  OverlayTextMemberPath="Label"
                  OverlayTextVerticalMargin="20"
                  OverlayTextHorizontalMargin="0"
                  OverlayTextLocation="OutsideBottomCenter"
                  OverlayText="OverlayText on DataAnnotationSliceLayer"
                  Thickness="2">
                  </igCharts:DataAnnotationSliceLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
