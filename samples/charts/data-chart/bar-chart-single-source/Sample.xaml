<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="Chart"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryYAxis
                  Name="yAxis"
                  Label="Shop"
                  UseEnhancedIntervalManagement="true"
                  EnhancedIntervalPreferMoreCategoryLabels="true"
                  ItemsSource="{Binding OnlineShoppingSearches}"
                  IsInverted="true"
                  Gap="0.5"
                  Overlap="-0.1">
                  </igCharts:CategoryYAxis>
                  <igCharts:NumericXAxis
                  Name="xAxis"
                  LabelFormat="{}{0}%">
                  </igCharts:NumericXAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:CategoryHighlightLayer
                  Name="CategoryHighlightLayer">
                  </igCharts:CategoryHighlightLayer>
                  <igCharts:BarSeries
                  Name="BarSeries1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ValueMemberPath="Percent"
                  ItemsSource="{Binding OnlineShoppingSearches}"
                  ShowDefaultTooltip="true"
                  IsTransitionInEnabled="true"
                  IsHighlightingEnabled="true">
                  </igCharts:BarSeries>
                  <igCharts:DataToolTipLayer
                  Name="Tooltips">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
