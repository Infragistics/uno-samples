<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:Legend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="Chart"
          Legend="{Binding ElementName=legend}">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryYAxis
                  Name="yAxis1"
                  Label="Category"
                  ItemsSource="{Binding RoadblocksToSuccess}"
                  Gap="0.25"
                  LabelExtent="0">
                  </igCharts:CategoryYAxis>
                  <igCharts:CategoryYAxis
                  Name="yAxis2"
                  Label="Category"
                  ItemsSource="{Binding RoadblocksToSuccess}"
                  Gap="1"
                  LabelHorizontalAlignment="Right">
                  </igCharts:CategoryYAxis>
                  <igCharts:NumericXAxis
                  Name="xAxis"
                  MinimumValue="0"
                  MaximumValue="50"
                  UseEnhancedIntervalManagement="true"
                  LabelFormat="{}{0}%"
                  StrokeThickness="2"
                  Stroke="gray"
                  TickLength="5">
                  </igCharts:NumericXAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:CategoryHighlightLayer
                  Name="CategoryHighlightLayer">
                  </igCharts:CategoryHighlightLayer>
                  <igCharts:BarSeries
                  Name="BarSeries1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis1}"
                  Title="Sum of Top 3 Choices"
                  ValueMemberPath="TopChoices"
                  ItemsSource="{Binding RoadblocksToSuccess}"
                  ShowDefaultTooltip="true"
                  IsTransitionInEnabled="true"
                  IsHighlightingEnabled="true"
                  MarkerType="Hidden">
                  </igCharts:BarSeries>
                  <igCharts:BarSeries
                  Name="BarSeries2"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis2}"
                  Title="Top Choice"
                  ValueMemberPath="FirstChoice"
                  ItemsSource="{Binding RoadblocksToSuccess}"
                  ShowDefaultTooltip="true"
                  IsTransitionInEnabled="true"
                  IsHighlightingEnabled="true"
                  MarkerType="Hidden">
                  </igCharts:BarSeries>
                  <igCharts:CalloutLayer
                  Name="CalloutLayer1"
                  IsAutoCalloutBehaviorEnabled="true"
                  AllowedPositions="{Binding allowedPositions1}"
                  CalloutLeaderBrush="#00000000"
                  CalloutOutline="#00000000"
                  CalloutBackground="#00000000"
                  CalloutTextColor="black"
                  CalloutStrokeThickness="2"
                  CalloutPaddingTop="0"
                  CalloutPositionPadding="0">
                  </igCharts:CalloutLayer>
                  <igCharts:CalloutLayer
                  Name="CalloutLayer2"
                  IsAutoCalloutBehaviorEnabled="true"
                  AllowedPositions="{Binding allowedPositions2}"
                  CalloutLeaderBrush="#00000000"
                  CalloutOutline="#00000000"
                  CalloutBackground="#00000000"
                  CalloutTextColor="black"
                  CalloutStrokeThickness="2"
                  CalloutPaddingTop="0"
                  CalloutPositionPadding="0">
                  </igCharts:CalloutLayer>
                  <igCharts:DataToolTipLayer
                  Name="Tooltips">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
