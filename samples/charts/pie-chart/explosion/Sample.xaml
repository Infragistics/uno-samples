<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igCharts:ItemLegend
          x:Name="legend"
          Orientation="Horizontal">
          </igCharts:ItemLegend>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamPieChart
          x:Name="chart"
          LabelMemberPath="Summary"
          ValueMemberPath="MarketShare"
          ExplodedRadius="0.2"
          ExplodedSlices="{Binding explodedSlices1}"
          AllowSliceExplosion="true"
          RadiusFactor="0.6"
          LabelsPosition="OutsideEnd"
          LabelExtent="30"
          LegendLabelMemberPath="Company"
          SliceClick="PieChartExplosionSliceClick"
          ItemsSource="{Binding LocalData}"
          Legend="{Binding ElementName=legend}">
          </igCharts:XamPieChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
