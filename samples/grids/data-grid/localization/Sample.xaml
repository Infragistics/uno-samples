<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          RowHeight="50"
          IsColumnOptionsEnabled="true"
          IsGroupCollapsable="true"
          ActivationMode="Cell"
          SummaryScope="Root"
          SelectionMode="SingleRow">
              <igDataGrids:XamDataGrid.GroupDescriptions>
                  <igDataGrids:ColumnGroupDescription
                  Field="Country"
                  DisplayName="国">
                  </igDataGrids:ColumnGroupDescription>
                  <igDataGrids:ColumnGroupDescription
                  Field="Income"
                  DisplayName="所得">
                  </igDataGrids:ColumnGroupDescription>
              </igDataGrids:XamDataGrid.GroupDescriptions>
              <igDataGrids:XamDataGrid.SummaryDescriptions>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Age"
                  Operand="Average">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Photo"
                  Operand="Count">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Salary"
                  Operand="Sum">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Sales"
                  Operand="Max">
                  </igDataGrids:ColumnSummaryDescription>
              </igDataGrids:XamDataGrid.SummaryDescriptions>
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:ImageColumn
                  Field="Photo"
                  HeaderText="写真"
                  Width="*>120"
                  IsEditable="false"
                  PaddingTop="5"
                  PaddingBottom="5"
                  PaddingRight="10"
                  HorizontalAlignment="Stretch">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TextColumn
                  Field="Name"
                  HeaderText="名前"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Sales"
                  HeaderText="売上高"
                  Width="*>130"
                  HorizontalAlignment="Center">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  HeaderText="給料"
                  Width="*>130"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true"
                  MaxFractionDigits="0"
                  MinFractionDigits="0">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Age"
                  HeaderText="年齢"
                  Width="100"
                  HorizontalAlignment="Center">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  HeaderText="生年月日"
                  Width="*>140">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:ImageColumn
                  Field="CountryFlag"
                  HeaderText="国旗"
                  Width="*>110"
                  IsEditable="false"
                  PaddingTop="5"
                  PaddingBottom="5"
                  PaddingRight="10"
                  HorizontalAlignment="Stretch">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TextColumn
                  Field="Address"
                  HeaderText="住所"
                  Width="*>170">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Phone"
                  HeaderText="電話"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Income"
                  HeaderText="所得"
                  Width="*>120">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
