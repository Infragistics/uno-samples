<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding FinancialDataService}"
          ActivationMode="Cell">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="Category"
                  Width="*>140">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Type"
                  Width="*>160">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Contract"
                  Width="*>140">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Settlement"
                  Width="*>150">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Region"
                  Width="*>150">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Country"
                  Width="*>160">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Open"
                  HeaderText="Open"
                  Width="*>140"
                  ShowGroupingSeparator="true"
                  PositivePrefix="$"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Price"
                  HeaderText="Close"
                  Width="*>140"
                  ShowGroupingSeparator="true"
                  PositivePrefix="$"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Change"
                  Width="*>130"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="ChangePercent"
                  Width="*>150"
                  NegativeSuffix="%"
                  PositiveSuffix="%"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Buy"
                  Width="*>110"
                  ShowGroupingSeparator="true"
                  PositivePrefix="$"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Sell"
                  Width="*>110"
                  ShowGroupingSeparator="true"
                  PositivePrefix="$"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Spread"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Volume"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="0"
                  MaxFractionDigits="0">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="High"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2"
                  PositivePrefix="$">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Low"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2"
                  PositivePrefix="$">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="YearlyHigh"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2"
                  PositivePrefix="$">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="YearlyLow"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2"
                  PositivePrefix="$">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="YearlyStart"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2"
                  PositivePrefix="$">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Maturity"
                  Width="*>140"
                  HorizontalAlignment="Right">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:TextColumn
                  Field="Currency"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Risk"
                  Width="*>110">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Sector"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Security"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Issuer"
                  Width="*>170">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
