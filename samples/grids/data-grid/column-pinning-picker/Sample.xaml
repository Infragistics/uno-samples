<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          x:Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=grid}"
          DescriptionType="DataGrid"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="PinLeftButton"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Pin Left"
                  ButtonClicked="DataGridPinIdAndNameColumnsLeft">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="PinRightButton"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Pin Right"
                  ButtonClicked="DataGridPinAddressColumnsRight">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="UnpinButton"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Unpin Columns"
                  ButtonClicked="DataGridUnpinNameAndAddressColumns">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          DefaultColumnMinWidth="120">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="ID"
                  Pinned="Left"
                  Width="*>110">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="FirstName"
                  Pinned="Left"
                  Width="*>190">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="LastName"
                  Pinned="Left"
                  Width="*>190">
                  </igDataGrids:TextColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  Width="*>170">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:NumericColumn
                  Field="Age"
                  Width="*>120">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:ImageColumn
                  Field="CountryFlag"
                  IsEditable="false">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TextColumn
                  Field="Street"
                  Width="*>160">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="City"
                  Width="260">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Country"
                  Width="*>170">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  Width="*>170">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Sales"
                  Width="*>120">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  Width="*>120"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true"
                  MaxFractionDigits="0"
                  MinFractionDigits="0">
                  </igDataGrids:NumericColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
