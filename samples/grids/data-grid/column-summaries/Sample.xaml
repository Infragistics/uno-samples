<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          x:Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=grid}"
          DescriptionType="DataGrid"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="SummaryScope"
                  x:Name="SummaryScopeEditor"
                  Label="Summary Scope"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="Root">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="GroupSummaryDisplayMode"
                  x:Name="GroupSummaryDisplayModeEditor"
                  Label="Group Summary Display Mode"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames2}"
                  DropDownValues="{Binding dropDownValues2}"
                  PrimitiveValue="RowBottom">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding ProductOrders}"
          IsColumnOptionsEnabled="true"
          IsGroupCollapsable="true"
          GroupHeaderDisplayMode="Combined"
          SummaryScope="Root"
          GroupSummaryDisplayMode="RowBottom">
              <igDataGrids:XamDataGrid.GroupDescriptions>
                  <igDataGrids:ColumnGroupDescription
                  Field="ProductName"
                  DisplayName="ProductName">
                  </igDataGrids:ColumnGroupDescription>
              </igDataGrids:XamDataGrid.GroupDescriptions>
              <igDataGrids:XamDataGrid.SummaryDescriptions>
                  <igDataGrids:ColumnSummaryDescription
                  Field="ProductName"
                  Operand="Count">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="ProductPrice"
                  Operand="Min">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="ProductPrice"
                  Operand="Max">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="OrderItems"
                  Operand="Sum">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="OrderValue"
                  Operand="Sum">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="OrderValue"
                  Operand="Average">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="OrderDate"
                  Operand="Min"
                  CalculatorDisplayName="First">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="OrderDate"
                  Operand="Max"
                  CalculatorDisplayName="Last">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Profit"
                  Operand="Sum">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Profit"
                  Operand="Average">
                  </igDataGrids:ColumnSummaryDescription>
              </igDataGrids:XamDataGrid.SummaryDescriptions>
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:NumericColumn
                  Field="ProductID"
                  HeaderText="ID"
                  Width="*>120"
                  HorizontalAlignment="Center">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="ProductName"
                  HeaderText="Product"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="ProductPrice"
                  HeaderText="Price"
                  Width="*>120"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="OrderItems"
                  HeaderText="Orders"
                  Width="*>140">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="OrderValue"
                  HeaderText="Order Totals"
                  Width="*>160"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:DateTimeColumn
                  Field="OrderDate"
                  HeaderText="Order Date"
                  Width="*>150"
                  HorizontalAlignment="Right">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:NumericColumn
                  Field="Profit"
                  HeaderText="Profit"
                  Width="*>140"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="Country"
                  HeaderText="Ship Country"
                  Width="*>170">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
