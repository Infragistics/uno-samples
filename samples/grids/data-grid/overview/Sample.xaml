<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          RowHeight="50"
          IsColumnOptionsEnabled="true"
          IsGroupCollapsable="true"
          ActivationMode="Cell"
          SummaryScope="Root"
          GroupSummaryDisplayMode="RowBottom"
          GroupHeaderDisplayMode="Combined"
          CornerRadiusTopLeft="0"
          CornerRadiusTopRight="0"
          ColumnMovingSeparatorWidth="2"
          ColumnMovingMode="Deferred"
          ColumnMovingAnimationMode="SlideOver"
          ColumnShowingAnimationMode="SlideFromRightAndFadeIn"
          ColumnHidingAnimationMode="SlideToRightAndFadeOut"
          SelectionMode="SingleRow">
              <igDataGrids:XamDataGrid.GroupDescriptions>
                  <igDataGrids:ColumnGroupDescription
                  Field="Country"
                  DisplayName="Country">
                  </igDataGrids:ColumnGroupDescription>
                  <igDataGrids:ColumnGroupDescription
                  Field="Income"
                  DisplayName="Income">
                  </igDataGrids:ColumnGroupDescription>
              </igDataGrids:XamDataGrid.GroupDescriptions>
              <igDataGrids:XamDataGrid.SummaryDescriptions>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Age"
                  Operand="Average">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Photo"
                  Operand="Count">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Salary"
                  Operand="Sum">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Sales"
                  Operand="Max">
                  </igDataGrids:ColumnSummaryDescription>
              </igDataGrids:XamDataGrid.SummaryDescriptions>
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:ImageColumn
                  Field="Photo"
                  Width="*>120"
                  IsEditable="false"
                  PaddingTop="5"
                  PaddingBottom="5"
                  PaddingRight="10"
                  HorizontalAlignment="Stretch">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TextColumn
                  Field="Name"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TemplateColumn
                  Field="Sales"
                  Width="*>160"
                  CellUpdating="DataGridSalesGaugeTemplate"
                  HorizontalAlignment="Center"
                  x:Name="templateColumn1">
                  </igDataGrids:TemplateColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  Width="*>130"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true"
                  MaxFractionDigits="0"
                  MinFractionDigits="0">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Age"
                  Width="100"
                  HorizontalAlignment="Center">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  HeaderText="Date of Birth"
                  Width="*>140">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:ImageColumn
                  Field="CountryFlag"
                  HeaderText="Country"
                  Width="*>110"
                  IsEditable="false"
                  PaddingTop="5"
                  PaddingBottom="5"
                  PaddingRight="10"
                  HorizontalAlignment="Stretch">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TemplateColumn
                  Field="Address"
                  Width="*>170"
                  CellUpdating="DataGridAddressLinesTemplate"
                  x:Name="templateColumn2">
                  </igDataGrids:TemplateColumn>
                  <igDataGrids:TemplateColumn
                  Field="Phone"
                  Width="*>130"
                  CellUpdating="DataGridPhoneLinkTemplate"
                  x:Name="templateColumn3">
                  </igDataGrids:TemplateColumn>
                  <igDataGrids:TextColumn
                  Field="Income"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Email"
                  Width="*>120"
                  IsEditable="false">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
