<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding NorthwindOrders}"
          IsColumnOptionsEnabled="true">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="OrderID"
                  HeaderText="ID"
                  Width="*>90"
                  HorizontalAlignment="Center">
                  </igDataGrids:TextColumn>
                  <igDataGrids:DateTimeColumn
                  Field="OrderDate"
                  HeaderText="Order Date"
                  Width="*>130">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:TextColumn
                  Field="ShipName"
                  HeaderText="Name"
                  Width="*>185">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Freight"
                  HeaderText="Freight"
                  Width="*>115"
                  PositivePrefix="$"
                  MinFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:DateTimeColumn
                  Field="ShippedDate"
                  HeaderText="Ship Date"
                  Width="*>125"
                  HorizontalAlignment="Right">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:TextColumn
                  Field="ShipAddress"
                  HeaderText="Shipping Address"
                  Width="*>250">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="ShipCity"
                  HeaderText="City"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="ShipCountry"
                  HeaderText="Country"
                  Width="*>110">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
