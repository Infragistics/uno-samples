<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          x:Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=grid}"
          DescriptionType="DataGrid"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="LiveSomePricesEditor"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Live Prices"
                  ButtonClicked="DataGridToggleLiveSomePrices">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="LiveAllPricesEditor"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Live All Prices"
                  ButtonClicked="DataGridToggleLiveAllPrices">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="GroupingEditor"
                  Label="Grouping"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Boolean"
                  PrimitiveValue="True"
                  Changed="DataGridApplyLiveDataGrouping">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="HeatEditor"
                  Label="Heat"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Boolean"
                  PrimitiveValue="True"
                  Changed="DataGridToggleHeat">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding PortfolioData}"
          SelectionMode="MultipleRow"
          IsGroupCollapsable="true"
          RowHeight="32"
          HeaderClickAction="SortByMultipleColumnsTriState"
          ActivationMode="Cell"
          DefaultColumnMinWidth="100"
          IsRowHoverEnabled="false">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="ID"
                  Width="*>140"
                  IsHidden="true">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Category"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Type"
                  Width="*>110">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Risk"
                  Width="*>110">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Open"
                  HeaderText="Open"
                  Width="*>120"
                  ShowGroupingSeparator="true"
                  PositivePrefix="$"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TemplateColumn
                  Field="Price"
                  HeaderText="Close"
                  Width="*>120"
                  CellStyleKeyRequested="DataGridPriceStyleKey"
                  CellUpdating="DataGridPriceCellUpdating"
                  DataBound="DataGridPriceDataBound"
                  x:Name="templateColumn1">
                  </igDataGrids:TemplateColumn>
                  <igDataGrids:NumericColumn
                  Field="Change"
                  HeaderText="Change ($)"
                  Width="*>120"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="ChangePercent"
                  HeaderText="Change (%)"
                  Width="*>180"
                  NegativeSuffix="%"
                  PositiveSuffix="%"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="Contract"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Settlement"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Region"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Country"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Buy"
                  Width="*>110"
                  ShowGroupingSeparator="true"
                  PositivePrefix="$"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Sell"
                  Width="*>110"
                  ShowGroupingSeparator="true"
                  PositivePrefix="$"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Spread"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Volume"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="0"
                  MaxFractionDigits="0">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="DailyHigh"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2"
                  PositivePrefix="$">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="DailyLow"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2"
                  PositivePrefix="$">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="YearlyHigh"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2"
                  PositivePrefix="$">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="YearlyLow"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2"
                  PositivePrefix="$">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="YearlyStart"
                  Width="*>130"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2"
                  MaxFractionDigits="2"
                  PositivePrefix="$">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Maturity"
                  Width="*>140"
                  HorizontalAlignment="Right">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:TextColumn
                  Field="Currency"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Sector"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Security"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Issuer"
                  Width="*>170">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
