<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          ActivationMode="Cell">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:ImageColumn
                  Field="Photo"
                  Width="*>140"
                  IsEditable="false"
                  ContentOpacity="1"
                  HorizontalAlignment="Center">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TextColumn
                  Field="FirstName"
                  HeaderText="First Name"
                  Width="*>150">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="LastName"
                  HeaderText="Last Name"
                  Width="*>140">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="City"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Country"
                  Width="*>150">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Sales"
                  Width="*>140"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Age"
                  Width="*>110">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  Width="*>170"
                  HorizontalAlignment="Right">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  Width="*>130"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="Email"
                  HeaderText="Email"
                  Width="*>150">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
