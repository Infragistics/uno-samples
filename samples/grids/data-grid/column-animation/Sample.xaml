<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          x:Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=grid}"
          DescriptionType="DataGrid"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ColumnShowingAnimationMode"
                  x:Name="ColumnShowingAnimationModeEditor"
                  Label="Adding Animation"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="SlideFromLeft">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ColumnExchangingAnimationMode"
                  x:Name="ColumnExchangingAnimationModeEditor"
                  Label="Exchange Animation"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames2}"
                  DropDownValues="{Binding dropDownValues2}"
                  PrimitiveValue="Crossfade">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ColumnHidingAnimationMode"
                  x:Name="ColumnHidingAnimationModeEditor"
                  Label="Hiding Animation"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames3}"
                  DropDownValues="{Binding dropDownValues3}"
                  PrimitiveValue="FadeOut">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ColumnPropertyUpdatingAnimationMode"
                  x:Name="ColumnPropertyUpdatingAnimationModeEditor"
                  Label="Updating Animation"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames4}"
                  DropDownValues="{Binding dropDownValues4}"
                  PrimitiveValue="Interpolate">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ColumnMovingAnimationMode"
                  x:Name="ColumnMovingAnimationModeEditor"
                  Label="Moving Animation"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames5}"
                  DropDownValues="{Binding dropDownValues5}"
                  PrimitiveValue="SlideOver">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="HideColumnButton"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Hide Column"
                  ButtonClicked="DataGridHideFirstVisibleColumn">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="ShowColumnButton"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Show Column"
                  ButtonClicked="DataGridShowLastHiddenColumn">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="ReloadGridButton"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Reload Grid"
                  ButtonClicked="DataGridReloadSalaryData">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          IsColumnOptionsEnabled="true"
          DefaultColumnMinWidth="100"
          ColumnAddingAnimationMode="None"
          ColumnShowingAnimationMode="SlideFromLeft"
          ColumnExchangingAnimationMode="Crossfade"
          ColumnHidingAnimationMode="FadeOut"
          ColumnMovingAnimationMode="SlideOver"
          ColumnPropertyUpdatingAnimationMode="Interpolate">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="Name"
                  Width="*>170">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Street"
                  HeaderText="Address"
                  Width="*>150">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="City"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  Width="*>120"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  Width="*>170">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:TextColumn
                  Field="Country"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Sales"
                  Width="*>120"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Age"
                  Width="*>120">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="Email"
                  Width="*>120">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
