<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          DefaultColumnMinWidth="100"
          IsColumnOptionsEnabled="true"
          FilterUIType="FilterRow">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="Country"
                  HeaderText="Code-behind Filter*"
                  Width="*>170">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Age"
                  HeaderText="Custom Class Filter**">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Sales"
                  HeaderText="In-line Filter***"
                  Width="*>120"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
