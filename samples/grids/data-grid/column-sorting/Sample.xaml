<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                xmlns:igDataGrids="using:Infragistics.Controls.Grids"
                    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                <Grid>
          <igLayouts:XamPropertyEditorPanel
          Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=grid}"
          DescriptionType="DataGrid"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="HeaderClickAction"
                  Name="HeaderClickActionEditor"
                  Label="Header Click Action"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="SortByMultipleColumnsTriState">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igDataGrids:XamDataGrid
          Name="grid"
          ItemsSource="{Binding RealEstateData}"
          AutoGenerateColumns="false"
          DefaultColumnMinWidth="100"
          IsColumnOptionsEnabled="true"
          HeaderClickAction="SortByMultipleColumnsTriState">
              <igDataGrids:XamDataGrid.SortDescriptions>
                  <igDataGrids:ColumnSortDescription
                  Field="Property"
                  SortDirection="Descending">
                  </igDataGrids:ColumnSortDescription>
              </igDataGrids:XamDataGrid.SortDescriptions>
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="ID"
                  HorizontalAlignment="Center">
                      <igDataGrids:TextColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="110">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:TextColumn.Width>
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Property"
                  HeaderText="Property">
                      <igDataGrids:TextColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="150">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:TextColumn.Width>
                  </igDataGrids:TextColumn>
                  <igDataGrids:ImageColumn
                  Field="CountryFlag"
                  HeaderText="Country"
                  IsEditable="false"
                  ContentOpacity="1"
                  HorizontalAlignment="Center"
                  PaddingTop="5"
                  PaddingBottom="5">
                      <igDataGrids:ImageColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="160">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:ImageColumn.Width>
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TextColumn
                  Field="City">
                      <igDataGrids:TextColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="150">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:TextColumn.Width>
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Price"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                      <igDataGrids:NumericColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="130">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:NumericColumn.Width>
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Rooms">
                      <igDataGrids:NumericColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="110">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:NumericColumn.Width>
                  </igDataGrids:NumericColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
