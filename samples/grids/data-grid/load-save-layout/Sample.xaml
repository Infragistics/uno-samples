<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          x:Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=grid}"
          DescriptionType="DataGrid"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="LoadButton"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Load"
                  ButtonClicked="DataGridLoadLayout">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  x:Name="SaveButton"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Save"
                  ButtonClicked="DataGridSaveLayout">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          RowHeight="50"
          IsColumnOptionsEnabled="true"
          DefaultColumnMinWidth="100"
          SummaryScope="Root"
          IsGroupCollapsable="true"
          GroupHeaderDisplayMode="Combined"
          GroupSummaryDisplayMode="RowTop"
          SelectionMode="SingleRow"
          CornerRadiusTopLeft="0"
          CornerRadiusTopRight="0"
          ColumnMovingAnimationMode="Auto">
              <igDataGrids:XamDataGrid.GroupDescriptions>
                  <igDataGrids:ColumnGroupDescription
                  Field="Country"
                  DisplayName="Country">
                  </igDataGrids:ColumnGroupDescription>
                  <igDataGrids:ColumnGroupDescription
                  Field="Income"
                  DisplayName="Income">
                  </igDataGrids:ColumnGroupDescription>
              </igDataGrids:XamDataGrid.GroupDescriptions>
              <igDataGrids:XamDataGrid.SummaryDescriptions>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Photo"
                  Operand="Count">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Sales"
                  Operand="Max">
                  </igDataGrids:ColumnSummaryDescription>
                  <igDataGrids:ColumnSummaryDescription
                  Field="Salary"
                  Operand="Average">
                  </igDataGrids:ColumnSummaryDescription>
              </igDataGrids:XamDataGrid.SummaryDescriptions>
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:ImageColumn
                  Field="Photo"
                  HeaderText="Photo"
                  Width="110"
                  ContentOpacity="1"
                  HorizontalAlignment="Center">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TextColumn
                  Field="Name"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Sales"
                  HeaderText="Sales"
                  Width="*>160"
                  HorizontalAlignment="Center">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  Width="*>160"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="Address"
                  HeaderText="Address"
                  Width="*>160"
                  HorizontalAlignment="Left">
                  </igDataGrids:TextColumn>
                  <igDataGrids:ImageColumn
                  Field="CountryFlag"
                  HeaderText="Country"
                  Width="130"
                  ContentOpacity="1"
                  HorizontalAlignment="Stretch"
                  PaddingTop="7"
                  PaddingBottom="7">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  HeaderText="Date of Birth"
                  Width="*>160"
                  HorizontalAlignment="Right">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:TextColumn
                  Field="Income"
                  Width="*>120"
                  HorizontalAlignment="Center">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Age"
                  Width="*>110">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
