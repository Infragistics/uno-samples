<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
            xmlns:igMaps="using:Infragistics.Controls.Maps"
                            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
          <igMaps:XamGeographicMap
          Name="streetMap"
          Zoomable="true">
              <igMaps:XamGeographicMap.BackgroundContent>
                  <igMaps:ArcGISOnlineMapImagery
                  Name="streetMapImagery"
                  MapServerUri="WorldStreetMap">
                  </igMaps:ArcGISOnlineMapImagery>
              </igMaps:XamGeographicMap.BackgroundContent>
          </igMaps:XamGeographicMap>
        </Grid>
                <Grid Grid.Column="1">
          <igMaps:XamGeographicMap
          Name="oceansMap"
          Zoomable="true">
              <igMaps:XamGeographicMap.BackgroundContent>
                  <igMaps:ArcGISOnlineMapImagery
                  Name="oceansMapImagery"
                  MapServerUri="WorldOceansMap">
                  </igMaps:ArcGISOnlineMapImagery>
              </igMaps:XamGeographicMap.BackgroundContent>
          </igMaps:XamGeographicMap>
        </Grid>
                <Grid Grid.Column="2">
          <igMaps:XamGeographicMap
          Name="topographicMap"
          Zoomable="true">
              <igMaps:XamGeographicMap.BackgroundContent>
                  <igMaps:ArcGISOnlineMapImagery
                  Name="topographicMapImagery"
                  MapServerUri="WorldTopographicMap">
                  </igMaps:ArcGISOnlineMapImagery>
              </igMaps:XamGeographicMap.BackgroundContent>
          </igMaps:XamGeographicMap>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
