<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
            xmlns:igMaps="using:Infragistics.Controls.Maps"
                            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igMaps:XamGeographicMap
          Name="map"
          Zoomable="true">
              <igMaps:XamGeographicMap.Series>
                  <igMaps:GeographicProportionalSymbolSeries
                  Name="WorldCitiesSeries"
                  ItemsSource="{Binding WorldCities}"
                  MarkerType="Circle"
                  FillMemberPath="Population"
                  RadiusMemberPath="Population"
                  LatitudeMemberPath="Y"
                  LongitudeMemberPath="X"
                  MarkerOutline="#4c000000">
                      <igMaps:GeographicProportionalSymbolSeries.RadiusScale>
                          <igMaps:SizeScale
                          MinimumValue="4"
                          MaximumValue="60">
                          </igMaps:SizeScale>
                      </igMaps:GeographicProportionalSymbolSeries.RadiusScale>
                      <igMaps:GeographicProportionalSymbolSeries.FillScale>
                          <igMaps:ValueBrushScale
                          Brushes="#660ec20e #66fcaa20 #66fc2020"
                          MinimumValue="0"
                          MaximumValue="30">
                          </igMaps:ValueBrushScale>
                      </igMaps:GeographicProportionalSymbolSeries.FillScale>
                  </igMaps:GeographicProportionalSymbolSeries>
              </igMaps:XamGeographicMap.Series>
          </igMaps:XamGeographicMap>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
