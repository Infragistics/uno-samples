<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igMaps="using:Infragistics.Controls.Maps"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igMaps:XamGeographicMap
          x:Name="map"
          Zoomable="true">
              <igMaps:XamGeographicMap.Series>
                  <igMaps:GeographicPolylineSeries
                  x:Name="GeographicPolylineSeries1"
                  Outline="red">
                      <igMaps:GeographicPolylineSeries.ShapefileDataSource>
                          <ig:ShapeDataSource
                          ShapefileSource="https://static.infragistics.com/xplatform/shapes/AmericanRoads.shp"
                          DatabaseSource="https://static.infragistics.com/xplatform/shapes/AmericanRoads.dbf">
                          </ig:ShapeDataSource>
                      </igMaps:GeographicPolylineSeries.ShapefileDataSource>
                  </igMaps:GeographicPolylineSeries>
              </igMaps:XamGeographicMap.Series>
          </igMaps:XamGeographicMap>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
