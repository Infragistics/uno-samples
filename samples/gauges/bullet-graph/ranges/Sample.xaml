<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamBulletGraph
          Name="gauge"
          Height="80px"
          MinimumValue="0"
          Value="80"
          MaximumValue="100"
          Interval="10"
          TargetValue="90">
              <igGauges:XamBulletGraph.Ranges>
                  <igGauges:LinearGraphRange
                  Brush="#c62828"
                  Outline="#c62828"
                  StartValue="0"
                  EndValue="40"
                  InnerStartExtent="0.075"
                  InnerEndExtent="0.075"
                  OuterStartExtent="0.95"
                  OuterEndExtent="0.95">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#f96232"
                  Outline="#f96232"
                  StartValue="40"
                  EndValue="70"
                  InnerStartExtent="0.075"
                  InnerEndExtent="0.075"
                  OuterStartExtent="0.95"
                  OuterEndExtent="0.95">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#ff9800"
                  Outline="#ff9800"
                  StartValue="70"
                  EndValue="100"
                  InnerStartExtent="0.075"
                  InnerEndExtent="0.075"
                  OuterStartExtent="0.95"
                  OuterEndExtent="0.95">
                  </igGauges:LinearGraphRange>
              </igGauges:XamBulletGraph.Ranges>
          </igGauges:XamBulletGraph>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
