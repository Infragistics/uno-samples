<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                <Grid>
          <igLayouts:XamPropertyEditorPanel
          Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=gauge}"
          DescriptionType="BulletGraph"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="AnimateToGauge1Button"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Gauge Animation #1"
                  ButtonClicked="BulletGraphAnimateToGauge1">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="AnimateToGauge2Button"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Gauge Animation #2"
                  ButtonClicked="BulletGraphAnimateToGauge2">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="AnimateToGauge3Button"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Gauge Animation #3"
                  ButtonClicked="BulletGraphAnimateToGauge3">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamBulletGraph
          Name="gauge"
          Height="80px"
          Orientation="Horizontal"
          TransitionDuration="1000"
          MinimumValue="0"
          MaximumValue="120"
          Value="70"
          Interval="10"
          LabelInterval="10"
          LabelExtent="0.02"
          ValueInnerExtent="0.5"
          ValueOuterExtent="0.7"
          ValueBrush="black"
          TargetValueBrush="black"
          TargetValueBreadth="10"
          TargetValue="90"
          MinorTickCount="5"
          MinorTickEndExtent="0.1"
          MinorTickStartExtent="0.2"
          TickStartExtent="0.2"
          TickEndExtent="0.05"
          TickStrokeThickness="2"
          ScaleBackgroundBrush="#dbdbdb"
          ScaleBackgroundOutline="gray"
          ScaleBackgroundThickness="0"
          ScaleStartExtent="0.05"
          ScaleEndExtent="0.95"
          BackingBrush="#f7f7f7"
          BackingOutline="#d1d1d1"
          BackingStrokeThickness="0">
              <igGauges:XamBulletGraph.Ranges>
                  <igGauges:LinearGraphRange
                  Brush="#ff9800"
                  Outline="#ff9800"
                  StartValue="0"
                  EndValue="40"
                  InnerStartExtent="0.2"
                  InnerEndExtent="0.2"
                  OuterStartExtent="0.95"
                  OuterEndExtent="0.95">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#f96232"
                  Outline="#f96232"
                  StartValue="40"
                  EndValue="80"
                  InnerStartExtent="0.2"
                  InnerEndExtent="0.2"
                  OuterStartExtent="0.95"
                  OuterEndExtent="0.95">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#c62828"
                  Outline="#c62828"
                  StartValue="80"
                  EndValue="120"
                  InnerStartExtent="0.2"
                  InnerEndExtent="0.2"
                  OuterStartExtent="0.95"
                  OuterEndExtent="0.95">
                  </igGauges:LinearGraphRange>
              </igGauges:XamBulletGraph.Ranges>
          </igGauges:XamBulletGraph>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
