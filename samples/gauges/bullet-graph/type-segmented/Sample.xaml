<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                <Grid>
          <igGauges:XamBulletGraph
          Name="graph1"
          Height="120px"
          Orientation="Horizontal"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          TransitionDuration="500"
          MinimumValue="0"
          MaximumValue="100"
          Interval="10"
          LabelInterval="10"
          LabelExtent="0.15"
          ScaleBackgroundBrush="#00000000"
          ScaleBackgroundOutline="#00000000"
          ScaleStartExtent="0.05"
          ScaleEndExtent="0.95"
          Value="90"
          ValueBrush="#00000000"
          ValueOutline="#00000000"
          ValueInnerExtent="0.3"
          ValueOuterExtent="0.85"
          TargetValue="80"
          TargetValueInnerExtent="0.2"
          TargetValueOuterExtent="0.95"
          TickBrush="white"
          TickStrokeThickness="2"
          TickStartExtent="0.2"
          TickEndExtent="0.95"
          MinorTickBrush="white"
          MinorTickStrokeThickness="2"
          MinorTickStartExtent="0.2"
          MinorTickEndExtent="0.95"
          MinorTickCount="4">
              <igGauges:XamBulletGraph.Ranges>
                  <igGauges:LinearGraphRange
                  StartValue="0"
                  EndValue="100"
                  Brush="#e0dfdf"
                  Outline="#e0dfdf"
                  InnerStartExtent="0.3"
                  InnerEndExtent="0.3"
                  OuterStartExtent="0.85"
                  OuterEndExtent="0.85">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  StartValue="0"
                  EndValue="90"
                  Brush="#10b401"
                  Outline="#10b401"
                  InnerStartExtent="0.3"
                  InnerEndExtent="0.3"
                  OuterStartExtent="0.85"
                  OuterEndExtent="0.85">
                  </igGauges:LinearGraphRange>
              </igGauges:XamBulletGraph.Ranges>
          </igGauges:XamBulletGraph>
        </Grid>
                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamBulletGraph
          Name="graph2"
          Height="120px"
          Orientation="Horizontal"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          TransitionDuration="500"
          MinimumValue="0"
          MaximumValue="100"
          Interval="10"
          LabelInterval="10"
          LabelExtent="0.15"
          ScaleBackgroundBrush="#00000000"
          ScaleBackgroundOutline="#00000000"
          ScaleStartExtent="0.05"
          ScaleEndExtent="0.95"
          Value="70"
          ValueBrush="#00000000"
          ValueOutline="#00000000"
          ValueInnerExtent="0.3"
          ValueOuterExtent="0.85"
          TargetValue="80"
          TargetValueInnerExtent="0.2"
          TargetValueOuterExtent="0.95"
          TickBrush="white"
          TickStrokeThickness="2"
          TickStartExtent="0.2"
          TickEndExtent="0.95"
          MinorTickBrush="white"
          MinorTickStrokeThickness="2"
          MinorTickStartExtent="0.2"
          MinorTickEndExtent="0.95"
          MinorTickCount="4">
              <igGauges:XamBulletGraph.Ranges>
                  <igGauges:LinearGraphRange
                  StartValue="0"
                  EndValue="100"
                  Brush="#e0dfdf"
                  Outline="#e0dfdf"
                  InnerStartExtent="0.3"
                  InnerEndExtent="0.3"
                  OuterStartExtent="0.85"
                  OuterEndExtent="0.85">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  StartValue="0"
                  EndValue="70"
                  Brush="#fdb417"
                  Outline="#fdb417"
                  InnerStartExtent="0.3"
                  InnerEndExtent="0.3"
                  OuterStartExtent="0.85"
                  OuterEndExtent="0.85">
                  </igGauges:LinearGraphRange>
              </igGauges:XamBulletGraph.Ranges>
          </igGauges:XamBulletGraph>
        </Grid>
              </Grid>
            <Grid Grid.Row="2">
        <igGauges:XamBulletGraph
        Name="graph3"
        Height="120px"
        Orientation="Horizontal"
        BackingBrush="#00000000"
        BackingOutline="#00000000"
        TransitionDuration="500"
        MinimumValue="0"
        MaximumValue="100"
        Interval="10"
        LabelInterval="10"
        LabelExtent="0.15"
        ScaleBackgroundBrush="#00000000"
        ScaleBackgroundOutline="#00000000"
        ScaleStartExtent="0.05"
        ScaleEndExtent="0.95"
        Value="50"
        ValueBrush="#00000000"
        ValueOutline="#00000000"
        ValueInnerExtent="0.3"
        ValueOuterExtent="0.85"
        TargetValue="80"
        TargetValueInnerExtent="0.2"
        TargetValueOuterExtent="0.95"
        TickBrush="white"
        TickStrokeThickness="2"
        TickStartExtent="0.2"
        TickEndExtent="0.95"
        MinorTickBrush="white"
        MinorTickStrokeThickness="2"
        MinorTickStartExtent="0.2"
        MinorTickEndExtent="0.95"
        MinorTickCount="4">
            <igGauges:XamBulletGraph.Ranges>
                <igGauges:LinearGraphRange
                StartValue="0"
                EndValue="100"
                Brush="#e0dfdf"
                Outline="#e0dfdf"
                InnerStartExtent="0.3"
                InnerEndExtent="0.3"
                OuterStartExtent="0.85"
                OuterEndExtent="0.85">
                </igGauges:LinearGraphRange>
                <igGauges:LinearGraphRange
                StartValue="0"
                EndValue="50"
                Brush="red"
                Outline="red"
                InnerStartExtent="0.3"
                InnerEndExtent="0.3"
                OuterStartExtent="0.85"
                OuterEndExtent="0.85">
                </igGauges:LinearGraphRange>
            </igGauges:XamBulletGraph.Ranges>
        </igGauges:XamBulletGraph>
      </Grid>
          </Grid>
</UserControl>
