<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                <Grid>
          <igGauges:XamBulletGraph
          Name="graph1"
          Height="120px"
          Orientation="Horizontal"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          TransitionDuration="500"
          MinorTickCount="4"
          Value="90"
          ValueBrush="#10b401"
          ValueOutline="#10b401"
          TargetValue="80"
          MinimumValue="0"
          MaximumValue="100"
          Interval="5"
          LabelInterval="5"
          LabelExtent="0.1"
          ScaleBackgroundBrush="#00000000"
          ScaleBackgroundOutline="#00000000"
          ScaleStartExtent="0.05"
          ScaleEndExtent="0.95"
          ValueInnerExtent="0.3"
          ValueOuterExtent="0.85"
          MinorTickBrush="#00000000"
          TickBrush="gray"
          TickStartExtent="0.3"
          TickEndExtent="0.2"
          TickStrokeThickness="1">
              <igGauges:XamBulletGraph.Ranges>
                  <igGauges:LinearGraphRange
                  StartValue="0"
                  EndValue="100"
                  Brush="#e0dfdf"
                  Outline="#e0dfdf"
                  InnerStartExtent="0.3"
                  InnerEndExtent="0.3"
                  OuterStartExtent="0.85"
                  OuterEndExtent="0.85">
                  </igGauges:LinearGraphRange>
              </igGauges:XamBulletGraph.Ranges>
          </igGauges:XamBulletGraph>
        </Grid>
                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamBulletGraph
          Name="graph2"
          Height="120px"
          Orientation="Horizontal"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          TransitionDuration="500"
          MinorTickCount="4"
          Value="70"
          ValueBrush="#fdb417"
          ValueOutline="#fdb417"
          TargetValue="80"
          MinimumValue="0"
          MaximumValue="100"
          Interval="5"
          LabelInterval="5"
          LabelExtent="0.1"
          ScaleBackgroundBrush="#00000000"
          ScaleBackgroundOutline="#00000000"
          ScaleStartExtent="0.05"
          ScaleEndExtent="0.95"
          ValueInnerExtent="0.3"
          ValueOuterExtent="0.85"
          MinorTickBrush="#00000000"
          TickBrush="gray"
          TickStartExtent="0.3"
          TickEndExtent="0.2"
          TickStrokeThickness="1">
              <igGauges:XamBulletGraph.Ranges>
                  <igGauges:LinearGraphRange
                  StartValue="0"
                  EndValue="100"
                  Brush="#e0dfdf"
                  Outline="#e0dfdf"
                  InnerStartExtent="0.3"
                  InnerEndExtent="0.3"
                  OuterStartExtent="0.85"
                  OuterEndExtent="0.85">
                  </igGauges:LinearGraphRange>
              </igGauges:XamBulletGraph.Ranges>
          </igGauges:XamBulletGraph>
        </Grid>
              </Grid>
            <Grid Grid.Row="2">
        <igGauges:XamBulletGraph
        Name="graph3"
        Height="120px"
        Orientation="Horizontal"
        BackingBrush="#00000000"
        BackingOutline="#00000000"
        TransitionDuration="500"
        MinorTickCount="4"
        Value="50"
        ValueBrush="red"
        ValueOutline="red"
        TargetValue="80"
        MinimumValue="0"
        MaximumValue="100"
        Interval="5"
        LabelInterval="5"
        LabelExtent="0.1"
        ScaleBackgroundBrush="#00000000"
        ScaleBackgroundOutline="#00000000"
        ScaleStartExtent="0.05"
        ScaleEndExtent="0.95"
        ValueInnerExtent="0.3"
        ValueOuterExtent="0.85"
        MinorTickBrush="#00000000"
        TickBrush="gray"
        TickStartExtent="0.3"
        TickEndExtent="0.2"
        TickStrokeThickness="1">
            <igGauges:XamBulletGraph.Ranges>
                <igGauges:LinearGraphRange
                StartValue="0"
                EndValue="100"
                Brush="#e0dfdf"
                Outline="#e0dfdf"
                InnerStartExtent="0.3"
                InnerEndExtent="0.3"
                OuterStartExtent="0.85"
                OuterEndExtent="0.85">
                </igGauges:LinearGraphRange>
            </igGauges:XamBulletGraph.Ranges>
        </igGauges:XamBulletGraph>
      </Grid>
          </Grid>
</UserControl>
