<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamRadialGauge
          Name="gauge"
          MinimumValue="0"
          MaximumValue="360"
          Value="270"
          Interval="30"
          TransitionDuration="500"
          LabelInterval="30"
          LabelExtent="0.85"
          Font="15px Verdana,Arial"
          ScaleStartAngle="0"
          ScaleEndAngle="360"
          ScaleBrush="#e0dfdf"
          ScaleOversweepShape="Circular"
          ScaleSweepDirection="Clockwise"
          ScaleEndExtent="0.7"
          ScaleStartExtent="0.6"
          MinorTickCount="4"
          MinorTickStartExtent="0.6"
          MinorTickEndExtent="0.65"
          MinorTickStrokeThickness="1"
          MinorTickBrush="#00000000"
          TickStartExtent="0.6"
          TickEndExtent="0.65"
          TickStrokeThickness="1"
          TickBrush="#79797a"
          BackingShape="Circular"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          NeedleShape="None"
          NeedlePivotShape="None">
          </igGauges:XamRadialGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
