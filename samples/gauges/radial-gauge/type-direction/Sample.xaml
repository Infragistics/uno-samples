<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                <Grid>
          <igGauges:XamRadialGauge
          Name="gauge1"
          Height="250px"
          MinimumValue="0"
          MaximumValue="360"
          Value="30"
          Interval="15"
          LabelInterval="15"
          LabelExtent="0.575"
          Font="11px Verdana,Arial"
          TransitionDuration="500"
          ScaleStartAngle="-90"
          ScaleEndAngle="270"
          ScaleBrush="#e0dfdf"
          ScaleOversweepShape="Circular"
          ScaleSweepDirection="Clockwise"
          ScaleEndExtent="0.7"
          ScaleStartExtent="0.675"
          IsNeedleDraggingConstrained="false"
          IsNeedleDraggingEnabled="false"
          NeedlePivotShape="None"
          NeedleShape="Triangle"
          NeedleBaseFeatureWidthRatio="0.2"
          NeedleEndExtent="0.55"
          NeedleBrush="red"
          MinorTickStartExtent="0.6625"
          MinorTickEndExtent="0.65"
          MinorTickCount="2"
          MinorTickStrokeThickness="1"
          MinorTickBrush="#79797a"
          TickStartExtent="0.6625"
          TickEndExtent="0.6325"
          TickStrokeThickness="1"
          TickBrush="#79797a"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          BackingShape="Circular">
          </igGauges:XamRadialGauge>
        </Grid>
                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamRadialGauge
          Name="gauge2"
          Height="250px"
          MinimumValue="0"
          MaximumValue="360"
          Value="270"
          Interval="45"
          Font="15px Verdana,Arial"
          LabelExtent="0.75"
          LabelInterval="45"
          TransitionDuration="500"
          ScaleStartAngle="-90"
          ScaleEndAngle="270"
          ScaleBrush="#e0dfdf"
          ScaleOversweepShape="Circular"
          ScaleSweepDirection="Clockwise"
          ScaleEndExtent="0.7"
          ScaleStartExtent="0.675"
          IsNeedleDraggingConstrained="false"
          IsNeedleDraggingEnabled="false"
          NeedlePivotShape="None"
          NeedleShape="Triangle"
          NeedleBaseFeatureWidthRatio="0.2"
          NeedleEndExtent="0.55"
          NeedleBrush="dodgerblue"
          MinorTickCount="2"
          MinorTickStrokeThickness="1"
          MinorTickBrush="#79797a"
          TickStrokeThickness="1"
          TickBrush="#79797a"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          BackingShape="Circular">
          </igGauges:XamRadialGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
