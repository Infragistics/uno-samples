<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamRadialGauge
          Name="gauge"
          TransitionDuration="500"
          MinimumValue="0"
          MaximumValue="80"
          Value="10"
          Interval="10"
          LabelExtent="0.6"
          LabelInterval="10"
          Font="15px Verdana,Arial"
          ScaleStartAngle="135"
          ScaleEndAngle="45"
          ScaleBrush="#0b8fed"
          ScaleOversweepShape="Auto"
          ScaleSweepDirection="Clockwise"
          ScaleEndExtent="0.825"
          ScaleStartExtent="0.775"
          BackingShape="Fitted"
          BackingBrush="#fcfcfc"
          BackingOutline="#d6d6d6"
          BackingOversweep="5"
          BackingCornerRadius="10"
          BackingOuterExtent="0.9"
          BackingStrokeThickness="4"
          NeedleShape="Needle"
          NeedlePivotShape="CircleOverlay"
          NeedleEndExtent="0.5"
          NeedlePointFeatureExtent="0.2"
          NeedlePivotWidthRatio="0.1"
          NeedleBrush="#9f9fa0"
          NeedleOutline="#9f9fa0"
          NeedlePivotBrush="#9f9fa0"
          NeedlePivotOutline="#9f9fa0"
          TickBrush="#333333"
          TickStartExtent="0.675"
          TickEndExtent="0.75"
          TickStrokeThickness="1"
          MinorTickBrush="#494949"
          MinorTickCount="4"
          MinorTickStartExtent="0.725"
          MinorTickEndExtent="0.75"
          MinorTickStrokeThickness="1">
          </igGauges:XamRadialGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
