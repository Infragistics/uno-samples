<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                <Grid>
          <igGauges:XamLinearGauge
          Name="gauge1"
          Height="80px"
          MinimumValue="-40"
          MaximumValue="100"
          Value="20"
          Interval="10"
          LabelInterval="10"
          LabelExtent="0.15"
          TransitionDuration="500"
          IsNeedleDraggingEnabled="false"
          NeedleBrush="#00000000"
          NeedleOutline="#00000000"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          ScaleStrokeThickness="0"
          ScaleBrush="#00000000"
          ScaleOutline="#00000000"
          ScaleInnerExtent="0.35"
          ScaleOuterExtent="1"
          ScaleStartExtent="0.05"
          ScaleEndExtent="0.95"
          MinorTickBrush="gray"
          MinorTickStartExtent="-0.2"
          MinorTickEndExtent="-0.1"
          MinorTickStrokeThickness="1"
          MinorTickCount="4"
          TickStartExtent="-0.2"
          TickEndExtent="0"
          TickStrokeThickness="1"
          TickBrush="gray">
              <igGauges:XamLinearGauge.Ranges>
                  <igGauges:LinearGraphRange
                  Outline="#00000000"
                  StartValue="-40"
                  EndValue="20"
                  InnerStartExtent="0.35"
                  InnerEndExtent="0.35"
                  OuterStartExtent="0.675"
                  OuterEndExtent="0.675">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Outline="#00000000"
                  StartValue="-40"
                  EndValue="20"
                  InnerStartExtent="0.675"
                  InnerEndExtent="0.675"
                  OuterStartExtent="1"
                  OuterEndExtent="1">
                  </igGauges:LinearGraphRange>
              </igGauges:XamLinearGauge.Ranges>
          </igGauges:XamLinearGauge>
        </Grid>
                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamLinearGauge
          Name="gauge2"
          Height="80px"
          MinimumValue="-40"
          MaximumValue="100"
          Value="20"
          Interval="10"
          LabelInterval="10"
          LabelExtent="0.1"
          TransitionDuration="500"
          IsNeedleDraggingEnabled="false"
          NeedleBrush="#00000000"
          NeedleOutline="#00000000"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          ScaleStrokeThickness="0"
          ScaleBrush="#e0dfdf"
          ScaleOutline="#e0dfdf"
          ScaleInnerExtent="0.35"
          ScaleOuterExtent="1"
          ScaleStartExtent="0.05"
          ScaleEndExtent="0.95"
          MinorTickBrush="gray"
          MinorTickStartExtent="0.25"
          MinorTickEndExtent="0.35"
          MinorTickStrokeThickness="1"
          MinorTickCount="4"
          TickStartExtent="0.15"
          TickEndExtent="0.35"
          TickStrokeThickness="1"
          TickBrush="gray">
              <igGauges:XamLinearGauge.Ranges>
                  <igGauges:LinearGraphRange
                  Outline="#00000000"
                  StartValue="-40"
                  EndValue="20"
                  InnerStartExtent="0.35"
                  InnerEndExtent="0.35"
                  OuterStartExtent="0.675"
                  OuterEndExtent="0.675">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Outline="#00000000"
                  StartValue="-40"
                  EndValue="20"
                  InnerStartExtent="0.675"
                  InnerEndExtent="0.675"
                  OuterStartExtent="1"
                  OuterEndExtent="1">
                  </igGauges:LinearGraphRange>
              </igGauges:XamLinearGauge.Ranges>
          </igGauges:XamLinearGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
