          NeedleBreadth="10"
          TickBrush="gray"
          TickStartExtent="0.25"
          TickEndExtent="0.15"
          TickStrokeThickness="1"
          MinorTickBrush="#00000000"
          MinorTickStartExtent="0.25"
          MinorTickEndExtent="0.2"
          MinorTickStrokeThickness="1"
          MinorTickCount="9"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          ScaleStrokeThickness="0"
          ScaleBrush="#e0dfdf"
          ScaleOutline="#e0dfdf">
              <igGauges:XamLinearGauge.Ranges>
                  <igGauges:LinearGraphRange
