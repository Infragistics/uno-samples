<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SamplesBrowser">

    <!-- *********** COLORS *********** -->

    <Color x:Key="Primary100">#FFead2fb</Color>
    <Color x:Key="Primary200">#FFDDC0F2</Color>
    <Color x:Key="Primary300">#FFC79DE7</Color>
    <Color x:Key="Primary400">#FFBA84E1</Color>
    <Color x:Key="Primary500">#FFA763D8</Color>
    <Color x:Key="Primary600">#FF874DB2</Color>
    <Color x:Key="Primary700">#FF6C3D8F</Color>
    <Color x:Key="Primary800">#FF4F3D5C</Color>
    <Color x:Key="Primary900">#FF342C3A</Color>

    <!--<Color x:Key="Primary100">#FFead2fb</Color>
    <Color x:Key="Primary500">#FFAA4DEE</Color>
    <Color x:Key="Primary600">#FF8B33CC</Color>
    <Color x:Key="Primary700">#FF7029A3</Color>-->

    <Color x:Key="Gray50">#FFF9F9FB</Color>
    <Color x:Key="Gray100">#FFF0F1F4</Color>
    <Color x:Key="Gray200">#FFE2E2E9</Color>
    <Color x:Key="Gray300">#FFC5C5D3</Color>
    <Color x:Key="Gray500">#FF67687E</Color>
    <Color x:Key="Gray600">#FF585874</Color>
    <Color x:Key="Gray700">#FF3C3C49</Color>
    <Color x:Key="Gray800">#FF2E2E38</Color>
    <Color x:Key="Gray900">#FF0f1729</Color>

    <Color x:Key="White">#FFFFFFFF</Color>

    <Color x:Key="GitHubBadgeColor">#FF24292E</Color>
    <Color x:Key="NuGetBadgeColor">#FF004880</Color>
    <Color x:Key="HeroIconBackdropColor">#33FFFFFF</Color>

    <!-- *********** BRUSHES *********** -->

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"       Color="{StaticResource Primary600}"/>
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="SamplePageBackground"              Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"         Color="{StaticResource Gray700}"/>

    <SolidColorBrush x:Key="GitHubIconBadgeBrush"  Color="{StaticResource GitHubBadgeColor}"/>
    <SolidColorBrush x:Key="NuGetIconBadgeBrush"   Color="{StaticResource NuGetBadgeColor}"/>
    <SolidColorBrush x:Key="HeroIconBackdropBrush" Color="{StaticResource HeroIconBackdropColor}"/>
    <SolidColorBrush x:Key="HeroIconFillBrush"     Color="{StaticResource White}"/>

    <!-- NavigationView background overrides -->
    <Color x:Key="NavigationViewDefaultPaneBackgroundOverride">#FFFFFFFF</Color>
    <Color x:Key="NavigationViewExpandedPaneBackgroundOverride">#FFF9F9FB</Color>
    <Color x:Key="NavigationViewContentBackgroundOverride">#FFFFFFFF</Color>
    <Color x:Key="NavigationViewHeaderBackgroundOverride">#FFFFFFFF</Color>

    <!-- *********** FONTS *********** -->
    <FontFamily x:Key="AppFontFamily">/Assets/Fonts/DMSans.ttf#DM Sans</FontFamily>

    <!-- *********** TEXT STYLES — BASE *********** -->
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource NavHeaderFontSize}"/>
    </Style>

    <Style x:Key="AppTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource NavHeaderFontSize}"/>
    </Style>

    <Style x:Key="AppSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="AppBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
    </Style>

    <!-- *********** HERO BANNER *********** -->
    <x:Double x:Key="HeroBannerHeight">240</x:Double>
    <CornerRadius x:Key="HeroBannerCornerRadius">13</CornerRadius>

    <!-- Hero icon badge -->
    <x:Double x:Key="HeroIconBadgeSize">64</x:Double>
    <CornerRadius x:Key="HeroIconBadgeCornerRadius">12</CornerRadius>
    <Thickness x:Key="HeroIconBadgePadding">12</Thickness>

    <Style x:Key="HeroTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource White}"/>
    </Style>

    <Style x:Key="HeroSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource White}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- *********** COMPONENT CARDS *********** -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <Thickness x:Key="CardInnerPadding">16</Thickness>
    <Thickness x:Key="CardTitleMargin">0,8,0,2</Thickness>
    <x:Double x:Key="CardTitleFontSize">15</x:Double>
    <x:Double x:Key="LinkCardWidth">200</x:Double>
    <x:Double x:Key="LinkCardHeight">140</x:Double>

    <!-- Icon badge -->
    <x:Double x:Key="IconBadgeSize">56</x:Double>
    <CornerRadius x:Key="IconBadgeCornerRadius">8</CornerRadius>

    <RadialGradientBrush x:Key="IconBadgeBackgroundBrush"
                         Center="0.8171,0.784"
                         GradientOrigin="0.8171,0.784"
                         RadiusX="0.8855"
                         RadiusY="0.9109">
        <GradientStop Color="{StaticResource Primary500}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Primary600}" Offset="0.66"/>
        <GradientStop Color="{StaticResource Primary700}" Offset="1.0"/>
    </RadialGradientBrush>

    <Style x:Key="CardNameTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="CardSubTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- *********** NAVIGATION *********** -->
    <x:Double x:Key="NavHeaderFontSize">18</x:Double>

    <Style x:Key="NavPaneAppNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="NavHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- *********** SAMPLE PAGES *********** -->
    <Thickness x:Key="SampleContentPadding">48</Thickness>
    <x:Double x:Key="SampleContentGridRowSpacing">24</x:Double>

</ResourceDictionary>
