<?xml version="1.0" encoding="utf-8"?>
<!-- Splash drawable referenced by Styles.xml (windowBackground / windowSplashScreenAnimatedIcon).
     Normally generated by Uno.Resizetizer; provided here because the resizetizer's default items
     are disabled (see Colors.xml). A plain layer-list over the splash color is enough for the
     Android head to link and run. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:drawable="@color/uno_splash_color" />
</layer-list>
