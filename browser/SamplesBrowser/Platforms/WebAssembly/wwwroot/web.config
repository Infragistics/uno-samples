<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- The build writes a Brotli (.br) copy next to most files; the rules below serve it. IIS
         compression stays off so a pre-compressed body is never compressed again; nginx compresses
         responses for clients without Brotli and the files that have no copy. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <defaultDocument>
      <files>
        <remove value="index.html" />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Caching, part 1: every file IIS serves gets "Cache-Control: no-cache": browsers and proxies
           may keep it but must revalidate it on every use, and the ETag turns that into a 304 while
           the file is unchanged. Configuration follows the rewritten URL, and this setting is at the
           application root, so it covers the .br copies, the default document and the sample
           deep links (rewritten to index.html) without a <location> per file. It sets only
           cacheControlMode, which overrides the parent site's mode; if the parent site also sets
           cacheControlCustom or setEtag, check what those add. IIS adds the header only when it
           serves a file (200 and 304), not to error pages.
           Files that must stay no-cache because their names do not change when their content does:
             index.html                        references package_<sha1>/
             service-worker.js                 new cache key on every build; must not be held by a proxy
             manifest.webmanifest
             _framework/dotnet.js              not fingerprinted; imported without cache: 'no-cache'
             _framework/blazor.boot.json       names the fingerprinted runtime files
             package_<sha1>/uno-config.js      written after the folder hash is computed
             package_<sha1>/uno-assets.txt     written after the folder hash is computed
             code-viewer/*.json                read by the documentation sites
           Content-addressed files are upgraded to a one-year cache by outbound rules (part 2). -->
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".dll" />
      <remove fileExtension=".wasm" />
      <remove fileExtension=".clr" />
      <remove fileExtension=".pdb" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".dat" />
      <remove fileExtension=".json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".clr" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".pdb" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- Without a type IIS answers 404.3 for the .br copies. The outbound rules restore the
           original file's type. -->
      <remove fileExtension=".br" />
      <mimeMap fileExtension=".br" mimeType="application/octet-stream" />
    </staticContent>
    <rewrite>
      <rules>
        <!-- Serve the pre-compressed copy when the client accepts Brotli and the copy exists. -->
        <rule name="Brotli copy" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:0}.br" />
        </rule>
        <rule name="Sample deep links" stopProcessing="true">
          <match url="^(samples/)?(charts|gauges|grids|inputs|layouts|maps)/[^/]+/[^/]+/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
      <!-- Response headers are set by outbound rules: unlike <serverVariables> in inbound rules, they
           need no allowedServerVariables entry at the server level. {REQUEST_FILENAME} is the file
           actually served, so it ends in .br when the copy was chosen. The caching rules match
           on it rather than on the requested URL, so a response that a rewrite turned into a
           different file (a deep link served from index.html) keeps that file's policy. -->
      <outboundRules>
        <!-- Only a file read from disk is encoded; an error page for a .br path is not. -->
        <rule name="Brotli encoding" preCondition="Brotli copy">
          <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_STATUS}" pattern="^(200|206|304)$" />
          </conditions>
          <action type="Rewrite" value="br" />
        </rule>
        <!-- The encoding depends on Accept-Encoding, and nginx caches responses. -->
        <rule name="Vary by encoding" preCondition="Compressible file">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Accept-Encoding" />
        </rule>
        <!-- The types IIS serves for the uncompressed files. .ttf and .dat copies keep
             application/octet-stream, which is also their uncompressed type. -->
        <rule name="Type wasm" preCondition="Wasm copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/wasm" />
        </rule>
        <rule name="Type js" preCondition="Js copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/javascript" />
        </rule>
        <rule name="Type json" preCondition="Json copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/json" />
        </rule>
        <rule name="Type css" preCondition="Css copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/css" />
        </rule>
        <rule name="Type html" preCondition="Html copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/html" />
        </rule>
        <rule name="Type svg" preCondition="Svg copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="image/svg+xml" />
        </rule>
        <rule name="Type webmanifest" preCondition="Webmanifest copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/manifest+json" />
        </rule>
        <rule name="Type ico" preCondition="Ico copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="image/x-icon" />
        </rule>
        <rule name="Type text" preCondition="Text copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/plain" />
        </rule>
        <!-- Caching, part 2: content-addressed files may be kept for a year without revalidation.
             "public" lets nginx and CloudFront store them too; "immutable" tells browsers that
             support it not to revalidate them on a reload.
             package_<sha1>/: the folder name is a SHA-1 over the contents of the files the Uno
               bootstrapper puts there (its own scripts included), computed before it writes
               uno-config.js and uno-assets.txt into the folder, so those two can change under the
               same name and stay no-cache.
             _framework/: the SDK puts a 10-character fingerprint ([0-9a-z]) before the extension.
               dotnet.js and blazor.boot.json have none and stay no-cache; so does any file a later
               SDK adds without one.
             The status condition is required, not optional: outbound rules also run on the error
             pages IIS sends and their Cache-Control is kept there (on staging, the ungated rule of
             angular-demos puts its one-year immutable header on an IIS 403 page). Without it a 404
             (a file missing in the middle of a deployment) or any other error under these paths
             would be stored for a year. 304 is included: a cache updates the stored headers from
             it, so a 304 saying no-cache would undo the year. -->
        <rule name="Cache package files" preCondition="Hashed package file">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_STATUS}" pattern="^(200|206|304)$" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="Cache framework files" preCondition="Fingerprinted framework file">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_STATUS}" pattern="^(200|206|304)$" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <!-- Errors: IIS adds no clientCache header to them, and this rule asks browsers, nginx and
             CloudFront not to store them, so a 404 from the middle of a deployment is not replayed.
             The error page IIS writes keeps the Cache-Control and Vary that outbound rules set, but
             replaces Content-Type and drops Content-Encoding (both measured on staging). -->
        <rule name="Cache no errors">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_STATUS}" pattern="^[45]\d\d$" />
          </conditions>
          <action type="Rewrite" value="no-store" />
        </rule>
        <preConditions>
          <preCondition name="Brotli copy">
            <add input="{REQUEST_FILENAME}" pattern="\.br$" />
          </preCondition>
          <preCondition name="Compressible file">
            <add input="{REQUEST_FILENAME}" pattern="\.(wasm|m?js|json|css|html|svg|ttf|dat|webmanifest|ico|txt|c)(\.br)?$" />
          </preCondition>
          <preCondition name="Wasm copy">
            <add input="{REQUEST_FILENAME}" pattern="\.wasm\.br$" />
          </preCondition>
          <preCondition name="Js copy">
            <add input="{REQUEST_FILENAME}" pattern="\.m?js\.br$" />
          </preCondition>
          <preCondition name="Json copy">
            <add input="{REQUEST_FILENAME}" pattern="\.json\.br$" />
          </preCondition>
          <preCondition name="Css copy">
            <add input="{REQUEST_FILENAME}" pattern="\.css\.br$" />
          </preCondition>
          <preCondition name="Html copy">
            <add input="{REQUEST_FILENAME}" pattern="\.html\.br$" />
          </preCondition>
          <preCondition name="Svg copy">
            <add input="{REQUEST_FILENAME}" pattern="\.svg\.br$" />
          </preCondition>
          <preCondition name="Webmanifest copy">
            <add input="{REQUEST_FILENAME}" pattern="\.webmanifest\.br$" />
          </preCondition>
          <preCondition name="Ico copy">
            <add input="{REQUEST_FILENAME}" pattern="\.ico\.br$" />
          </preCondition>
          <preCondition name="Text copy">
            <add input="{REQUEST_FILENAME}" pattern="\.(txt|c)\.br$" />
          </preCondition>
          <!-- Case-sensitive: the folder hash is lower-case hex. The second check is not, so the two
               mutable files stay excluded whatever case a client uses. -->
          <preCondition name="Hashed package file" logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" pattern="[\\/]package_[0-9a-f]{40}[\\/]" ignoreCase="false" />
            <add input="{REQUEST_FILENAME}" pattern="[\\/]package_[0-9a-f]{40}[\\/](uno-config\.js|uno-assets\.txt)(\.br|\.gz)?$" negate="true" />
          </preCondition>
          <!-- Case-sensitive so a ten-letter name part such as ".Primitives." is not taken for a
               fingerprint. -->
          <preCondition name="Fingerprinted framework file">
            <add input="{REQUEST_FILENAME}" pattern="[\\/]_framework[\\/][^\\/]+\.[0-9a-z]{10}\.(wasm|js|dat|pdb)(\.br|\.gz)?$" ignoreCase="false" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>
  <location path="code-viewer">
    <system.webServer>
      <!-- Public sample source is also read by Japanese docs on another origin. -->
      <httpProtocol>
        <customHeaders>
          <remove name="Access-Control-Allow-Origin" />
          <add name="Access-Control-Allow-Origin" value="*" />
        </customHeaders>
      </httpProtocol>
      <!-- Same as the application default; kept so the documentation always reads current source. -->
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
