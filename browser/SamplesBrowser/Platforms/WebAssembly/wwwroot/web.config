<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- The build writes a Brotli (.br) copy next to most files and keeps a gzip (.gz) copy only of
         _framework/dotnet.native.*.wasm (DropGzipCopies in SamplesBrowser.csproj); the rules below
         serve them. IIS compression stays off so a pre-compressed body is never compressed again;
         nginx compresses the files that have no copy. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <defaultDocument>
      <files>
        <remove value="index.html" />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".dll" />
      <remove fileExtension=".wasm" />
      <remove fileExtension=".clr" />
      <remove fileExtension=".pdb" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".dat" />
      <remove fileExtension=".json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".clr" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".pdb" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- Without a type IIS answers 404.3 for the .br/.gz copies. The outbound rules restore
           the original file's type. -->
      <remove fileExtension=".br" />
      <remove fileExtension=".gz" />
      <mimeMap fileExtension=".br" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".gz" mimeType="application/octet-stream" />
    </staticContent>
    <rewrite>
      <rules>
        <!-- Serve the pre-compressed copy when the client accepts its encoding and the copy exists. -->
        <rule name="Brotli copy" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:0}.br" />
        </rule>
        <rule name="Gzip copy" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bgzip\b" />
            <add input="{REQUEST_FILENAME}.gz" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:0}.gz" />
        </rule>
        <rule name="Sample deep links" stopProcessing="true">
          <match url="^(samples/)?(charts|gauges|grids|inputs|layouts|maps)/[^/]+/[^/]+/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
      <!-- Response headers are set by outbound rules: unlike <serverVariables> in inbound rules, they
           need no allowedServerVariables entry at the server level. {REQUEST_FILENAME} is the file
           actually served, so it ends in .br or .gz when a copy was chosen. -->
      <outboundRules>
        <rule name="Brotli encoding" preCondition="Brotli copy">
          <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
          <action type="Rewrite" value="br" />
        </rule>
        <!-- Only a file read from disk is encoded; an error page for a .gz path is not. -->
        <rule name="Gzip encoding" preCondition="Gzip copy">
          <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_STATUS}" pattern="^(200|206|304)$" />
          </conditions>
          <action type="Rewrite" value="gzip" />
        </rule>
        <!-- The encoding depends on Accept-Encoding, and nginx caches responses. -->
        <rule name="Vary by encoding" preCondition="Compressible file">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Accept-Encoding" />
        </rule>
        <!-- The types IIS serves for the uncompressed files. .ttf and .dat copies keep
             application/octet-stream, which is also their uncompressed type. -->
        <rule name="Type wasm" preCondition="Wasm copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/wasm" />
        </rule>
        <rule name="Type js" preCondition="Js copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/javascript" />
        </rule>
        <rule name="Type json" preCondition="Json copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/json" />
        </rule>
        <rule name="Type css" preCondition="Css copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/css" />
        </rule>
        <rule name="Type html" preCondition="Html copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/html" />
        </rule>
        <rule name="Type svg" preCondition="Svg copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="image/svg+xml" />
        </rule>
        <rule name="Type webmanifest" preCondition="Webmanifest copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/manifest+json" />
        </rule>
        <rule name="Type ico" preCondition="Ico copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="image/x-icon" />
        </rule>
        <rule name="Type text" preCondition="Text copy">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/plain" />
        </rule>
        <preConditions>
          <preCondition name="Brotli copy">
            <add input="{REQUEST_FILENAME}" pattern="\.br$" />
          </preCondition>
          <preCondition name="Gzip copy">
            <add input="{REQUEST_FILENAME}" pattern="\.gz$" />
          </preCondition>
          <preCondition name="Compressible file">
            <add input="{REQUEST_FILENAME}" pattern="\.(wasm|m?js|json|css|html|svg|ttf|dat|webmanifest|ico|txt|c)(\.br|\.gz)?$" />
          </preCondition>
          <preCondition name="Wasm copy">
            <add input="{REQUEST_FILENAME}" pattern="\.wasm\.(br|gz)$" />
          </preCondition>
          <preCondition name="Js copy">
            <add input="{REQUEST_FILENAME}" pattern="\.m?js\.br$" />
          </preCondition>
          <preCondition name="Json copy">
            <add input="{REQUEST_FILENAME}" pattern="\.json\.br$" />
          </preCondition>
          <preCondition name="Css copy">
            <add input="{REQUEST_FILENAME}" pattern="\.css\.br$" />
          </preCondition>
          <preCondition name="Html copy">
            <add input="{REQUEST_FILENAME}" pattern="\.html\.br$" />
          </preCondition>
          <preCondition name="Svg copy">
            <add input="{REQUEST_FILENAME}" pattern="\.svg\.br$" />
          </preCondition>
          <preCondition name="Webmanifest copy">
            <add input="{REQUEST_FILENAME}" pattern="\.webmanifest\.br$" />
          </preCondition>
          <preCondition name="Ico copy">
            <add input="{REQUEST_FILENAME}" pattern="\.ico\.br$" />
          </preCondition>
          <preCondition name="Text copy">
            <add input="{REQUEST_FILENAME}" pattern="\.(txt|c)\.br$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <!-- Configuration follows the rewritten URL, so index.html served from a copy needs its own entry. -->
  <location path="index.html.br">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="code-viewer">
    <system.webServer>
      <!-- Public sample source is also read by Japanese docs on another origin. -->
      <httpProtocol>
        <customHeaders>
          <remove name="Access-Control-Allow-Origin" />
          <add name="Access-Control-Allow-Origin" value="*" />
        </customHeaders>
      </httpProtocol>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
