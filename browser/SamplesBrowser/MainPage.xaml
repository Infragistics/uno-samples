<Page
    x:Class="SamplesBrowser.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SamplesBrowser">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar drag region -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              IsHitTestVisible="True"
              Background="Transparent"/>

        <NavigationView
              Grid.Row="0"
              Grid.RowSpan="2"
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            Background="Transparent"
            IsPaneOpen="True"
            OpenPaneLength="320"
            SelectionFollowsFocus="Disabled"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource NavigationViewDefaultPaneBackgroundOverride}"/>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource NavigationViewExpandedPaneBackgroundOverride}"/>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource NavigationViewContentBackgroundOverride}"/>
                <SolidColorBrush x:Key="NavigationViewHeaderBackground" Color="{StaticResource NavigationViewHeaderBackgroundOverride}"/>
                <Style x:Key="NavigationViewHeaderContentPresenterStyle" TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="0,16,0,8"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Image Width="24" Height="24" VerticalAlignment="Center">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/icons/app-icon.svg"/>
                        </Image.Source>
                    </Image>
                    <TextBlock
                        Text="IG Uno Platform Samples"
                        Style="{StaticResource NavPaneAppNameTextStyle}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Center"/>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem"
                                    Content="Home"
                                    Tag="home"
                                    Icon="Home"/>
            </NavigationView.MenuItems>

            <!-- Overlay grid: home panel + sample frame stacked -->
            <Grid>

                <!-- ═══ HOME PANEL ═══ -->
                <ScrollViewer x:Name="HomePanel"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Visible">
                    <StackPanel Padding="48,32,48,48" Spacing="32">

                        <!-- ── Hero ── -->

                        <Border CornerRadius="{StaticResource HeroBannerCornerRadius}" Height="{StaticResource HeroBannerHeight}">
                            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <Image Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch">
                                    <Image.Source>
                                        <SvgImageSource UriSource="/Assets/Images/hero-banner.svg"/>
                                    </Image.Source>
                                </Image>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Padding="32,0,0,0" Spacing="18">

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="Infragistics Uno Platform" Style="{StaticResource HeroSubtitleTextStyle}"/>
                                        <TextBlock Text="Uno Platform Samples Browser" Style="{StaticResource HeroTitleTextStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>


                        <!-- ── Browse by component ── -->
                        <StackPanel Spacing="16">
                            <TextBlock Text="Featured Components"
                                       Style="{StaticResource AppSubtitleTextStyle}"
                                       FontSize="18"/>

                            <!-- Component cards: 4 featured components -->
                            <ItemsRepeater x:Name="HomeComponentCards">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="320"
                                                       MinColumnSpacing="16"
                                                       MinRowSpacing="16"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Tag}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Padding="0"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CardCornerRadius}"
                                                Click="HomeComponent_Click">
                                            <Grid Padding="{StaticResource CardInnerPadding}" RowSpacing="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                                                    <Border Width="{StaticResource IconBadgeSize}"
                                                            Height="{StaticResource IconBadgeSize}"
                                                            CornerRadius="{StaticResource IconBadgeCornerRadius}"
                                                            Background="{StaticResource IconBadgeBackgroundBrush}">
                                                        <Image Width="32" Height="32"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                            <Image.Source>
                                                                <SvgImageSource UriSource="{Binding IconUri}"/>
                                                            </Image.Source>
                                                        </Image>
                                                    </Border>
                                                    <StackPanel Orientation="Vertical" Spacing="2" Height="40">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource CardNameTextStyle}"
                                                                   FontSize="{StaticResource CardTitleFontSize}"/>
                                                        <TextBlock Text="{Binding GroupName}"
                                                                   Style="{StaticResource CardSubTextStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Description}"
                                                           Style="{StaticResource CardSubTextStyle}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="3"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ SAMPLE FRAME ═══ -->
                <Frame x:Name="ContentFrame"
                       Visibility="Collapsed"
                       Navigated="ContentFrame_Navigated"/>

            </Grid>

        </NavigationView>
        <Frame x:Name="EmbeddedFrame" Grid.RowSpan="2" Visibility="Collapsed"/>
        <TextBlock x:Name="EmbedError" Grid.RowSpan="2" Visibility="Collapsed"
                   Margin="16" TextWrapping="Wrap"/>
        <Grid x:Name="StartupOverlay" Grid.RowSpan="2" Background="{StaticResource SamplePageBackground}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing x:Name="StartupProgress" IsActive="True" Width="32" Height="32"/>
                <TextBlock Text="Loading components…" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>

</Page>
