<UserControl
    x:Class="SamplesBrowser.Pages.Gauges.RadialGauge.TypeHalf.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamRadialGauge
          Name="gauge"
          TransitionDuration="500"
          MinimumValue="100"
          MaximumValue="200"
          Value="125"
          ScaleStartAngle="180"
          ScaleEndAngle="0"
          ScaleBrush="#00000000"
          ScaleSweepDirection="Clockwise"
          BackingOutline="white"
          BackingBrush="white"
          BackingShape="Fitted"
          NeedleEndExtent="0.8"
          NeedleShape="Triangle"
          NeedlePivotShape="CircleOverlay"
          NeedlePivotWidthRatio="0.1"
          NeedleBrush="#79797a"
          NeedleOutline="#79797a"
          NeedlePivotBrush="#79797a"
          NeedlePivotOutline="#79797a"
          TickBrush="#00000000"
          MinorTickBrush="#00000000"
          LabelInterval="20"
          LabelExtent="0.935"
          RangeBrushes="#32f845 #bf32f8"
          RangeOutlines="#32f845 #bf32f8">
              <igGauges:XamRadialGauge.Ranges>
                  <igGauges:RadialGaugeRange
                  StartValue="100"
                  EndValue="150"
                  InnerStartExtent="0.3"
                  InnerEndExtent="0.3"
                  OuterStartExtent="0.875"
                  OuterEndExtent="0.875">
                  </igGauges:RadialGaugeRange>
                  <igGauges:RadialGaugeRange
                  StartValue="100"
                  EndValue="150"
                  InnerStartExtent="0.3"
                  InnerEndExtent="0.3"
                  OuterStartExtent="0.875"
                  OuterEndExtent="0.875">
                  </igGauges:RadialGaugeRange>
              </igGauges:XamRadialGauge.Ranges>
          </igGauges:XamRadialGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
