<UserControl
    x:Class="SamplesBrowser.Pages.Gauges.RadialGauge.TypeSegmented.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamRadialGauge
          Name="gauge"
          MinimumValue="0"
          MaximumValue="100"
          Value="80"
          Interval="10"
          TransitionDuration="500"
          LabelInterval="10"
          LabelExtent="0.8"
          NeedleShape="None"
          NeedlePivotShape="None"
          ScaleStartAngle="-90"
          ScaleEndAngle="270"
          ScaleBrush="#e0dfdf"
          ScaleOversweepShape="Circular"
          ScaleSweepDirection="Clockwise"
          ScaleEndExtent="0.7"
          ScaleStartExtent="0.6"
          MinorTickCount="4"
          MinorTickStartExtent="0.6"
          MinorTickEndExtent="0.7"
          MinorTickStrokeThickness="2"
          MinorTickBrush="white"
          TickStartExtent="0.6"
          TickEndExtent="0.7"
          TickStrokeThickness="2"
          TickBrush="white"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          BackingShape="Circular">
              <igGauges:XamRadialGauge.Ranges>
                  <igGauges:RadialGaugeRange
                  StartValue="0"
                  EndValue="80"
                  Brush="dodgerblue"
                  Outline="dodgerblue"
                  InnerStartExtent="0.6"
                  InnerEndExtent="0.6"
                  OuterStartExtent="0.7"
                  OuterEndExtent="0.7">
                  </igGauges:RadialGaugeRange>
              </igGauges:XamRadialGauge.Ranges>
          </igGauges:XamRadialGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
