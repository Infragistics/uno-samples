<UserControl
    x:Class="SamplesBrowser.Pages.Gauges.RadialGauge.OpticalScaling.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                <Grid>
          <igLayouts:XamPropertyEditorPanel
          Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=gauge}"
          DescriptionType="RadialGauge"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="OpticalScalingEditor"
                  Label="Optical Scaling"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Boolean"
                  PrimitiveValue="True"
                  Changed="RadialGaugeToggleOpticalScaling">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="GaugeSizeEditor"
                  Label="Resize Gauge"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Slider"
                  PrimitiveValue="100"
                  Min="20"
                  Max="100"
                  Step="10"
                  Changed="RadialGaugeSetSize">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamRadialGauge
          Name="gauge"
          OpticalScalingEnabled="true"
          OpticalScalingSize="500"
          SubtitleText="MPH"
          TitleDisplaysValue="true"
          MinimumValue="0"
          MaximumValue="80"
          Value="50"
          Interval="10">
          </igGauges:XamRadialGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
