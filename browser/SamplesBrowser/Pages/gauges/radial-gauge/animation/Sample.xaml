<UserControl
    x:Class="SamplesBrowser.Pages.Gauges.RadialGauge.Animation.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                <Grid>
          <igLayouts:XamPropertyEditorPanel
          Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=gauge}"
          DescriptionType="RadialGauge"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="AnimateToGauge1Button"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Gauge Animation #1"
                  ButtonClicked="RadialGaugeAnimateToGauge1">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="AnimateToGauge2Button"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Gauge Animation #2"
                  ButtonClicked="RadialGaugeAnimateToGauge2">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="AnimateToGauge3Button"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Gauge Animation #3"
                  ButtonClicked="RadialGaugeAnimateToGauge3">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="AnimateToGauge4Button"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Gauge Animation #4"
                  ButtonClicked="RadialGaugeAnimateToGauge4">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamRadialGauge
          Name="gauge"
          TransitionDuration="1000"
          MinimumValue="0"
          MaximumValue="50"
          Value="25"
          Interval="5"
          LabelInterval="5"
          LabelExtent="0.71"
          IsNeedleDraggingEnabled="true"
          NeedleEndExtent="0.5"
          NeedleShape="Triangle"
          NeedleEndWidthRatio="0.03"
          NeedleStartWidthRatio="0.05"
          NeedlePivotShape="CircleOverlay"
          NeedlePivotWidthRatio="0.15"
          NeedleBaseFeatureWidthRatio="0.15"
          NeedleBrush="#79797a"
          NeedleOutline="#79797a"
          NeedlePivotBrush="#79797a"
          NeedlePivotOutline="#79797a"
          MinorTickCount="4"
          MinorTickStartExtent="0.6"
          MinorTickEndExtent="0.625"
          MinorTickStrokeThickness="1"
          MinorTickBrush="#79797a"
          TickStartExtent="0.6"
          TickEndExtent="0.65"
          TickStrokeThickness="2"
          TickBrush="#79797a"
          ScaleStartAngle="120"
          ScaleEndAngle="60"
          ScaleBrush="#d6d6d6"
          ScaleOversweepShape="Fitted"
          ScaleSweepDirection="Clockwise"
          ScaleEndExtent="0.57"
          ScaleStartExtent="0.5"
          BackingShape="Circular"
          BackingBrush="#fcfcfc"
          BackingOutline="#d6d6d6"
          BackingStrokeThickness="5"
          RangeBrushes="#f86232 #dc3f76 #7446b9"
          RangeOutlines="#f86232 #dc3f76 #7446b9">
              <igGauges:XamRadialGauge.Ranges>
                  <igGauges:RadialGaugeRange
                  StartValue="5"
                  EndValue="15"
                  InnerStartExtent="0.5"
                  InnerEndExtent="0.5"
                  OuterStartExtent="0.57"
                  OuterEndExtent="0.57">
                  </igGauges:RadialGaugeRange>
                  <igGauges:RadialGaugeRange
                  StartValue="15"
                  EndValue="35"
                  InnerStartExtent="0.5"
                  InnerEndExtent="0.5"
                  OuterStartExtent="0.57"
                  OuterEndExtent="0.57">
                  </igGauges:RadialGaugeRange>
                  <igGauges:RadialGaugeRange
                  StartValue="35"
                  EndValue="45"
                  InnerStartExtent="0.5"
                  InnerEndExtent="0.5"
                  OuterStartExtent="0.57"
                  OuterEndExtent="0.57">
                  </igGauges:RadialGaugeRange>
              </igGauges:XamRadialGauge.Ranges>
          </igGauges:XamRadialGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
