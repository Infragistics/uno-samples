<UserControl
    x:Class="SamplesBrowser.Pages.Gauges.RadialGauge.Ranges.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamRadialGauge
          Name="gauge"
          MinimumValue="0"
          Value="80"
          MaximumValue="80"
          Interval="10"
          RangeBrushes="#a4bd29 #f86232"
          RangeOutlines="#a4bd29 #f86232">
              <igGauges:XamRadialGauge.Ranges>
                  <igGauges:RadialGaugeRange
                  StartValue="10"
                  EndValue="25"
                  InnerStartExtent="0.5"
                  InnerEndExtent="0.5"
                  OuterStartExtent="0.57"
                  OuterEndExtent="0.57">
                  </igGauges:RadialGaugeRange>
                  <igGauges:RadialGaugeRange
                  StartValue="25"
                  EndValue="40"
                  InnerStartExtent="0.5"
                  InnerEndExtent="0.5"
                  OuterStartExtent="0.57"
                  OuterEndExtent="0.57">
                  </igGauges:RadialGaugeRange>
              </igGauges:XamRadialGauge.Ranges>
          </igGauges:XamRadialGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
