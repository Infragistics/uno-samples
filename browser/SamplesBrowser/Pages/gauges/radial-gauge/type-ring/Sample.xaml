<UserControl
    x:Class="SamplesBrowser.Pages.Gauges.RadialGauge.TypeRing.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamRadialGauge
          Name="gauge"
          MinimumValue="0"
          MaximumValue="120"
          Interval="10"
          TransitionDuration="500"
          LabelInterval="10"
          LabelExtent="0.85"
          NeedleShape="None"
          NeedlePivotShape="None"
          ScaleStartAngle="0"
          ScaleEndAngle="360"
          ScaleBrush="#00000000"
          ScaleOversweepShape="Circular"
          ScaleSweepDirection="Clockwise"
          ScaleEndExtent="0.725"
          ScaleStartExtent="0.6"
          MinorTickCount="4"
          MinorTickStartExtent="0.725"
          MinorTickEndExtent="0.7375"
          MinorTickBrush="#00000000"
          TickStartExtent="0.725"
          TickEndExtent="0.75"
          TickStrokeThickness="1"
          TickBrush="#79797a"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          BackingShape="Circular">
              <igGauges:XamRadialGauge.Ranges>
                  <igGauges:RadialGaugeRange
                  Brush="#e0dfdf"
                  Outline="#e0dfdf"
                  StartValue="0"
                  EndValue="120"
                  InnerStartExtent="0.635"
                  InnerEndExtent="0.635"
                  OuterStartExtent="0.725"
                  OuterEndExtent="0.725">
                  </igGauges:RadialGaugeRange>
                  <igGauges:RadialGaugeRange
                  Brush="#10b401"
                  Outline="#10b401"
                  StartValue="0"
                  EndValue="90"
                  InnerStartExtent="0.635"
                  InnerEndExtent="0.635"
                  OuterStartExtent="0.725"
                  OuterEndExtent="0.725">
                  </igGauges:RadialGaugeRange>
                  <igGauges:RadialGaugeRange
                  Brush="#e0dfdf"
                  Outline="#e0dfdf"
                  StartValue="0"
                  EndValue="120"
                  InnerStartExtent="0.535"
                  InnerEndExtent="0.535"
                  OuterStartExtent="0.625"
                  OuterEndExtent="0.625">
                  </igGauges:RadialGaugeRange>
                  <igGauges:RadialGaugeRange
                  Brush="#fdb417"
                  Outline="#fdb417"
                  StartValue="0"
                  EndValue="80"
                  InnerStartExtent="0.535"
                  InnerEndExtent="0.535"
                  OuterStartExtent="0.625"
                  OuterEndExtent="0.625">
                  </igGauges:RadialGaugeRange>
                  <igGauges:RadialGaugeRange
                  Brush="#e0dfdf"
                  Outline="#e0dfdf"
                  StartValue="0"
                  EndValue="120"
                  InnerStartExtent="0.435"
                  InnerEndExtent="0.435"
                  OuterStartExtent="0.525"
                  OuterEndExtent="0.525">
                  </igGauges:RadialGaugeRange>
                  <igGauges:RadialGaugeRange
                  Brush="red"
                  Outline="red"
                  StartValue="0"
                  EndValue="60"
                  InnerStartExtent="0.435"
                  InnerEndExtent="0.435"
                  OuterStartExtent="0.525"
                  OuterEndExtent="0.525">
                  </igGauges:RadialGaugeRange>
              </igGauges:XamRadialGauge.Ranges>
          </igGauges:XamRadialGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
