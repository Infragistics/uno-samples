<UserControl
    x:Class="SamplesBrowser.Pages.Gauges.LinearGauge.TypeSegmented.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                <Grid>
          <igGauges:XamLinearGauge
          Name="gauge1"
          Height="120px"
          Value="80"
          MinimumValue="0"
          MaximumValue="100"
          Interval="10"
          TransitionDuration="500"
          LabelInterval="10"
          LabelExtent="0.15"
          ScaleStrokeThickness="0"
          ScaleBrush="#e0dfdf"
          ScaleOutline="#e0dfdf"
          ScaleInnerExtent="0.25"
          ScaleOuterExtent="0.65"
          ScaleStartExtent="0.05"
          ScaleEndExtent="0.95"
          TickBrush="white"
          TickStrokeThickness="2"
          TickStartExtent="0.25"
          TickEndExtent="0.65"
          MinorTickBrush="white"
          MinorTickStrokeThickness="2"
          MinorTickCount="4"
          MinorTickStartExtent="0.25"
          MinorTickEndExtent="0.65"
          IsNeedleDraggingEnabled="false"
          NeedleBrush="#00000000"
          NeedleOutline="#00000000"
          BackingBrush="#00000000"
          BackingOutline="#00000000">
              <igGauges:XamLinearGauge.Ranges>
                  <igGauges:LinearGraphRange
                  Brush="green"
                  Outline="green"
                  StartValue="0"
                  EndValue="80"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.65"
                  OuterEndExtent="0.65">
                  </igGauges:LinearGraphRange>
              </igGauges:XamLinearGauge.Ranges>
          </igGauges:XamLinearGauge>
        </Grid>
                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamLinearGauge
          Name="gauge2"
          Height="120px"
          Value="50"
          MinimumValue="0"
          MaximumValue="100"
          Interval="10"
          TransitionDuration="500"
          LabelInterval="10"
          LabelExtent="0.15"
          ScaleStrokeThickness="0"
          ScaleBrush="#e0dfdf"
          ScaleOutline="#e0dfdf"
          ScaleInnerExtent="0.25"
          ScaleOuterExtent="0.65"
          ScaleStartExtent="0.05"
          ScaleEndExtent="0.95"
          TickBrush="white"
          TickStrokeThickness="2"
          TickStartExtent="0.25"
          TickEndExtent="0.65"
          MinorTickBrush="white"
          MinorTickStrokeThickness="2"
          MinorTickCount="4"
          MinorTickStartExtent="0.25"
          MinorTickEndExtent="0.65"
          IsNeedleDraggingEnabled="false"
          NeedleBrush="#00000000"
          NeedleOutline="#00000000"
          BackingBrush="#00000000"
          BackingOutline="#00000000">
              <igGauges:XamLinearGauge.Ranges>
                  <igGauges:LinearGraphRange
                  Brush="orange"
                  Outline="orange"
                  StartValue="0"
                  EndValue="50"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.65"
                  OuterEndExtent="0.65">
                  </igGauges:LinearGraphRange>
              </igGauges:XamLinearGauge.Ranges>
          </igGauges:XamLinearGauge>
        </Grid>
              </Grid>
            <Grid Grid.Row="2">
        <igGauges:XamLinearGauge
        Name="gauge3"
        Height="120px"
        Value="30"
        MinimumValue="0"
        MaximumValue="100"
        Interval="10"
        TransitionDuration="500"
        LabelInterval="10"
        LabelExtent="0.15"
        ScaleStrokeThickness="0"
        ScaleBrush="#e0dfdf"
        ScaleOutline="#e0dfdf"
        ScaleInnerExtent="0.25"
        ScaleOuterExtent="0.65"
        ScaleStartExtent="0.05"
        ScaleEndExtent="0.95"
        TickBrush="white"
        TickStrokeThickness="2"
        TickStartExtent="0.25"
        TickEndExtent="0.65"
        MinorTickBrush="white"
        MinorTickStrokeThickness="2"
        MinorTickCount="4"
        MinorTickStartExtent="0.25"
        MinorTickEndExtent="0.65"
        IsNeedleDraggingEnabled="false"
        NeedleBrush="#00000000"
        NeedleOutline="#00000000"
        BackingBrush="#00000000"
        BackingOutline="#00000000">
            <igGauges:XamLinearGauge.Ranges>
                <igGauges:LinearGraphRange
                Brush="red"
                Outline="red"
                StartValue="0"
                EndValue="30"
                InnerStartExtent="0.25"
                InnerEndExtent="0.25"
                OuterStartExtent="0.65"
                OuterEndExtent="0.65">
                </igGauges:LinearGraphRange>
            </igGauges:XamLinearGauge.Ranges>
        </igGauges:XamLinearGauge>
      </Grid>
          </Grid>
</UserControl>
