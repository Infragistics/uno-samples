<UserControl
    x:Class="SamplesBrowser.Pages.Gauges.LinearGauge.Animation.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                <Grid>
          <igLayouts:XamPropertyEditorPanel
          Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=gauge}"
          DescriptionType="LinearGauge"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="AnimateToGauge1Button"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Gauge Animation #1"
                  ButtonClicked="LinearGaugeAnimateToGauge1">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="AnimateToGauge2Button"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Gauge Animation #2"
                  ButtonClicked="LinearGaugeAnimateToGauge2">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  Name="AnimateToGauge3Button"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Button"
                  PrimitiveValue="Gauge Animation #3"
                  ButtonClicked="LinearGaugeAnimateToGauge3">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igGauges:XamLinearGauge
          Name="gauge"
          Height="80px"
          TransitionDuration="1000"
          MinimumValue="0"
          MaximumValue="100"
          Value="50"
          Interval="10"
          LabelInterval="10"
          LabelExtent="0"
          IsNeedleDraggingEnabled="true"
          NeedleShape="Needle"
          NeedleBrush="#79797a"
          NeedleOutline="white"
          NeedleStrokeThickness="1"
          NeedleOuterExtent="0.9"
          NeedleInnerExtent="0.3"
          MinorTickCount="5"
          MinorTickEndExtent="0.1"
          MinorTickStartExtent="0.2"
          MinorTickStrokeThickness="1"
          TickStartExtent="0.25"
          TickEndExtent="0.05"
          TickStrokeThickness="2"
          ScaleStrokeThickness="0"
          ScaleBrush="white"
          ScaleOutline="#dbdbdb"
          ScaleInnerExtent="0.075"
          ScaleOuterExtent="0.85"
          ScaleStartExtent="0.05"
          ScaleEndExtent="0.95"
          BackingBrush="white"
          BackingOutline="#d1d1d1"
          BackingStrokeThickness="0">
              <igGauges:XamLinearGauge.Ranges>
                  <igGauges:LinearGraphRange
                  Brush="#9fb328"
                  Outline="#9fb328"
                  StartValue="0"
                  EndValue="30"
                  InnerStartExtent="0.075"
                  InnerEndExtent="0.075"
                  OuterStartExtent="0.95"
                  OuterEndExtent="0.95">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#438c47"
                  Outline="#438c47"
                  StartValue="30"
                  EndValue="70"
                  InnerStartExtent="0.075"
                  InnerEndExtent="0.075"
                  OuterStartExtent="0.95"
                  OuterEndExtent="0.95">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#3f51b5"
                  Outline="#3f51b5"
                  StartValue="70"
                  EndValue="100"
                  InnerStartExtent="0.075"
                  InnerEndExtent="0.075"
                  OuterStartExtent="0.95"
                  OuterEndExtent="0.95">
                  </igGauges:LinearGraphRange>
              </igGauges:XamLinearGauge.Ranges>
          </igGauges:XamLinearGauge>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
