<UserControl
    x:Class="SamplesBrowser.Pages.Gauges.LinearGauge.Labels.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Gauges.LinearGauge.Labels"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igGauges="using:Infragistics.Controls.Gauges"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igGauges:XamLinearGauge
          x:Name="gauge"
          Height="80px"
          Width="400px"
          MinimumValue="0"
          Value="50"
          MaximumValue="100"
          Interval="10"
          LabelInterval="10"
          LabelExtent="0.025"
          LabelsPreTerminal="0"
          LabelsPostInitial="0"
          FontBrush="dodgerblue"
          FontFamily="Verdana"
          FontSize="11">
          </igGauges:XamLinearGauge>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
