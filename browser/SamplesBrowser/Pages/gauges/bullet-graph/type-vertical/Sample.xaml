<UserControl
    x:Class="SamplesBrowser.Pages.Gauges.BulletGraph.TypeVertical.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                    xmlns:igGauges="using:Infragistics.Controls.Gauges"
                    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
          <igGauges:XamBulletGraph
          Name="graph1"
          Width="120px"
          Orientation="Vertical"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          TransitionDuration="500"
          MinorTickCount="4"
          Value="90"
          TargetValue="80"
          MinimumValue="0"
          MaximumValue="100"
          Interval="5"
          LabelInterval="5"
          LabelExtent="0">
              <igGauges:XamBulletGraph.Ranges>
                  <igGauges:LinearGraphRange
                  Brush="green"
                  Outline="green"
                  StartValue="0"
                  EndValue="25"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#10b401"
                  Outline="#10b401"
                  StartValue="25"
                  EndValue="50"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#45ec03"
                  Outline="#45ec03"
                  StartValue="50"
                  EndValue="75"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#2efa2e"
                  Outline="#2efa2e"
                  StartValue="75"
                  EndValue="100"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
              </igGauges:XamBulletGraph.Ranges>
          </igGauges:XamBulletGraph>
        </Grid>
                <Grid Grid.Column="1">
          <igGauges:XamBulletGraph
          Name="graph2"
          Width="120px"
          Orientation="Vertical"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          TransitionDuration="500"
          MinorTickCount="4"
          Value="70"
          TargetValue="80"
          MinimumValue="0"
          MaximumValue="100"
          Interval="5"
          LabelInterval="5"
          LabelExtent="0">
              <igGauges:XamBulletGraph.Ranges>
                  <igGauges:LinearGraphRange
                  Brush="#e29b03"
                  Outline="#e29b03"
                  StartValue="0"
                  EndValue="25"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#fdb417"
                  Outline="#fdb417"
                  StartValue="25"
                  EndValue="50"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#fdc957"
                  Outline="#fdc957"
                  StartValue="50"
                  EndValue="75"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#fdd682"
                  Outline="#fdd682"
                  StartValue="75"
                  EndValue="100"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
              </igGauges:XamBulletGraph.Ranges>
          </igGauges:XamBulletGraph>
        </Grid>
                <Grid Grid.Column="2">
          <igGauges:XamBulletGraph
          Name="graph3"
          Width="120px"
          Orientation="Vertical"
          BackingBrush="#00000000"
          BackingOutline="#00000000"
          TransitionDuration="500"
          MinorTickCount="4"
          Value="40"
          TargetValue="80"
          MinimumValue="0"
          MaximumValue="100"
          Interval="5"
          LabelInterval="5"
          LabelExtent="0">
              <igGauges:XamBulletGraph.Ranges>
                  <igGauges:LinearGraphRange
                  Brush="#cf0000"
                  Outline="#cf0000"
                  StartValue="0"
                  EndValue="25"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="red"
                  Outline="red"
                  StartValue="25"
                  EndValue="50"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#fd3939"
                  Outline="#fd3939"
                  StartValue="50"
                  EndValue="75"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
                  <igGauges:LinearGraphRange
                  Brush="#fa6363"
                  Outline="#fa6363"
                  StartValue="75"
                  EndValue="100"
                  InnerStartExtent="0.25"
                  InnerEndExtent="0.25"
                  OuterStartExtent="0.8"
                  OuterEndExtent="0.8">
                  </igGauges:LinearGraphRange>
              </igGauges:XamBulletGraph.Ranges>
          </igGauges:XamBulletGraph>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
