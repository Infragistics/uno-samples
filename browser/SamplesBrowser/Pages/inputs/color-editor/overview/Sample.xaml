<UserControl
    x:Class="SamplesBrowser.Pages.Inputs.ColorEditor.Overview.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Inputs.ColorEditor.Overview"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igInputs="using:Infragistics.Controls.Inputs"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igInputs:XamColorEditor
          x:Name="colorEditor"
          Width="200px"
          Height="40px"
          ValueChanged="ColorEditorValueChanged">
          </igInputs:XamColorEditor>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
