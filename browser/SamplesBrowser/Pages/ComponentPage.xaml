<Page
    x:Class="SamplesBrowser.Pages.ComponentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="48,20,32,40" Spacing="24">

            <Border CornerRadius="{StaticResource HeroBannerCornerRadius}" Height="{StaticResource HeroBannerHeight}">
                <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Image Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch">
                        <Image.Source>
                            <SvgImageSource UriSource="/Assets/Images/hero-banner.svg"/>
                        </Image.Source>
                    </Image>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Padding="32,0,0,0" Spacing="16">
                        <Border Width="{StaticResource HeroIconBadgeSize}"
                                Height="{StaticResource HeroIconBadgeSize}"
                                CornerRadius="{StaticResource HeroIconBadgeCornerRadius}"
                                Background="{StaticResource HeroIconBackdropBrush}"
                                x:Name="HeroIconBadge"
                                Padding="{StaticResource HeroIconBadgePadding}">
                            <Image x:Name="HeroIconImage"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="HeroTitle" Style="{StaticResource HeroTitleTextStyle}"/>
                            <TextBlock x:Name="HeroSubtitle" Style="{StaticResource HeroSubtitleTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsRepeater x:Name="SampleCards">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="300" MinColumnSpacing="12" MinRowSpacing="12"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding Route}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Click="SampleCard_Click">
                            <Grid Padding="16,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                                        Background="{ThemeResource IconBadgeBackgroundBrush}">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="18" Foreground="White"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardNameTextStyle}"/>
                                    <TextBlock Text="{Binding ComponentName}" Style="{StaticResource CardSubTextStyle}"/>
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                          Opacity="0.5" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>
