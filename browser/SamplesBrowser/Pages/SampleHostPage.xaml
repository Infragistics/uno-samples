<Page
    x:Class="SamplesBrowser.Pages.SampleHostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SamplePageBackground}">
    <Grid>
        <Border x:Name="SampleBorder" Padding="{StaticResource SampleContentPadding}">
            <ContentPresenter x:Name="SampleContent"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Border>
        <Grid x:Name="SourceContainer" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="SourceStatus" Margin="16" TextWrapping="Wrap" Visibility="Collapsed"/>
            <Grid x:Name="SourceViewHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Page>
