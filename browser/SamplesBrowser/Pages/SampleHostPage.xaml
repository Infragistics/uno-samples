<Page
    x:Class="SamplesBrowser.Pages.SampleHostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SamplePageBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="ViewSelector" Orientation="Horizontal" Spacing="8" Margin="16,8">
            <ToggleButton x:Name="SampleButton" Content="Sample" IsChecked="True" Click="ShowSample_Click"/>
            <ToggleButton x:Name="SourceButton" Content="Source" Click="ShowSource_Click"/>
        </StackPanel>
        <Border x:Name="SampleBorder" Grid.Row="1" Padding="{StaticResource SampleContentPadding}">
            <ContentPresenter x:Name="SampleContent"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Border>
        <Grid x:Name="SourceContainer" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="SourceStatus" Margin="16" TextWrapping="Wrap" Visibility="Collapsed"/>
            <Grid x:Name="SourceViewHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Page>
