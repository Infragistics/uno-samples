<UserControl
    x:Class="SamplesBrowser.Pages.Maps.GeoMap.TypeScatterSymbolSeries.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
            xmlns:igMaps="using:Infragistics.Controls.Maps"
                            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igMaps:XamGeographicMap
          Name="map"
          Zoomable="true">
              <igMaps:XamGeographicMap.Series>
                  <igMaps:GeographicSymbolSeries
                  Name="CitiesSeries"
                  ItemsSource="{Binding WorldCities}"
                  MarkerType="Circle"
                  LatitudeMemberPath="Y"
                  LongitudeMemberPath="X"
                  MarkerBrush="white"
                  MarkerOutline="gray">
                  </igMaps:GeographicSymbolSeries>
                  <igMaps:GeographicSymbolSeries
                  Name="CapitalsSeries"
                  ItemsSource="{Binding WorldCapitals}"
                  MarkerType="Circle"
                  LatitudeMemberPath="Y"
                  LongitudeMemberPath="X"
                  MarkerBrush="white"
                  MarkerOutline="#2092fc">
                  </igMaps:GeographicSymbolSeries>
              </igMaps:XamGeographicMap.Series>
          </igMaps:XamGeographicMap>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
