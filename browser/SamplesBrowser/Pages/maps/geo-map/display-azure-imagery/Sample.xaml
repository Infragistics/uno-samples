<UserControl
    x:Class="SamplesBrowser.Pages.Maps.GeoMap.DisplayAzureImagery.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Maps.GeoMap.DisplayAzureImagery"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igMaps="using:Infragistics.Controls.Maps"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=map}"
          DescriptionType="GeographicMap"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          x:Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="AzureApiKey"
                  Label="Azure Maps API Key"
                  ValueType="StringValue"
                  PrimitiveValue=""
                  Changed="EditorChangeAzureImageryApiKey"
                  x:Name="propertyEditorPropertyDescription1">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="AzureApiKeySet"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Set Key"
                  ButtonClicked="EditorButtonAzureImagerySetApiKey"
                  x:Name="propertyEditorPropertyDescription2">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ImageryStyleRoad"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Road"
                  ButtonClicked="EditorButtonAzureImageryRoad"
                  x:Name="propertyEditorPropertyDescription3">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ImageryStyleSatellite"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Satellite"
                  ButtonClicked="EditorButtonAzureImagerySatellite"
                  x:Name="propertyEditorPropertyDescription4">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ImageryStyleDarkGrey"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="DarkGrey"
                  ButtonClicked="EditorButtonAzureImageryDarkGrey"
                  x:Name="propertyEditorPropertyDescription5">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igMaps:XamGeographicMap
          x:Name="map"
          Zoomable="true">
              <igMaps:XamGeographicMap.BackgroundContent>
                  <igMaps:AzureMapsImagery
                  x:Name="azureImagery"
                  ApiKey="REPLACE_WITH_AZURE_KEY"
                  ImageryStyle="Satellite">
                  </igMaps:AzureMapsImagery>
              </igMaps:XamGeographicMap.BackgroundContent>
          </igMaps:XamGeographicMap>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
