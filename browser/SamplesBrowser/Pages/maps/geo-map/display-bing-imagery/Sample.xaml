<UserControl
    x:Class="SamplesBrowser.Pages.Maps.GeoMap.DisplayBingImagery.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Maps.GeoMap.DisplayBingImagery"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igMaps="using:Infragistics.Controls.Maps"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igMaps:XamGeographicMap
          x:Name="aerialMap"
          Zoomable="true">
              <igMaps:XamGeographicMap.BackgroundContent>
                  <igMaps:BingMapsMapImagery
                  x:Name="aerialImagery"
                  ApiKey="REPLACE_WITH_BING_KEY"
                  ImageryStyle="AerialWithLabels">
                  </igMaps:BingMapsMapImagery>
              </igMaps:XamGeographicMap.BackgroundContent>
          </igMaps:XamGeographicMap>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igMaps:XamGeographicMap
          x:Name="roadMap"
          Zoomable="true">
              <igMaps:XamGeographicMap.BackgroundContent>
                  <igMaps:BingMapsMapImagery
                  x:Name="roadImagery"
                  ApiKey="REPLACE_WITH_BING_KEY"
                  ImageryStyle="Road">
                  </igMaps:BingMapsMapImagery>
              </igMaps:XamGeographicMap.BackgroundContent>
          </igMaps:XamGeographicMap>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
