<UserControl
    x:Class="SamplesBrowser.Pages.Maps.GeoMap.BindingMultipleShapes.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
            xmlns:igMaps="using:Infragistics.Controls.Maps"
                            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igMaps:XamGeographicMap
          Name="map"
          
          
          Zoomable="true">
              <igMaps:XamGeographicMap.Series>
                  <igMaps:GeographicShapeSeries
                  Name="AsiaShape"
                  Outline="black"
                  Thickness="1"
                  Brush="#d10700">
                      <igMaps:GeographicShapeSeries.ShapefileDataSource>
                          <ig:ShapeDataSource
                          ShapefileSource="https://static.infragistics.com/xplatform/shapes/world_region_asia.shp"
                          DatabaseSource="https://static.infragistics.com/xplatform/shapes/world_region_asia.dbf">
                          </ig:ShapeDataSource>
                      </igMaps:GeographicShapeSeries.ShapefileDataSource>
                  </igMaps:GeographicShapeSeries>
                  <igMaps:GeographicShapeSeries
                  Name="EuropeShape"
                  Outline="black"
                  Thickness="1"
                  Brush="#04b530">
                            <igMaps:GeographicShapeSeries.ShapefileDataSource>
                          <ig:ShapeDataSource
                          ShapefileSource="https://static.infragistics.com/xplatform/shapes/world_region_europe.shp"
                          DatabaseSource="https://static.infragistics.com/xplatform/shapes/world_region_europe.dbf">
                          </ig:ShapeDataSource>
                      </igMaps:GeographicShapeSeries.ShapefileDataSource>
                  </igMaps:GeographicShapeSeries>
                  <igMaps:GeographicShapeSeries
                  Name="AmericanShape"
                  Outline="black"
                  Thickness="1"
                  Brush="#0073d1">
                            <igMaps:GeographicShapeSeries.ShapefileDataSource>
                          <ig:ShapeDataSource
                          ShapefileSource="https://static.infragistics.com/xplatform/shapes/world_region_north_america.shp"
                          DatabaseSource="https://static.infragistics.com/xplatform/shapes/world_region_north_america.dbf">
                          </ig:ShapeDataSource>
                      </igMaps:GeographicShapeSeries.ShapefileDataSource>
                  </igMaps:GeographicShapeSeries>
              </igMaps:XamGeographicMap.Series>
          </igMaps:XamGeographicMap>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
