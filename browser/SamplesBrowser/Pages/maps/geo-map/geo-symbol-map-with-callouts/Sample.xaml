<UserControl
    x:Class="SamplesBrowser.Pages.Maps.GeoMap.GeoSymbolMapWithCallouts.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
            xmlns:igMaps="using:Infragistics.Controls.Maps"
                            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:Legend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igMaps:XamGeographicMap
          Name="GeoMap"
          Zoomable="true"
          Legend="{Binding ElementName=legend}">
              <igMaps:XamGeographicMap.Series>
                  <igMaps:GeographicSymbolSeries
                  Name="GeographicSymbolSeries1"
                  Title="World Capitals Above 2 Million People"
                  LatitudeMemberPath="Y"
                  LongitudeMemberPath="X"
                  ItemsSource="{Binding WorldCapitals2M}"
                  MarkerType="Circle"
                  MarkerBrush="dodgerblue"
                  MarkerOutline="dodgerblue"
                  ShowDefaultTooltip="true">
                  </igMaps:GeographicSymbolSeries>
                  <igCharts:CalloutLayer
                  Name="CalloutLayer1"
                  ItemsSource="{Binding WorldCapitals2M}"
                  XMemberPath="X"
                  YMemberPath="Y"
                  LabelMemberPath="Name"
                  CalloutCollisionMode="SimulatedAnnealing"
                  CalloutLeaderBrush="dodgerblue"
                  CalloutOutline="dodgerblue"
                  CalloutBackground="white"
                  CalloutTextColor="black"
                  CalloutStrokeThickness="2">
                  </igCharts:CalloutLayer>
              </igMaps:XamGeographicMap.Series>
          </igMaps:XamGeographicMap>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
