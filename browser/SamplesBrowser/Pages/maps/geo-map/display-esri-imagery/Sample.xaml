<UserControl
    x:Class="SamplesBrowser.Pages.Maps.GeoMap.DisplayEsriImagery.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Maps.GeoMap.DisplayEsriImagery"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igMaps="using:Infragistics.Controls.Maps"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <igMaps:XamGeographicMap
          x:Name="streetMap"
          Zoomable="true">
              <igMaps:XamGeographicMap.BackgroundContent>
                  <igMaps:ArcGISOnlineMapImagery
                  x:Name="streetMapImagery"
                  MapServerUri="https://services.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer">
                  </igMaps:ArcGISOnlineMapImagery>
              </igMaps:XamGeographicMap.BackgroundContent>
          </igMaps:XamGeographicMap>
        </Grid>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igMaps:XamGeographicMap
          x:Name="oceansMap"
          Zoomable="true">
              <igMaps:XamGeographicMap.BackgroundContent>
                  <igMaps:ArcGISOnlineMapImagery
                  x:Name="oceansMapImagery"
                  MapServerUri="https://services.arcgisonline.com/arcgis/rest/services/Ocean/World_Ocean_Base/MapServer">
                  </igMaps:ArcGISOnlineMapImagery>
              </igMaps:XamGeographicMap.BackgroundContent>
          </igMaps:XamGeographicMap>
        </Grid>
        <Grid Grid.Column="2">
          <igMaps:XamGeographicMap
          x:Name="topographicMap"
          Zoomable="true">
              <igMaps:XamGeographicMap.BackgroundContent>
                  <igMaps:ArcGISOnlineMapImagery
                  x:Name="topographicMapImagery"
                  MapServerUri="https://services.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer">
                  </igMaps:ArcGISOnlineMapImagery>
              </igMaps:XamGeographicMap.BackgroundContent>
          </igMaps:XamGeographicMap>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
