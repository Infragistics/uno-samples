<UserControl
    x:Class="SamplesBrowser.Pages.Grids.DataGrid.ColumnSorting.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Grids.DataGrid.ColumnSorting"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          x:Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=grid}"
          DescriptionType="DataGrid"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="HeaderClickAction"
                  x:Name="HeaderClickActionEditor"
                  Label="Header Click Action"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="SortByMultipleColumnsTriState">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding RealEstateData}"
          DefaultColumnMinWidth="100"
          IsColumnOptionsEnabled="true"
          HeaderClickAction="SortByMultipleColumnsTriState">
              <igDataGrids:XamDataGrid.SortDescriptions>
                  <igDataGrids:ColumnSortDescription
                  Field="Property"
                  SortDirection="Descending">
                  </igDataGrids:ColumnSortDescription>
              </igDataGrids:XamDataGrid.SortDescriptions>
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="ID"
                  Width="*>110"
                  HorizontalAlignment="Center">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Property"
                  HeaderText="Property"
                  Width="*>150">
                  </igDataGrids:TextColumn>
                  <igDataGrids:ImageColumn
                  Field="CountryFlag"
                  HeaderText="Country"
                  Width="*>160"
                  IsEditable="false"
                  ContentOpacity="1"
                  HorizontalAlignment="Center"
                  PaddingTop="5"
                  PaddingBottom="5">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TextColumn
                  Field="City"
                  Width="*>150">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Price"
                  Width="*>130"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Rooms"
                  Width="*>110">
                  </igDataGrids:NumericColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
