<UserControl
    x:Class="SamplesBrowser.Pages.Grids.DataGrid.RowGroupDescriptions.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                xmlns:igDataGrids="using:Infragistics.Controls.Grids"
                    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                <Grid>
          <igLayouts:XamPropertyEditorPanel
          Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=grid}"
          DescriptionType="DataGrid"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="GroupHeaderDisplayMode"
                  Name="GroupHeaderDisplayModeEditor"
                  Label="Group Header Display Mode"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="Combined">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igDataGrids:XamDataGrid
          Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          AutoGenerateColumns="false"
          IsGroupCollapsable="true"
          GroupHeaderDisplayMode="Combined">
              <igDataGrids:XamDataGrid.GroupDescriptions>
                  <igDataGrids:ColumnGroupDescription
                  Field="Country"
                  DisplayName="Country">
                  </igDataGrids:ColumnGroupDescription>
              </igDataGrids:XamDataGrid.GroupDescriptions>
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="Name">
                      <igDataGrids:TextColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="120">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:TextColumn.Width>
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Age">
                      <igDataGrids:NumericColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="110">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:NumericColumn.Width>
                  </igDataGrids:NumericColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  HorizontalAlignment="Center">
                      <igDataGrids:DateTimeColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="160">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:DateTimeColumn.Width>
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:TextColumn
                  Field="Country"
                  HeaderText="Country"
                  IsEditable="false"
                  PaddingTop="5"
                  PaddingBottom="5"
                  ContentOpacity="1"
                  HorizontalAlignment="Center">
                      <igDataGrids:TextColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="160">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:TextColumn.Width>
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Street">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  HeaderText="Salary"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                      <igDataGrids:NumericColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="130">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:NumericColumn.Width>
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="City">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true"
                  MaxFractionDigits="0"
                  MinFractionDigits="0">
                  </igDataGrids:NumericColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
