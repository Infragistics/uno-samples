<UserControl
    x:Class="SamplesBrowser.Pages.Grids.DataGrid.ColumnAutoGenerationRealEstates.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                xmlns:igDataGrids="using:Infragistics.Controls.Grids"
                        mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igDataGrids:XamDataGrid
          Name="grid"
          ItemsSource="{Binding RealEstateData}"
          AutoGenerateColumns="false"
          ActivationMode="Cell">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="ID">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Property">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Rooms">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Baths">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Built">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Price"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true"
                  MaxFractionDigits="0"
                  MinFractionDigits="0">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="City">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Country">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
