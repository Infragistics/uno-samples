<UserControl
    x:Class="SamplesBrowser.Pages.Grids.DataGrid.RowGrouping.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Grids.DataGrid.RowGrouping"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          IsGroupCollapsable="true"
          IsGroupByAreaVisible="true">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="Name"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Age"
                  Width="*>110">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  HorizontalAlignment="Center"
                  Width="*>160">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:TextColumn
                  Field="Country"
                  HeaderText="Country"
                  Width="*>160"
                  IsEditable="false"
                  PaddingTop="5"
                  PaddingBottom="5"
                  ContentOpacity="1"
                  HorizontalAlignment="Center">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Street">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  HeaderText="Salary"
                  Width="*>130"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="City">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true"
                  MaxFractionDigits="0"
                  MinFractionDigits="0">
                  </igDataGrids:NumericColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
