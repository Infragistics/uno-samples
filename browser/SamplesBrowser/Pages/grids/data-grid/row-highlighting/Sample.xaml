<UserControl
    x:Class="SamplesBrowser.Pages.Grids.DataGrid.RowHighlighting.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                xmlns:igDataGrids="using:Infragistics.Controls.Grids"
                    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                <Grid>
          <igLayouts:XamPropertyEditorPanel
          Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=grid}"
          DescriptionType="DataGrid"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="IsRowHoverEnabled"
                  Name="IsRowHoverEnabledEditor"
                  Label="Enable Row Hover"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Boolean"
                  PrimitiveValue="True">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="RowHoverBackground"
                  Name="RowHoverBackgroundEditor"
                  Label="Highlight Color"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igDataGrids:XamDataGrid
          Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          AutoGenerateColumns="false"
          DefaultColumnMinWidth="100"
          IsColumnOptionsEnabled="true"
          IsRowHoverEnabled="true"
          SelectionMode="MultipleRow">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="Name">
                      <igDataGrids:TextColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="150">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:TextColumn.Width>
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Street"
                  HeaderText="Street">
                      <igDataGrids:TextColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="160">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:TextColumn.Width>
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="City"
                  HeaderText="City">
                      <igDataGrids:TextColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="120">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:TextColumn.Width>
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  HeaderText="Salary"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true">
                      <igDataGrids:NumericColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="120">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:NumericColumn.Width>
                  </igDataGrids:NumericColumn>
                  <igDataGrids:ImageColumn
                  Field="Photo"
                  HeaderText="Photo"
                  IsEditable="false"
                  ContentOpacity="1"
                  HorizontalAlignment="Center">
                      <igDataGrids:ImageColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="110">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:ImageColumn.Width>
                  </igDataGrids:ImageColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  HeaderText="Date of Birth">
                      <igDataGrids:DateTimeColumn.Width>
                          <igDataGrids:ColumnWidth
                          IsStarSized="true"
                          Value="1"
                          MinimumWidth="170">
                          </igDataGrids:ColumnWidth>
                      </igDataGrids:DateTimeColumn.Width>
                  </igDataGrids:DateTimeColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
