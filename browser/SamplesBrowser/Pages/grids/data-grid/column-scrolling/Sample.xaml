<UserControl
    x:Class="SamplesBrowser.Pages.Grids.DataGrid.ColumnScrolling.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Grids.DataGrid.ColumnScrolling"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          DefaultColumnMinWidth="120">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="ID"
                  Width="*>110">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="FirstName"
                  Width="*>190">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="LastName"
                  Width="*>190">
                  </igDataGrids:TextColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  Width="*>170">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:NumericColumn
                  Field="Age"
                  Width="*>120">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:ImageColumn
                  Field="CountryFlag"
                  IsEditable="false">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TextColumn
                  Field="Street"
                  Width="*>160">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="City"
                  Width="260">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="Country"
                  Width="*>170">
                  </igDataGrids:TextColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  Width="*>170">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Sales"
                  Width="*>120">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  Width="*>120"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true"
                  MaxFractionDigits="0"
                  MinFractionDigits="0">
                  </igDataGrids:NumericColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
