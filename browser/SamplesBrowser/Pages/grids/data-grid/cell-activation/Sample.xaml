<UserControl
    x:Class="SamplesBrowser.Pages.Grids.DataGrid.CellActivation.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Grids.DataGrid.CellActivation"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          x:Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=grid}"
          DescriptionType="DataGrid"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="EnterBehavior"
                  x:Name="EnterBehaviorEditor"
                  Label="Enter Key Mode"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="Edit">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="EnterBehaviorAfterEdit"
                  x:Name="EnterBehaviorAfterEditEditor"
                  Label="Enter Key After Edit Mode"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames2}"
                  DropDownValues="{Binding dropDownValues2}"
                  PrimitiveValue="MoveDown">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igDataGrids:XamDataGrid
          AutoGenerateColumns="false"
          x:Name="grid"
          ItemsSource="{Binding EmployeesSalesData}"
          SelectionMode="SingleRow"
          ActivationMode="Cell"
          EditMode="Cell"
          EnterBehavior="Edit"
          EnterBehaviorAfterEdit="MoveDown">
              <igDataGrids:XamDataGrid.Columns>
                  <igDataGrids:TextColumn
                  Field="Name"
                  Width="*>170">
                  </igDataGrids:TextColumn>
                  <igDataGrids:ImageColumn
                  Field="Photo"
                  Width="*>120"
                  IsEditable="false"
                  PaddingTop="5"
                  PaddingBottom="5"
                  ContentOpacity="1"
                  HorizontalAlignment="Center">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:NumericColumn
                  Field="Age"
                  Width="*>100"
                  HorizontalAlignment="Center">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="Street"
                  HeaderText="Address"
                  Width="*>150">
                  </igDataGrids:TextColumn>
                  <igDataGrids:TextColumn
                  Field="City"
                  Width="*>130">
                  </igDataGrids:TextColumn>
                  <igDataGrids:ImageColumn
                  Field="CountryFlag"
                  HeaderText="Country"
                  Width="*>120"
                  IsEditable="false"
                  PaddingTop="5"
                  PaddingBottom="5"
                  ContentOpacity="1">
                  </igDataGrids:ImageColumn>
                  <igDataGrids:TextColumn
                  Field="Phone"
                  Width="*>120">
                  </igDataGrids:TextColumn>
                  <igDataGrids:DateTimeColumn
                  Field="Birthday"
                  Width="*>150"
                  HorizontalAlignment="Center">
                  </igDataGrids:DateTimeColumn>
                  <igDataGrids:NumericColumn
                  Field="Salary"
                  Width="*>170"
                  PositivePrefix="$"
                  ShowGroupingSeparator="true"
                  MinFractionDigits="2">
                  </igDataGrids:NumericColumn>
                  <igDataGrids:TextColumn
                  Field="Email"
                  Width="*>150">
                  </igDataGrids:TextColumn>
              </igDataGrids:XamDataGrid.Columns>
          </igDataGrids:XamDataGrid>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
