<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DashboardTile.LocalDataSourceDashboard.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
                                xmlns:igDashboards="using:Infragistics.Controls.Dashboards"
        mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igDashboards:XamDashboardTile
          Name="dashboard"
          ItemsSource="{Binding RetailSalesPerformanceLocalDataSource}">
          </igDashboards:XamDashboardTile>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
