<UserControl
    x:Class="SamplesBrowser.Pages.Charts.CategoryChart.HighFrequency.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.CategoryChart.HighFrequency"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="CategoryChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          x:Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ToggleUpdates"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Start / Stop"
                  ButtonClicked="EditorButtonToggleHighFrequency"
                  x:Name="propertyEditorPropertyDescription1">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="RefreshFrequency"
                  x:Name="RefreshFrequency"
                  Label="Refresh (ms)"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Slider"
                  PrimitiveValue="10"
                  Min="10"
                  Max="500"
                  Step="10"
                  Changed="EditorChangeHighFrequencyRefresh">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="DataPoints"
                  x:Name="DataPoints"
                  Label="Data Points"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Slider"
                  PrimitiveValue="100000"
                  Min="10000"
                  Max="1000000"
                  Step="1000"
                  Changed="EditorChangeHighFrequencyPoints">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="GenerateData"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Generate Data"
                  ButtonClicked="EditorButtonGenerateHighFrequencyData"
                  x:Name="propertyEditorPropertyDescription2">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamCategoryChart
          x:Name="chart"
          ChartType="Line"
          YAxisExtent="60"
          XAxisEnhancedIntervalPreferMoreCategoryLabels="false"
          ShouldConsiderAutoRotationForInitialLabels="false"
          ShouldAutoExpandMarginForInitialLabels="false"
          CrosshairsDisplayMode="None"
          AutoMarginAndAngleUpdateMode="None"
          MarkerTypes="{Binding markerTypes1}">
          </igCharts:XamCategoryChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
