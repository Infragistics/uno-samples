<UserControl
    x:Class="SamplesBrowser.Pages.Charts.CategoryChart.LineChartWithTitles.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.CategoryChart.LineChartWithTitles"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamCategoryChart
          x:Name="chart"
          ItemsSource="{Binding EnergyRenewableGeneration}"
          IncludedProperties="{Binding includedProperties1}"
          ChartType="Line"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false"
          ComputedPlotAreaMarginMode="Series"
          Title="Renewable Electricity Generated"
          TitleAlignment="Left"
          TitleTextColor="gray"
          TitleFontFamily="Titillium Web"
          TitleFontSize="16"
          TitleTopMargin="10"
          TitleLeftMargin="10"
          TitleBottomMargin="5"
          Subtitle="Trillions of Watt-hours by region, 2009 to 2019"
          SubtitleAlignment="Left"
          SubtitleTextColor="gray"
          SubtitleFontFamily="Titillium Web"
          SubtitleFontSize="10"
          SubtitleLeftMargin="10"
          SubtitleBottomMargin="10"
          XAxisTitle="Year"
          YAxisTitle="Trillions of Watt-hours (TWh)">
          </igCharts:XamCategoryChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
