<UserControl
    x:Class="SamplesBrowser.Pages.Charts.CategoryChart.AxisTitles.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:Legend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamCategoryChart
          Name="chart"
          ItemsSource="{Binding CountryRenewableElectricity}"
          IncludedProperties="{Binding includedProperties1}"
          ChartType="Line"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false"
          ComputedPlotAreaMarginMode="Series"
          XAxisTitle="Year"
          XAxisTitleTextColor="gray"
          XAxisTitleFontFamily="Titillium Web"
          XAxisTitleFontSize="10"
          XAxisTitleAngle="0"
          YAxisTitle="Trillions of Watt-hours (Twh)"
          YAxisTitleTextColor="gray"
          YAxisTitleFontFamily="Titillium Web"
          YAxisTitleFontSize="10"
          YAxisTitleAngle="90"
          YAxisTitleLeftMargin="5">
          </igCharts:XamCategoryChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
