<UserControl
    x:Class="SamplesBrowser.Pages.Charts.Toolbar.ActionsBuiltInCategoryChart.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.Toolbar.ActionsBuiltInCategoryChart"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igDataGrids="using:Infragistics.Controls.Grids"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" HorizontalAlignment="Left" Margin="10 0 0 0">
            <igLayouts:XamToolbar
            x:Name="toolbar"
            Target="{Binding ElementName=chart}"
            Orientation="Horizontal">
            </igLayouts:XamToolbar>
          </Grid>
          <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="0 0 10 0">
            <igCharts:Legend
            x:Name="legend"
            Orientation="Horizontal">
            </igCharts:Legend>
          </Grid>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamCategoryChart
          x:Name="chart"
          ChartType="Line"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true"
          ItemsSource="{Binding CountryRenewableElectricity}"
          IncludedProperties="{Binding includedProperties1}"
          Legend="{Binding ElementName=legend}"
          YAxisTitle="TWh"
          YAxisTitleLeftMargin="10"
          YAxisTitleRightMargin="5"
          YAxisLabelLeftMargin="0"
          YAxisLabelLocation="OutsideRight"
          IsTransitionInEnabled="true">
          </igCharts:XamCategoryChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
