<UserControl
    x:Class="SamplesBrowser.Pages.Charts.Toolbar.CustomTool.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                            xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- ifdef aboveContentLeft -->
          <Grid Grid.Column="0" HorizontalAlignment="Left" Margin="10 0 0 0">
            <igLayouts:XamToolbar
            Name="toolbar"
            Target="{Binding ElementName=chart}"
            Orientation="Horizontal">
                <igLayouts:XamToolbar.Actions>
                    <igLayouts:ToolActionLabel
                    Title="Custom Icon"
                    IconName="CustomIcon"
                    IconCollectionName="CustomCollection"
                    Name="CustomIconName">
                    </igLayouts:ToolActionLabel>
                    <igLayouts:ToolActionLabel
                    Title="Custom Icon 2"
                    IconName="CustomIcon2"
                    IconCollectionName="CustomCollection2"
                    Name="CustomIconName2">
                    </igLayouts:ToolActionLabel>
                </igLayouts:XamToolbar.Actions>
            </igLayouts:XamToolbar>
          </Grid>
          <!-- endifdef aboveContentLeft -->
          <!-- ifdef aboveContentRight -->
          <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="0 0 10 0">
            <igCharts:Legend
            Name="legend"
            Orientation="Horizontal">
            </igCharts:Legend>
          </Grid>
          <!-- endifdef aboveContentRight -->
        </Grid>
              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamCategoryChart
          Name="chart"
          ChartType="Line"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true"
          ItemsSource="{Binding CountryRenewableElectricity}"
          IncludedProperties="{Binding includedProperties1}"
          Legend="{Binding ElementName=legend}"
          YAxisTitle="TWh"
          YAxisTitleLeftMargin="10"
          YAxisTitleRightMargin="5"
          YAxisLabelLeftMargin="0"
          YAxisLabelLocation="OutsideRight"
          IsTransitionInEnabled="true">
          </igCharts:XamCategoryChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
