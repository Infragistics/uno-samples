<UserControl
    x:Class="SamplesBrowser.Pages.Charts.Toolbar.LayoutActionsForDataChart.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.Toolbar.LayoutActionsForDataChart"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" HorizontalAlignment="Left" Margin="10 0 0 0">
            <igLayouts:XamToolbar
            x:Name="toolbar"
            Target="{Binding ElementName=chart}"
            Orientation="Horizontal"
            OnCommand="ToolbarToggleAnnotations">
                <igLayouts:XamToolbar.Actions>
                    <igLayouts:ToolActionIconMenu
                    x:Name="MenuForSubPanelTool"
                    IconCollectionName="ChartToolbarIcons"
                    IconName="analyze">
                        <igLayouts:ToolActionIconMenu.Actions>
                            <igLayouts:ToolActionGroupHeader
                            x:Name="SubPanelGroup"
                            CloseOnExecute="true"
                            Title="Visualizations"
                            Subtitle="Layers">
                            </igLayouts:ToolActionGroupHeader>
                            <igLayouts:ToolActionSubPanel
                            x:Name="CustomSubPanelTools">
                                <igLayouts:ToolActionSubPanel.Actions>
                                    <igLayouts:ToolActionCheckbox
                                    x:Name="EnableTooltipsLabel"
                                    Title="Enable Tooltips"
                                    CommandId="EnableTooltips">
                                    </igLayouts:ToolActionCheckbox>
                                    <igLayouts:ToolActionCheckbox
                                    x:Name="EnableCrosshairsLabel"
                                    Title="Enable Crosshairs"
                                    CommandId="EnableCrosshairs">
                                    </igLayouts:ToolActionCheckbox>
                                    <igLayouts:ToolActionCheckbox
                                    x:Name="EnableFinalValuesLabel"
                                    Title="Enable Final Values"
                                    CommandId="EnableFinalValues">
                                    </igLayouts:ToolActionCheckbox>
                                </igLayouts:ToolActionSubPanel.Actions>
                            </igLayouts:ToolActionSubPanel>
                        </igLayouts:ToolActionIconMenu.Actions>
                    </igLayouts:ToolActionIconMenu>
                    <igLayouts:ToolActionLabel
                    x:Name="zoomResetLabel"
                    Title="Reset"
                    AfterId="ZoomOut"
                    IconName="reset"
                    IconCollectionName="ChartToolbarIcons"
                    CommandId="ZoomReset"
                    IsHighlighted="true">
                    </igLayouts:ToolActionLabel>
                    <igLayouts:ToolActionLabel
                    x:Name="zoomResetHidden"
                    OverlayId="ZoomReset"
                    Visibility="Collapsed">
                    </igLayouts:ToolActionLabel>
                    <igLayouts:ToolActionIconMenu
                    x:Name="AnalyzeMenu"
                    OverlayId="AnalyzeMenu"
                    Visibility="Collapsed">
                    </igLayouts:ToolActionIconMenu>
                    <igLayouts:ToolActionLabel
                    x:Name="CopyMenu"
                    OverlayId="CopyMenu"
                    Visibility="Collapsed">
                    </igLayouts:ToolActionLabel>
                </igLayouts:XamToolbar.Actions>
            </igLayouts:XamToolbar>
          </Grid>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          ComputedPlotAreaMarginMode="Series"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true"
          x:Name="chart">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  Label="Year">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis"
                  Title="TWh"
                  LabelLocation="OutsideRight">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:LineSeries
                  x:Name="lineSeries1"
                  Title="Electricity"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="America">
                  </igCharts:LineSeries>
                  <igCharts:LineSeries
                  x:Name="LineSeries2"
                  Title="Electricity"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="Europe">
                  </igCharts:LineSeries>
                  <igCharts:LineSeries
                  x:Name="LineSeries3"
                  Title="Electricity"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="China">
                  </igCharts:LineSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
