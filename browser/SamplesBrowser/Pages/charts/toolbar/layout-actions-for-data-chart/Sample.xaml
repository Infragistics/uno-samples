<UserControl
    x:Class="SamplesBrowser.Pages.Charts.Toolbar.LayoutActionsForDataChart.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                            xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- ifdef aboveContentLeft -->
          <Grid Grid.Column="0" HorizontalAlignment="Left" Margin="10 0 0 0">
            <igLayouts:XamToolbar
            Name="toolbar"
            Target="{Binding ElementName=chart}"
            Orientation="Horizontal"
            OnCommand="ToolbarToggleAnnotations">
                <igLayouts:XamToolbar.Actions>
                    <igLayouts:ToolActionIconMenu
                    Name="MenuForSubPanelTool"
                    IconCollectionName="ChartToolbarIcons"
                    IconName="analyze">
                        <igLayouts:ToolActionIconMenu.Actions>
                            <igLayouts:ToolActionGroupHeader
                            Name="SubPanelGroup"
                            CloseOnExecute="true"
                            Title="Visualizations"
                            Subtitle="Layers">
                            </igLayouts:ToolActionGroupHeader>
                            <igLayouts:ToolActionSubPanel
                            Name="CustomSubPanelTools">
                                <igLayouts:ToolActionSubPanel.Actions>
                                    <igLayouts:ToolActionCheckbox
                                    Name="EnableTooltipsLabel"
                                    Title="Enable Tooltips"
                                    CommandId="EnableTooltips">
                                    </igLayouts:ToolActionCheckbox>
                                    <igLayouts:ToolActionCheckbox
                                    Name="EnableCrosshairsLabel"
                                    Title="Enable Crosshairs"
                                    CommandId="EnableCrosshairs">
                                    </igLayouts:ToolActionCheckbox>
                                    <igLayouts:ToolActionCheckbox
                                    Name="EnableFinalValuesLabel"
                                    Title="Enable Final Values"
                                    CommandId="EnableFinalValues">
                                    </igLayouts:ToolActionCheckbox>
                                </igLayouts:ToolActionSubPanel.Actions>
                            </igLayouts:ToolActionSubPanel>
                        </igLayouts:ToolActionIconMenu.Actions>
                    </igLayouts:ToolActionIconMenu>
                    <igLayouts:ToolActionLabel
                    Name="zoomResetLabel"
                    Title="Reset"
                    AfterId="ZoomOut"
                    IconName="reset"
                    IconCollectionName="ChartToolbarIcons"
                    CommandId="ZoomReset"
                    IsHighlighted="true">
                    </igLayouts:ToolActionLabel>
                    <igLayouts:ToolActionLabel
                    Name="zoomResetHidden"
                    OverlayId="ZoomReset"
                    Visibility="Collapsed">
                    </igLayouts:ToolActionLabel>
                    <igLayouts:ToolActionIconMenu
                    Name="AnalyzeMenu"
                    OverlayId="AnalyzeMenu"
                    Visibility="Collapsed">
                    </igLayouts:ToolActionIconMenu>
                    <igLayouts:ToolActionLabel
                    Name="CopyMenu"
                    OverlayId="CopyMenu"
                    Visibility="Collapsed">
                    </igLayouts:ToolActionLabel>
                </igLayouts:XamToolbar.Actions>
            </igLayouts:XamToolbar>
          </Grid>
          <!-- endifdef aboveContentLeft -->
          <!-- ifdef aboveContentRight -->
          <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="0 0 10 0">
            <!-- insert aboveContentRight -->
            <!-- end aboveContentRight -->
          </Grid>
          <!-- endifdef aboveContentRight -->
        </Grid>
              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          ComputedPlotAreaMarginMode="Series"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true"
          Name="chart">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  Name="xAxis"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  Label="Year">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  Title="TWh"
                  LabelLocation="OutsideRight">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:LineSeries
                  Name="lineSeries1"
                  Title="Electricity"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="America">
                  </igCharts:LineSeries>
                  <igCharts:LineSeries
                  Name="LineSeries2"
                  Title="Electricity"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="Europe">
                  </igCharts:LineSeries>
                  <igCharts:LineSeries
                  Name="LineSeries3"
                  Title="Electricity"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="China">
                  </igCharts:LineSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
