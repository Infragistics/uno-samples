<UserControl
    x:Class="SamplesBrowser.Pages.Charts.Toolbar.LayoutInVerticalOrientation.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.Toolbar.LayoutInVerticalOrientation"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamToolbar
          x:Name="toolbar"
          Target="{Binding ElementName=chart}"
          Orientation="Vertical">
          </igLayouts:XamToolbar>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          IsHorizontalZoomEnabled="true"
          x:Name="chart">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  Label="Year">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis"
                  Title="TWh"
                  LabelLocation="OutsideRight">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:LineSeries
                  x:Name="lineSeries1"
                  Title="Electricity"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="America">
                  </igCharts:LineSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
