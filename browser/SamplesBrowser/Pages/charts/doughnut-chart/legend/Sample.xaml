<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DoughnutChart.Legend.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:ItemLegend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:ItemLegend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDoughnutChart
          Name="chart"
          AllowSliceExplosion="true">
              <igCharts:XamDoughnutChart.Series>
                  <igCharts:RingSeries
                  Name="series"
                  LabelMemberPath="Summary"
                  LabelsPosition="OutsideEnd"
                  LabelExtent="30"
                  ValueMemberPath="Value"
                  LegendLabelMemberPath="Category"
                  Outlines="white"
                  RadiusFactor="0.6"
                  StartAngle="30"
                  ItemsSource="{Binding EnergyGlobalDemand}"
                  Legend="{Binding ElementName=legend}">
                  </igCharts:RingSeries>
              </igCharts:XamDoughnutChart.Series>
          </igCharts:XamDoughnutChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
