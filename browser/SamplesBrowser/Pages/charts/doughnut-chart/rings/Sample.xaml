<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DoughnutChart.Rings.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDoughnutChart
          Name="chart"
          AllowSliceExplosion="false"
          AllowSliceSelection="false">
              <igCharts:XamDoughnutChart.Series>
                  <igCharts:RingSeries
                  Name="series1"
                  LabelMemberPath="Label"
                  ValueMemberPath="Value"
                  LabelsPosition="Center"
                  RadiusFactor="0.9"
                  Outlines="white"
                  Brushes="#3cbdc9 #9fb328 #f96232 #8a58d6"
                  ItemsSource="{Binding CalendarSeasons}">
                  </igCharts:RingSeries>
                  <igCharts:RingSeries
                  Name="series2"
                  LabelMemberPath="Label"
                  ValueMemberPath="Value"
                  LabelsPosition="Center"
                  RadiusFactor="0.9"
                  Outlines="white"
                  Brushes="#3cbdc9 #3cbdc9 #3cbdc9 #9fb328 #9fb328 #9fb328 #f96232 #f96232 #f96232 #8a58d6 #8a58d6 #8a58d6"
                  ItemsSource="{Binding CalendarMonths}">
                  </igCharts:RingSeries>
              </igCharts:XamDoughnutChart.Series>
          </igCharts:XamDoughnutChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
