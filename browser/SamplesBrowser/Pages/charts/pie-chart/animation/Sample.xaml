<UserControl
    x:Class="SamplesBrowser.Pages.Charts.PieChart.Animation.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.PieChart.Animation"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="PieChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          x:Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="AnimateChart"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Animate Chart"
                  ButtonClicked="EditorButtonPieChartAnimation"
                  x:Name="propertyEditorPropertyDescription1">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamPieChart
          x:Name="chart"
          ItemsSource="{Binding LocalData}"
          LabelMemberPath="Summary"
          ValueMemberPath="MarketShare"
          LegendLabelMemberPath="Company"
          LabelsPosition="InsideEnd"
          StartAngle="0"
          LabelExtent="0.7"
          RadiusFactor="0.1">
          </igCharts:XamPieChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
