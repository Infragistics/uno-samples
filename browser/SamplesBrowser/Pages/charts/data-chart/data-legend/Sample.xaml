<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.DataLegend.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:XamDataLegend
          Name="legend"
          Target="{Binding ElementName=chart}"
          UnitsText="%"
          IncludedColumns="{Binding includedColumns1}">
          </igCharts:XamDataLegend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart">
              <igCharts:XamDataChart.Axes>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  Title="Birth Rate"
                  Interval="10"
                  MinimumValue="0"
                  MaximumValue="60">
                  </igCharts:NumericYAxis>
                  <igCharts:NumericXAxis
                  Name="xAxis"
                  Title="Death Rate"
                  Interval="1"
                  MinimumValue="4"
                  MaximumValue="16">
                  </igCharts:NumericXAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:BubbleSeries
                  Name="bubbleSeries1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryDemographicAfrican}"
                  XMemberPath="DeathRate"
                  YMemberPath="BirthRate"
                  RadiusMemberPath="Population"
                  Title="Africa"
                  RadiusMemberAsLegendLabel="Population: "
                  XMemberAsLegendLabel="Death Rate: "
                  YMemberAsLegendLabel="Birth Rate: ">
                      <igCharts:BubbleSeries.RadiusScale>
                          <igCharts:SizeScale
                          Name="SizeScale1"
                          MinimumValue="10"
                          MaximumValue="50">
                          </igCharts:SizeScale>
                      </igCharts:BubbleSeries.RadiusScale>
                  </igCharts:BubbleSeries>
                  <igCharts:BubbleSeries
                  Name="bubbleSeries2"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryDemographicEurope}"
                  XMemberPath="DeathRate"
                  YMemberPath="BirthRate"
                  RadiusMemberPath="Population"
                  Title="Europe"
                  RadiusMemberAsLegendLabel="Population: "
                  XMemberAsLegendLabel="Death Rate: "
                  YMemberAsLegendLabel="Birth Rate: ">
                      <igCharts:BubbleSeries.RadiusScale>
                          <igCharts:SizeScale
                          Name="SizeScale2"
                          MinimumValue="10"
                          MaximumValue="50">
                          </igCharts:SizeScale>
                      </igCharts:BubbleSeries.RadiusScale>
                  </igCharts:BubbleSeries>
                  <igCharts:CrosshairLayer
                  Name="CrosshairLayer">
                  </igCharts:CrosshairLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
