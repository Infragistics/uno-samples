<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.DataAnnotationSliceLayer.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart"
          ShouldAutoExpandMarginForInitialLabels="true"
          ComputedPlotAreaMarginMode="Series"
          IsVerticalZoomEnabled="false"
          IsHorizontalZoomEnabled="true"
          Brushes="green red"
          Outlines="green red"
          PlotAreaMarginLeft="10"
          PlotAreaMarginTop="0"
          PlotAreaMarginRight="20"
          PlotAreaMarginBottom="0"
          LeftMargin="10"
          TopMargin="0"
          RightMargin="20"
          BottomMargin="0"
          IsWindowSyncedToVisibleRange="false"
          Title="This Data Chart demonstrates the DataAnnotationSliceLayer bound to data that annotates stock splits and earnings miss/beat events.">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  Name="xAxisBottom"
                  ItemsSource="{Binding StockTesla}"
                  Label="Index"
                  TickLength="0"
                  LabelLocation="OutsideBottom"
                  LabelTextColor="#00000000"
                  LabelFontSize="12"
                  LabelExtent="140"
                  LabelLeftMargin="8"
                  LabelTopMargin="3"
                  LabelRightMargin="8"
                  LabelBottomMargin="5"
                  LabelAngle="90">
                  </igCharts:CategoryXAxis>
                  <igCharts:CategoryXAxis
                  Name="xAxisTop"
                  ItemsSource="{Binding StockTesla}"
                  Label="Date"
                  LabelLocation="OutsideBottom">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxisLeft"
                  LabelLocation="OutsideLeft"
                  LabelFontSize="12"
                  LabelExtent="80"
                  LabelHorizontalAlignment="Right"
                  LabelLeftMargin="8"
                  LabelTopMargin="3"
                  LabelRightMargin="8"
                  LabelBottomMargin="5"
                  MinimumValue="0"
                  MaximumValue="550">
                  </igCharts:NumericYAxis>
                  <igCharts:NumericYAxis
                  Name="yAxisRight"
                  LabelLocation="OutsideRight"
                  LabelFontSize="12"
                  LabelExtent="80"
                  LabelHorizontalAlignment="Left"
                  LabelLeftMargin="8"
                  LabelTopMargin="3"
                  LabelRightMargin="8"
                  LabelBottomMargin="5"
                  MinimumValue="0"
                  MaximumValue="550">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:FinancialPriceSeries
                  Name="series1"
                  Title="Stock Price"
                  DisplayType="Candlestick"
                  XAxis="{Binding ElementName=xAxisTop}"
                  YAxis="{Binding ElementName=yAxisLeft}"
                  ItemsSource="{Binding StockTesla}"
                  OpenMemberPath="Open"
                  HighMemberPath="High"
                  LowMemberPath="Low"
                  CloseMemberPath="Close"
                  ShowDefaultTooltip="false">
                  </igCharts:FinancialPriceSeries>
                  <igCharts:DataToolTipLayer
                  Name="Tooltip"
                  IncludedColumns="{Binding includedColumns1}"
                  LayoutMode="Vertical">
                  </igCharts:DataToolTipLayer>
                  <igCharts:DataAnnotationSliceLayer
                  Name="SliceLayerStockSplit"
                  ItemsSource="{Binding AnnotationSliceStockSplitData}"
                  TargetAxis="{Binding ElementName=xAxisBottom}"
                  Brush="dodgerblue"
                  AnnotationTextColor="white"
                  AnnotationLabelMemberPath="Label"
                  AnnotationValueMemberPath="Value"
                  OverlayTextMemberPath="Label"
                  OverlayTextAngle="90"
                  OverlayTextVerticalMargin="20"
                  OverlayTextHorizontalMargin="0"
                  OverlayTextLocation="Hidden">
                  </igCharts:DataAnnotationSliceLayer>
                  <igCharts:DataAnnotationSliceLayer
                  Name="SliceLayerEarningsMissAnnotations"
                  ItemsSource="{Binding AnnotationSliceEarningsMissData}"
                  TargetAxis="{Binding ElementName=xAxisBottom}"
                  Brush="red"
                  AnnotationTextColor="white"
                  AnnotationLabelMemberPath="Label"
                  AnnotationValueMemberPath="Value"
                  OverlayTextMemberPath="Label"
                  OverlayTextAngle="90"
                  OverlayTextVerticalMargin="20"
                  OverlayTextHorizontalMargin="0"
                  OverlayTextLocation="Hidden">
                  </igCharts:DataAnnotationSliceLayer>
                  <igCharts:DataAnnotationSliceLayer
                  Name="SliceLayerEarningsBeatAnnotations"
                  ItemsSource="{Binding AnnotationSliceEarningsBeatData}"
                  TargetAxis="{Binding ElementName=xAxisBottom}"
                  Brush="green"
                  AnnotationTextColor="white"
                  AnnotationLabelMemberPath="Label"
                  AnnotationValueMemberPath="Value"
                  OverlayTextMemberPath="Label"
                  OverlayTextAngle="90"
                  OverlayTextVerticalMargin="20"
                  OverlayTextHorizontalMargin="0"
                  OverlayTextLocation="Hidden">
                  </igCharts:DataAnnotationSliceLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
