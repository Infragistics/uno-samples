<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.VerticalWaterfallChart.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.DataChart.VerticalWaterfallChart"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryYAxis
                  x:Name="yAxis"
                  Label="Step"
                  ItemsSource="{Binding ProfitBridge}"
                  Interval="1"
                  IsInverted="true">
                  </igCharts:CategoryYAxis>
                  <igCharts:NumericXAxis
                  x:Name="xAxis"
                  Title="Thousands of Dollars"
                  MinimumValue="0">
                  </igCharts:NumericXAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:CategoryHighlightLayer
                  x:Name="CategoryHighlightLayer">
                  </igCharts:CategoryHighlightLayer>
                  <igCharts:VerticalWaterfallSeries
                  x:Name="VerticalWaterfallSeries1"
                  Title="Running total"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding ProfitBridge}"
                  ValueMemberPath="Total"
                  Brush="#2e7d32"
                  Outline="#2e7d32"
                  NegativeBrush="#c62828"
                  NegativeOutline="#c62828"
                  ShowDefaultTooltip="false"
                  IsTransitionInEnabled="true"
                  IsHighlightingEnabled="true">
                  </igCharts:VerticalWaterfallSeries>
                  <igCharts:DataToolTipLayer
                  x:Name="Tooltips">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
