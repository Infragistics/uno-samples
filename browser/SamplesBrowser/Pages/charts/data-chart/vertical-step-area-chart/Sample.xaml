<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.VerticalStepAreaChart.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.DataChart.VerticalStepAreaChart"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igCharts:Legend
          x:Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryYAxis
                  x:Name="yAxis"
                  Label="Month"
                  ItemsSource="{Binding MonthlyRainfallByCity}"
                  Interval="1"
                  IsInverted="true">
                  </igCharts:CategoryYAxis>
                  <igCharts:NumericXAxis
                  x:Name="xAxis"
                  Title="Rainfall (mm)"
                  MinimumValue="0">
                  </igCharts:NumericXAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:CategoryHighlightLayer
                  x:Name="CategoryHighlightLayer">
                  </igCharts:CategoryHighlightLayer>
                  <igCharts:VerticalStepAreaSeries
                  x:Name="VerticalStepAreaSeries1"
                  Title="Seattle"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding MonthlyRainfallByCity}"
                  ValueMemberPath="Seattle"
                  AreaFillOpacity="0.5"
                  Thickness="2"
                  ShowDefaultTooltip="false"
                  IsTransitionInEnabled="true"
                  IsHighlightingEnabled="true">
                  </igCharts:VerticalStepAreaSeries>
                  <igCharts:VerticalStepAreaSeries
                  x:Name="VerticalStepAreaSeries2"
                  Title="Madrid"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding MonthlyRainfallByCity}"
                  ValueMemberPath="Madrid"
                  AreaFillOpacity="0.5"
                  Thickness="2"
                  ShowDefaultTooltip="false"
                  IsTransitionInEnabled="true"
                  IsHighlightingEnabled="true">
                  </igCharts:VerticalStepAreaSeries>
                  <igCharts:DataToolTipLayer
                  x:Name="Tooltips"
                  SummaryType="None">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
