<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.StackedChartTypes.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.DataChart.StackedChartTypes"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="DataChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          x:Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="SeriesType"
                  x:Name="SeriesType"
                  Label="Series Type"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="Stacked Column Series"
                  Changed="EditorChangeStackedSeriesType">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
        <Grid>
          <igCharts:Legend
          x:Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="catXAxis"
                  ItemsSource="{Binding EnergyProductionByCountry}"
                  Label="Country">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="numYAxis">
                  </igCharts:NumericYAxis>
                  <igCharts:CategoryYAxis
                  x:Name="catYAxis"
                  ItemsSource="{Binding EnergyProductionByCountry}"
                  Label="Country">
                  </igCharts:CategoryYAxis>
                  <igCharts:NumericXAxis
                  x:Name="numXAxis">
                  </igCharts:NumericXAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:StackedColumnSeries
                  x:Name="stackedSeries"
                  ItemsSource="{Binding EnergyProductionByCountry}"
                  XAxis="{Binding ElementName=catXAxis}"
                  YAxis="{Binding ElementName=numYAxis}">
                      <igCharts:StackedColumnSeries.Series>
                          <igCharts:StackedFragmentSeries
                          x:Name="coal"
                          ValueMemberPath="Coal"
                          Title="Coal">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          x:Name="hydro"
                          ValueMemberPath="Hydro"
                          Title="Hydro">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          x:Name="nuclear"
                          ValueMemberPath="Nuclear"
                          Title="Nuclear">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          x:Name="gas"
                          ValueMemberPath="Gas"
                          Title="Gas">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          x:Name="oil"
                          ValueMemberPath="Oil"
                          Title="Oil">
                          </igCharts:StackedFragmentSeries>
                      </igCharts:StackedColumnSeries.Series>
                  </igCharts:StackedColumnSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
