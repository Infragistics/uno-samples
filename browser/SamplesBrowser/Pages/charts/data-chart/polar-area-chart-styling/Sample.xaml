<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.PolarAreaChartStyling.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.DataChart.PolarAreaChartStyling"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igCharts:Legend
          x:Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false"
          MarkerBrushes="white"
          MarkerOutlines="#8ce7d9 #ee5879"
          Brushes="#8ce7d9 #ee5879"
          Outlines="#8ce7d9 #ee5879">
              <igCharts:XamDataChart.Axes>
                  <igCharts:NumericAngleAxis
                  x:Name="angleAxis"
                  StartAngleOffset="-90"
                  Interval="30"
                  MinimumValue="0"
                  MaximumValue="360"
                  LabelFontWeight="Bold">
                  </igCharts:NumericAngleAxis>
                  <igCharts:NumericRadiusAxis
                  x:Name="radiusAxis"
                  RadiusExtentScale="0.9"
                  InnerRadiusExtentScale="0.1"
                  Interval="25"
                  MinimumValue="0"
                  MaximumValue="100">
                  </igCharts:NumericRadiusAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:PolarAreaSeries
                  x:Name="PolarAreaSeries1"
                  ItemsSource="{Binding BoatSailingData}"
                  AngleAxis="{Binding ElementName=angleAxis}"
                  RadiusAxis="{Binding ElementName=radiusAxis}"
                  AngleMemberPath="Direction"
                  RadiusMemberPath="WindSpeed"
                  ShowDefaultTooltip="true"
                  AreaFillOpacity="0.3"
                  Thickness="1"
                  Title="Wind Speed"
                  MarkerType="Circle">
                  </igCharts:PolarAreaSeries>
                  <igCharts:PolarAreaSeries
                  x:Name="PolarAreaSeries2"
                  ItemsSource="{Binding BoatSailingData}"
                  AngleAxis="{Binding ElementName=angleAxis}"
                  RadiusAxis="{Binding ElementName=radiusAxis}"
                  AngleMemberPath="Direction"
                  RadiusMemberPath="BoatSpeed"
                  ShowDefaultTooltip="true"
                  AreaFillOpacity="0.3"
                  Thickness="1"
                  Title="Boat Speed"
                  MarkerType="Circle">
                  </igCharts:PolarAreaSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
