<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.RadialLabelMode.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                            xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="DataChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="Axes[0 as CategoryAngleAxis].LabelExtent"
                  Name="LabelExtent"
                  Label="Label Extent"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Slider"
                  PrimitiveValue="5"
                  Min="0"
                  Max="100"
                  Step="1">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="Axes[0 as CategoryAngleAxis].LabelMode"
                  Name="LabelMode"
                  Label="LabelMode"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="Auto">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
                        <Grid>
          <igCharts:Legend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryAngleAxis
                  Name="angleAxis"
                  ItemsSource="{Binding FootballPlayerStats}"
                  Label="Attribute">
                  </igCharts:CategoryAngleAxis>
                  <igCharts:NumericRadiusAxis
                  Name="radiusAxis"
                  InnerRadiusExtentScale="0.1"
                  Interval="2"
                  MinimumValue="0"
                  MaximumValue="10">
                  </igCharts:NumericRadiusAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:RadialColumnSeries
                  Name="RadialColumnSeries1"
                  ItemsSource="{Binding FootballPlayerStats}"
                  AngleAxis="{Binding ElementName=angleAxis}"
                  ValueAxis="{Binding ElementName=radiusAxis}"
                  ValueMemberPath="Ronaldo"
                  ShowDefaultTooltip="false"
                  AreaFillOpacity="0.8"
                  Thickness="3"
                  Title="Ronaldo">
                  </igCharts:RadialColumnSeries>
                  <igCharts:RadialColumnSeries
                  Name="RadialColumnSeries2"
                  ItemsSource="{Binding FootballPlayerStats}"
                  AngleAxis="{Binding ElementName=angleAxis}"
                  ValueAxis="{Binding ElementName=radiusAxis}"
                  ValueMemberPath="Messi"
                  ShowDefaultTooltip="false"
                  AreaFillOpacity="0.8"
                  Thickness="3"
                  Title="Messi">
                  </igCharts:RadialColumnSeries>
                  <igCharts:DataToolTipLayer
                  Name="dataToolTipLayer">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
