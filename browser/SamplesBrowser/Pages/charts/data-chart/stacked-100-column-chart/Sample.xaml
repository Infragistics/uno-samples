<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.Stacked100ColumnChart.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:Legend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  Name="xAxis"
                  ItemsSource="{Binding OnlineTrafficByDevice}"
                  Label="Category"
                  Gap="0.75">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  MinimumValue="0">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:Stacked100ColumnSeries
                  Name="stacked100ColumnSeries"
                  ItemsSource="{Binding OnlineTrafficByDevice}"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ShowDefaultTooltip="true"
                  AreaFillOpacity="1">
                      <igCharts:Stacked100ColumnSeries.Series>
                          <igCharts:StackedFragmentSeries
                          Name="s1"
                          ValueMemberPath="Desktop"
                          Title="Desktop">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          Name="s2"
                          ValueMemberPath="Mobile"
                          Title="Mobile">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          Name="s3"
                          ValueMemberPath="Tablet"
                          Title="Tablet">
                          </igCharts:StackedFragmentSeries>
                      </igCharts:Stacked100ColumnSeries.Series>
                  </igCharts:Stacked100ColumnSeries>
                  <igCharts:DataToolTipLayer
                  Name="dataToolTipLayer">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
