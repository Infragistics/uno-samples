<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.ScatterPointChart.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:Legend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart"
          Legend="{Binding ElementName=legend}">
              <igCharts:XamDataChart.Axes>
                  <igCharts:NumericXAxis
                  Name="xAxis"
                  Title="Death Rate (per 1,000 people)"
                  MinimumValue="5"
                  MaximumValue="15">
                  </igCharts:NumericXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  Title="Birth Rate (per 1,000 people)"
                  MinimumValue="0"
                  MaximumValue="50"
                  Interval="10">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ScatterSeries
                  Name="scatterSeries1"
                  Title="Europe"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  XMemberPath="DeathRate"
                  YMemberPath="BirthRate"
                  ItemsSource="{Binding CountryDemographicEurope}"
                  MarkerType="Circle"
                  ShowDefaultTooltip="true">
                  </igCharts:ScatterSeries>
                  <igCharts:ScatterSeries
                  Name="scatterSeries2"
                  Title="Africa"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  XMemberPath="DeathRate"
                  YMemberPath="BirthRate"
                  ItemsSource="{Binding CountryDemographicAfrican}"
                  MarkerType="Circle"
                  ShowDefaultTooltip="true">
                  </igCharts:ScatterSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
