<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.TypeScatterContourSeries.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.DataChart.TypeScatterContourSeries"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="DataChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          x:Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="Series[0 as ScatterContourSeries].Thickness"
                  x:Name="Thickness"
                  Label="Thickness"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Slider"
                  PrimitiveValue="3"
                  Min="1"
                  Max="10"
                  Step="1">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="Series[0 as ScatterContourSeries].ValueResolver as LinearContourValueResolver.ValueCount"
                  x:Name="Contours"
                  Label="Contours"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Slider"
                  PrimitiveValue="10"
                  Min="1"
                  Max="15"
                  Step="1">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true"
          GridMode="BeforeSeries">
              <igCharts:XamDataChart.Axes>
                  <igCharts:NumericXAxis
                  x:Name="xAxis1"
                  LabelLocation="OutsideLeft"
                  MinimumValue="-180"
                  MaximumValue="180"
                  Interval="30"
                  Title="Longitude">
                  </igCharts:NumericXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis1"
                  LabelLocation="OutsideBottom"
                  MinimumValue="-90"
                  MaximumValue="90"
                  Interval="30"
                  Title="Latitude">
                  </igCharts:NumericYAxis>
                  <igCharts:NumericXAxis
                  x:Name="xAxis2"
                  LabelLocation="OutsideTop"
                  MinimumValue="-180"
                  MaximumValue="180"
                  Interval="30">
                  </igCharts:NumericXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis2"
                  LabelLocation="OutsideRight"
                  MinimumValue="-90"
                  MaximumValue="90"
                  Interval="30"
                  Title="Latitude">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ScatterContourSeries
                  x:Name="series"
                  XAxis="{Binding ElementName=xAxis1}"
                  YAxis="{Binding ElementName=yAxis1}"
                  ItemsSource="{Binding ScatterMagneticFieldData}"
                  Thickness="3"
                  XMemberPath="X"
                  YMemberPath="Y"
                  ValueMemberPath="Z">
                      <igCharts:ScatterContourSeries.ValueResolver>
                          <igCharts:LinearContourValueResolver
                          ValueCount="10">
                          </igCharts:LinearContourValueResolver>
                      </igCharts:ScatterContourSeries.ValueResolver>
                      <igCharts:ScatterContourSeries.FillScale>
                          <igCharts:ValueBrushScale
                          MinimumValue="-2"
                          MaximumValue="2"
                          Brushes="#8670cb #513e8c #003f5e #0c6b99 #4ac4ff #b5cc2e #ffd034 #fc8612 #ed4840">
                          </igCharts:ValueBrushScale>
                      </igCharts:ScatterContourSeries.FillScale>
                  </igCharts:ScatterContourSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
