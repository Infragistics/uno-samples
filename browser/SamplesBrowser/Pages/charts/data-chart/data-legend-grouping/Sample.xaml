<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.DataLegendGrouping.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.DataChart.DataLegendGrouping"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igCharts:XamDataLegend
          x:Name="legend"
          Target="{Binding ElementName=chart}"
          GroupRowVisible="true">
          </igCharts:XamDataLegend>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis"
                  ItemsSource="{Binding OlympicMedalsTopCountriesWithTotals}"
                  Label="Year">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ColumnSeries
                  x:Name="ColumnSeries1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding OlympicMedalsTopCountriesWithTotals}"
                  Title="America"
                  ValueMemberPath="America"
                  DataLegendGroup="Medals by Country">
                  </igCharts:ColumnSeries>
                  <igCharts:ColumnSeries
                  x:Name="ColumnSeries2"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding OlympicMedalsTopCountriesWithTotals}"
                  Title="China"
                  ValueMemberPath="China"
                  DataLegendGroup="Medals by Country">
                  </igCharts:ColumnSeries>
                  <igCharts:ColumnSeries
                  x:Name="ColumnSeries3"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding OlympicMedalsTopCountriesWithTotals}"
                  Title="Russia"
                  ValueMemberPath="Russia"
                  DataLegendGroup="Medals by Country">
                  </igCharts:ColumnSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
