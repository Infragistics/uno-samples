<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.CalloutLayerStyling.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.DataChart.CalloutLayerStyling"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          ShouldAutoExpandMarginForInitialLabels="true"
          ComputedPlotAreaMarginMode="Series"
          x:Name="chart">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  x:Name="xAxis"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  Label="Year">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis"
                  Title="TWh"
                  LabelLocation="OutsideRight">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:LineSeries
                  x:Name="lineSeries1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding CountryRenewableElectricity}"
                  ValueMemberPath="America"
                  Brush="#8961a9"
                  MarkerOutline="#8961a9"
                  ShouldHideAutoCallouts="false">
                  </igCharts:LineSeries>
                  <igCharts:CalloutLayer
                  x:Name="CalloutLayer1"
                  IsAutoCalloutBehaviorEnabled="true"
                  CalloutLeaderBrush="#8961a9"
                  CalloutOutline="#8961a9"
                  CalloutBackground="white"
                  CalloutTextColor="#8961a9"
                  CalloutStrokeThickness="1"
                  CalloutCollisionMode="Greedy">
                  </igCharts:CalloutLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
