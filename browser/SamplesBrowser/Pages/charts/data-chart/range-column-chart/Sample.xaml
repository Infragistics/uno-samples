<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.RangeColumnChart.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:Legend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false"
          Legend="{Binding ElementName=legend}">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  Name="xAxis"
                  Label="Month"
                  Interval="1"
                  ItemsSource="{Binding TemperatureRangeData}">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  Title="Temperature (in Celsius)"
                  TitleAngle="90"
                  TitleLeftMargin="10">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:RangeColumnSeries
                  Name="RangeColumnSeries1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  Title="Los Angeles"
                  LowMemberPath="LowLA"
                  HighMemberPath="HighLA"
                  ShowDefaultTooltip="false"
                  ItemsSource="{Binding TemperatureRangeData}">
                  </igCharts:RangeColumnSeries>
                  <igCharts:RangeColumnSeries
                  Name="RangeColumnSeries2"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  Title="New York"
                  LowMemberPath="LowNY"
                  HighMemberPath="HighNY"
                  ShowDefaultTooltip="false"
                  ItemsSource="{Binding TemperatureRangeData}">
                  </igCharts:RangeColumnSeries>
                  <igCharts:DataToolTipLayer
                  Name="dataToolTipLayer">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
