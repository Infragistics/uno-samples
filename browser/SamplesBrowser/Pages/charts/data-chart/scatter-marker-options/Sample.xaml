<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.ScatterMarkerOptions.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.DataChart.ScatterMarkerOptions"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          x:Name="PropertyEditor"
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="DataChart"
          IsHorizontal="true"
          IsWrappingEnabled="true">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="MarkerSizeHandler"
                  x:Name="MarkerSizeEditor"
                  Label="Marker Size"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="10"
                  Changed="EditorChangeUpdateDataChartMarkerSize">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="MarkerTypeHandler"
                  x:Name="MarkerTypeEditor"
                  Label="Marker Type"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownValues="{Binding dropDownValues2}"
                  DropDownNames="{Binding dropDownNames2}"
                  PrimitiveValue="Circle"
                  Changed="EditorChangeUpdateDataChartMarkerType">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
        <Grid>
          <igCharts:Legend
          x:Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          x:Name="chart"
          Legend="{Binding ElementName=legend}">
              <igCharts:XamDataChart.Axes>
                  <igCharts:NumericXAxis
                  x:Name="xAxis"
                  Title="Death Rate (per 1,000 people)"
                  MinimumValue="5"
                  MaximumValue="15">
                  </igCharts:NumericXAxis>
                  <igCharts:NumericYAxis
                  x:Name="yAxis"
                  Title="Birth Rate (per 1,000 people)"
                  MinimumValue="0"
                  MaximumValue="50"
                  Interval="10">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ScatterSeries
                  x:Name="scatterSeries1"
                  Title="Europe"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  XMemberPath="DeathRate"
                  YMemberPath="BirthRate"
                  ItemsSource="{Binding CountryDemographicEurope}"
                  MarkerType="Circle"
                  MarkerSize="10"
                  ShowDefaultTooltip="true">
                  </igCharts:ScatterSeries>
                  <igCharts:ScatterSeries
                  x:Name="scatterSeries2"
                  Title="Africa"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  XMemberPath="DeathRate"
                  YMemberPath="BirthRate"
                  ItemsSource="{Binding CountryDemographicAfrican}"
                  MarkerType="Circle"
                  MarkerSize="10"
                  ShowDefaultTooltip="true">
                  </igCharts:ScatterSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
