<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataChart.StackedColumnChart.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:Legend
          Name="legend"
          Orientation="Horizontal">
          </igCharts:Legend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamDataChart
          Name="chart"
          Legend="{Binding ElementName=legend}"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  Name="xAxis"
                  ItemsSource="{Binding ContinentsBirthRate}"
                  Label="Year"
                  Gap="0.75">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  MinimumValue="0"
                  MaximumValue="140"
                  Interval="20"
                  TitleLeftMargin="10"
                  LabelFormat="{}{0} m">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:StackedColumnSeries
                  Name="stackedColumnSeries"
                  ItemsSource="{Binding ContinentsBirthRate}"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ShowDefaultTooltip="false">
                      <igCharts:StackedColumnSeries.Series>
                          <igCharts:StackedFragmentSeries
                          Name="s1"
                          ValueMemberPath="Asia"
                          Title="Asia">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          Name="s2"
                          ValueMemberPath="Africa"
                          Title="Africa">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          Name="s3"
                          ValueMemberPath="Europe"
                          Title="Europe">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          Name="s4"
                          ValueMemberPath="NorthAmerica"
                          Title="North America">
                          </igCharts:StackedFragmentSeries>
                          <igCharts:StackedFragmentSeries
                          Name="s5"
                          ValueMemberPath="SouthAmerica"
                          Title="South America">
                          </igCharts:StackedFragmentSeries>
                      </igCharts:StackedColumnSeries.Series>
                  </igCharts:StackedColumnSeries>
                  <igCharts:DataToolTipLayer
                  Name="dataToolTipLayer">
                  </igCharts:DataToolTipLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
