<UserControl
    x:Class="SamplesBrowser.Pages.Charts.DataPieChart.Highlighting.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SamplesBrowser.Pages.Charts.DataPieChart.Highlighting"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="DataPieChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          x:Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="HighlightingMode"
                  x:Name="HighlightingModeEditor"
                  Label="Highlighting Mode: "
                  PrimitiveValue="BrightenSpecific">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="HighlightingBehavior"
                  x:Name="HighlightingBehaviorEditor"
                  Label="Highlighting Behavior: "
                  PrimitiveValue="DirectlyOver">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataPieChart
          x:Name="chart"
          ItemsSource="{Binding EnergyGlobalDemand}"
          HighlightingBehavior="DirectlyOver"
          HighlightingMode="BrightenSpecific">
          </igCharts:XamDataPieChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
