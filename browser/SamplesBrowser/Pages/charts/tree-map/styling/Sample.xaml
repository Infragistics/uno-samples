<UserControl
    x:Class="SamplesBrowser.Pages.Charts.TreeMap.Styling.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                                mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
                                      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
          <igCharts:XamTreemap
          Name="treemap"
          ItemsSource="{Binding CountyHierarchicalData}"
          ParentIdMemberPath="Parent"
          CustomValueMemberPath="Parent"
          IdMemberPath="Name"
          LabelMemberPath="Name"
          ValueMemberPath="Population"
          RootTitle="Countries"
          HeaderDisplayMode="Overlay"
          OverlayHeaderBackground="#3f403f"
          HeaderHoverBackground="#3f403f"
          HeaderBackground="#3f403f"
          ParentNodeBottomPadding="0"
          ParentNodeLeftPadding="0"
          ParentNodeRightPadding="0"
          ParentNodeTopPadding="0"
          Outline="black"
          StrokeThickness="1">
              <igCharts:XamTreemap.StyleMappings>
                  <igCharts:TreemapNodeStyleMapping
                  Name="styling1"
                  Value="Africa"
                  Fill="#735656"
                  MappingMode="CustomValue">
                  </igCharts:TreemapNodeStyleMapping>
                  <igCharts:TreemapNodeStyleMapping
                  Name="styling2"
                  Value="Europe"
                  Fill="#61ab37"
                  MappingMode="CustomValue">
                  </igCharts:TreemapNodeStyleMapping>
                  <igCharts:TreemapNodeStyleMapping
                  Name="styling3"
                  Value="Asia"
                  Fill="#8b5bb1"
                  MappingMode="CustomValue">
                  </igCharts:TreemapNodeStyleMapping>
                  <igCharts:TreemapNodeStyleMapping
                  Name="styling4"
                  Value="North America"
                  Fill="#5fbaac"
                  MappingMode="CustomValue">
                  </igCharts:TreemapNodeStyleMapping>
                  <igCharts:TreemapNodeStyleMapping
                  Name="styling5"
                  Value="South America"
                  Fill="#ee5879"
                  MappingMode="CustomValue">
                  </igCharts:TreemapNodeStyleMapping>
                  <igCharts:TreemapNodeStyleMapping
                  Name="styling6"
                  Value="Middle East"
                  Fill="#6db1ff"
                  MappingMode="CustomValue">
                  </igCharts:TreemapNodeStyleMapping>
                  <igCharts:TreemapNodeStyleMapping
                  Name="styling7"
                  Value="Central America"
                  Fill="#f7d262"
                  MappingMode="CustomValue">
                  </igCharts:TreemapNodeStyleMapping>
                  <igCharts:TreemapNodeStyleMapping
                  Name="styling8"
                  Value="Oceania"
                  Fill="#a8a8b7"
                  MappingMode="CustomValue">
                  </igCharts:TreemapNodeStyleMapping>
              </igCharts:XamTreemap.StyleMappings>
          </igCharts:XamTreemap>
        </Grid>
              </Grid>
          </Grid>
</UserControl>
