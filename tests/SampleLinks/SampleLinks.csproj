<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Compile the browser interop branch too, without launching a WASM runtime. -->
    <DefineConstants>$(DefineConstants);__WASM__</DefineConstants>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../browser/SamplesBrowser/Services/SampleLink.cs" Link="SampleLink.cs" />
  </ItemGroup>
</Project>
