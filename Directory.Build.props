<Project>
  <PropertyGroup Condition="'$(UnoRuntimeFixesPath)' != '' and Exists('$(UnoRuntimeFixesPath)/source-revision.txt')">
    <_UnoRuntimeFixesSourceKey>$([System.IO.File]::ReadAllText('$(UnoRuntimeFixesPath)/source-revision.txt'))</_UnoRuntimeFixesSourceKey>
    <_UnoRuntimeFixesCacheKey>$([MSBuild]::StableStringHash('$(UnoRuntimeFixesPath)|$(_UnoRuntimeFixesSourceKey)'))</_UnoRuntimeFixesCacheKey>
    <BaseIntermediateOutputPath>obj/uno-runtime-fixes/$(_UnoRuntimeFixesCacheKey)/</BaseIntermediateOutputPath>
    <DefaultExcludesInProjectFolder>$(DefaultExcludesInProjectFolder);obj/**</DefaultExcludesInProjectFolder>
  </PropertyGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Adding NoWarn to remove build warnings
      NU1507: Warning when there are multiple package sources when using CPM with no source mapping
      NETSDK1201: Warning that specifying RID won't create self containing app
      PRI257: Ignore default language (en) not being one of the included resources (eg en-us, en-uk)
    -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>

    <!-- The samples reference the Infragistics Uno packages (versions in Directory.Packages.props).
         To build one against a dev-tools UNO build output instead, pass
         /p:InfragisticsUnoBuild=c:\work\dev-tools\XPlatform\Main\Source\Build\UNO. -->
  </PropertyGroup>
</Project>
